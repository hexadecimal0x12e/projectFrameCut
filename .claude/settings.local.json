{
  "permissions": {
    "allow": [
      "Bash(dotnet build *)",
      "Bash(splc-edit *)",
      "Bash(dotnet tool *)",
      "Bash(xargs -I{} sh -c 'jq -r \"select\\(.message.role == \\\\\"assistant\\\\\"\\) | .message.content[]? | select\\(.type == \\\\\"tool_use\\\\\"\\) | \\\\\"\\\\\\(.name\\)\\\\t\\\\\\(if .name == \\\\\"Bash\\\\\" then .input.command else \\\\\"\\\\\" end\\)\\\\\"\" \"{}\" 2>/dev/null')",
      "Bash(xxd)",
      "Bash(findstr Value)",
      "Bash(dotnet restore *)",
      "Bash(cd *)",
      "PowerShell(cd *)",
      "PowerShell(dotnet build *)",
      "PowerShell(Get-Content *)",
      "PowerShell(Select-Object *)",
      "PowerShell(Select-String -Pattern \"error|Error|错误\")",
      "Bash(Get-Content *)"
    ],
    "deny": [
      "Bash(Select-Object *)",
      "Bash(Get-Content *)",
      "Bash(Select-String -Pattern \"error|Error|错误\")"
    ]
  }
