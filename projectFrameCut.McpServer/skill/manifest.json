{
  "id": "projectFrameCut-mcp",
  "name": "projectFrameCut MCP Server",
  "version": "0.1.0",
  "description": "Convenient CLI integration for projectFrameCut MCP server - start, manage, and test MCP instances",
  "keywords": [
    "projectFrameCut",
    "MCP",
    "video-editing",
    "server",
    "cli"
  ],
  "author": "projectFrameCut Team",
  "license": "Apache-2.0",
  "main": "./skill.js",
  "type": "module",
  "engines": {
    "node": ">=18.0",
    "dotnet": ">=10.0"
  },
  "commands": {
    "start": {
      "description": "Start MCP server for a project",
      "usage": "start --project <path> [--transport stdio|http] [--port 32123] [--bg]",
      "options": [
        {
          "name": "--project",
          "type": "string",
          "required": true,
          "description": "Path to project directory (must contain project.pjfc and timeline.json)"
        },
        {
          "name": "--transport",
          "type": "string",
          "default": "stdio",
          "choices": ["stdio", "http"],
          "description": "Transport mode - stdio for local CLI, http for remote access"
        },
        {
          "name": "--port",
          "type": "number",
          "default": 32123,
          "description": "HTTP port (only used with --transport http)"
        },
        {
          "name": "--bg",
          "type": "boolean",
          "description": "Run server in background (detached process)"
        }
      ]
    },
    "stop": {
      "description": "Stop running MCP server",
      "usage": "stop [--all]",
      "options": [
        {
          "name": "--all",
          "type": "boolean",
          "description": "Stop all dotnet processes"
        }
      ]
    },
    "status": {
      "description": "Check if MCP server is running and responsive",
      "usage": "status [--endpoint http://localhost:32123]",
      "options": [
        {
          "name": "--endpoint",
          "type": "string",
          "default": "http://localhost:32123",
          "description": "Server endpoint to check"
        }
      ]
    },
    "test": {
      "description": "Show test documentation and run tests",
      "usage": "test [--project <path>] [--case <name>]",
      "options": [
        {
          "name": "--project",
          "type": "string",
          "description": "Project directory path"
        },
        {
          "name": "--case",
          "type": "string",
          "description": "Specific test case to run"
        }
      ]
    },
    "generate-client": {
      "description": "Generate client code for a specific language",
      "usage": "generate-client --language python|js --output <path>",
      "options": [
        {
          "name": "--language",
          "type": "string",
          "required": true,
          "choices": ["python", "js"],
          "description": "Target programming language"
        },
        {
          "name": "--output",
          "type": "string",
          "required": true,
          "description": "Output file path for generated client"
        }
      ]
    },
    "project-info": {
      "description": "Get information about a project",
      "usage": "project-info --project <path>",
      "options": [
        {
          "name": "--project",
          "type": "string",
          "required": true,
          "description": "Project directory path"
        }
      ]
    },
    "batch-edit": {
      "description": "Prepare and show batch edit script",
      "usage": "batch-edit --script <path> --project <path>",
      "options": [
        {
          "name": "--script",
          "type": "string",
          "required": true,
          "description": "JSON file containing batch operations"
        },
        {
          "name": "--project",
          "type": "string",
          "required": true,
          "description": "Project directory path"
        }
      ]
    }
  },
  "examples": [
    {
      "description": "Start server in stdio mode",
      "command": "start --project D:\\projects\\my_video"
    },
    {
      "description": "Start server in HTTP mode (background)",
      "command": "start --project D:\\projects\\my_video --transport http --port 32123 --bg"
    },
    {
      "description": "Check if server is running",
      "command": "status"
    },
    {
      "description": "Generate Python client",
      "command": "generate-client --language python --output ./client.py"
    },
    {
      "description": "Get project information",
      "command": "project-info --project D:\\projects\\my_video"
    },
    {
      "description": "Show test documentation",
      "command": "test"
    },
    {
      "description": "Stop the server",
      "command": "stop"
    }
  ],
  "requirements": [
    "Node.js 18+ (for running this Skill)",
    ".NET SDK 10.0+ (for running MCP server)",
    "projectFrameCut project files (project.pjfc, timeline.json)"
  ],
  "documentation": {
    "main": "./SKILL_IMPLEMENTATION.md",
    "readme": "README.md",
    "tests": "MCP_TESTS.md",
    "architecture": "MCP_TOOL_MAPPING.md"
  },
  "scripts": {
    "start": "node skill.js start",
    "help": "node skill.js help"
  }
}
