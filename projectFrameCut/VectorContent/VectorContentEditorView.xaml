<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:projectFrameCut.DraftStuff"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             xmlns:ie="clr-namespace:projectFrameCut.InteractableEditor"
             x:Class="projectFrameCut.DraftStuff.VectorContentEditorView"
             x:DataType="local:VectorContentEditorView"
             BackgroundColor="#1a1a1a">

    <ContentView.Resources>
        <toolkit:BoolToObjectConverter x:Key="SvgBadgeColorConverter"
            TrueObject="#2A4A6A"
            FalseObject="#3A3A2A" />
        <toolkit:BoolToObjectConverter x:Key="BoolToSvgLabelConverter"
            TrueObject="SVG"
            FalseObject="Manual" />
        <toolkit:BoolToObjectConverter x:Key="SvgBadgeStrokeConverter"
            TrueObject="#4A6A8A"
            FalseObject="#5A5A3A" />
    </ContentView.Resources>

    <Grid RowDefinitions="*,Auto">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanelColumn" Width="280" />
            <ColumnDefinition x:Name="LeftSplitterColumn" Width="16" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition x:Name="RightSplitterColumn" Width="16" />
            <ColumnDefinition x:Name="RightPanelColumn" Width="300" />
        </Grid.ColumnDefinitions>

        <!-- ═══ LEFT PANEL: Component list + shape gallery ═══ -->
        <ScrollView x:Name="LeftPanel" Grid.Column="0">
            <VerticalStackLayout Spacing="10" Padding="10">

                <!-- Header -->
                <Label Text="{Binding ClipName}"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#E5E7EB" />

                <!-- ── Component List ── -->
                <Label Text="Components" FontSize="14" FontAttributes="Bold"
                       TextColor="#D1D5DB" Margin="0,6,0,0" />

                <CollectionView x:Name="ComponentsListView"
                                ItemsSource="{Binding Components}"
                                SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                                SelectionMode="Single"
                                SelectionChanged="OnComponentsSelectionChanged"
                                HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:VectorComponentItem">
                            <Border Padding="8,6" Margin="0,2"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="1"
                                    Stroke="#333333"
                                    BackgroundColor="#222222">
                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding ShapeIcon}"
                                           FontSize="18"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="13"
                                               TextColor="#E5E7EB"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding ShapeTypeDisplayName}"
                                                   FontSize="10"
                                                   TextColor="#6B7280" />
                                            <Border Padding="4,1" StrokeShape="RoundRectangle 3"
                                                    StrokeThickness="1"
                                                    Stroke="{Binding IsFromSvg, Converter={StaticResource SvgBadgeStrokeConverter}}"
                                                    BackgroundColor="{Binding IsFromSvg, Converter={StaticResource SvgBadgeColorConverter}}">
                                                <Label FontSize="8" TextColor="#E5E7EB"
                                                       Text="{Binding IsFromSvg, Converter={StaticResource BoolToSvgLabelConverter}}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Label Text="{Binding DurationInFrames, StringFormat='{0} fr'}"
                                               FontSize="10" TextColor="#9CA3AF"
                                               HorizontalOptions="End" />
                                        <Label Text="{Binding ElementCountText}"
                                               FontSize="9" TextColor="#6B7280"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No components. Add a shape or import an SVG."
                               FontSize="12" TextColor="#555555"
                               HorizontalOptions="Center"
                               Margin="0,20,0,0" />
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Component action buttons -->
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Import SVG" Command="{Binding ImportSvgCommand}"
                            BackgroundColor="#2A3A4A" TextColor="#93C5FD"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                    <Button Text="Group" Command="{Binding GroupComponentsCommand}"
                            IsEnabled="{Binding CanGroupComponents}"
                            BackgroundColor="#2A4A3A" TextColor="#86EFAC"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                    <Button Text="Ungroup" Command="{Binding UngroupComponentCommand}"
                            IsEnabled="{Binding CanUngroupComponent}"
                            BackgroundColor="#3A4A2A" TextColor="#D9F99D"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                    <Button Text="Remove" Command="{Binding RemoveComponentCommand}"
                            IsEnabled="{Binding HasSelectedComponent}"
                            BackgroundColor="#4A3030" TextColor="#FCA5A5"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                </HorizontalStackLayout>

                <!-- ── Shape Gallery (add panel) ── -->
                <Label Text="Add Shape" FontSize="14" FontAttributes="Bold"
                       TextColor="#D1D5DB" Margin="0,10,0,0" />

                <FlexLayout Direction="Row" Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start">
                    <BindableLayout.ItemsSource>
                        <Binding Path="ShapeGalleryItems" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ShapeGalleryItem">
                            <Border WidthRequest="72" HeightRequest="72"
                                    Margin="3" Padding="4"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="1"
                                    Stroke="#3a3a3a"
                                    BackgroundColor="#252525">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.AddComponentCommand}"
                                        CommandParameter="{Binding TypeName}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding Icon}"
                                           FontSize="24"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="8"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           MaximumWidthRequest="64" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- ── Legacy SVG Source Elements (old projects only) ── -->
                <VerticalStackLayout IsVisible="{Binding HasLegacySvgSource}"
                                     Spacing="4">
                    <Label Text="Legacy SVG Elements (read-only)"
                           FontSize="11" FontAttributes="Italic"
                           TextColor="#555555" Margin="0,8,0,0" />
                    <CollectionView ItemsSource="{Binding Elements}"
                                    HeightRequest="80">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:ElementItem">
                                <HorizontalStackLayout Spacing="6" Padding="4,2">
                                    <Label Text="{Binding Index, StringFormat='[{0}]'}"
                                           FontSize="11" TextColor="#6B7280"
                                           WidthRequest="28" />
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="11" TextColor="#9CA3AF" />
                                    <Label Text="{Binding TypeName}"
                                           FontSize="9" TextColor="#555555" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ── Quick Track Controls (for selected component or SVG element) ── -->
                <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                    <Label Text="Add Animation Track" FontSize="12"
                           TextColor="#9CA3AF" />

                    <Picker ItemsSource="{Binding AvailableFieldIds}"
                            SelectedItem="{Binding SelectedFieldIdForNewTrack}"
                            FontSize="12" TextColor="#E5E7EB"
                            BackgroundColor="#2a2a2a" />

                    <Button Text="Add Track"
                            Command="{Binding AddTrackCommand}"
                            IsEnabled="{Binding CanAddTrack}"
                            BackgroundColor="#2A4A2A"
                            TextColor="#86EFAC"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ LEFT SPLITTER ═══ -->
        <Grid Grid.Column="1" BackgroundColor="#333333">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnLeftSplitterPanUpdated" />
            </Grid.GestureRecognizers>
            <Button x:Name="ToggleLeftPanelButton"
                    Text="◀"
                    WidthRequest="32" HeightRequest="32"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="#444444" TextColor="#CCCCCC"
                    FontSize="10" CornerRadius="4" Padding="0"
                    Clicked="OnToggleLeftPanelClicked">
                <Button.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnLeftSplitterPanUpdated" />
                </Button.GestureRecognizers>
            </Button>
        </Grid>

        <!-- ═══ CENTER: InteractableEditor (interactive clip positioning) + Timeline ═══ -->
        <Grid Grid.Column="2" RowDefinitions="*,Auto">

            <!-- InteractableEditor replaces the old GraphicsView + manual overlay -->
            <ie:InteractableEditor x:Name="InteractiveEditor" />

            <!-- Timeline with controls -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="8,0,8,8">
                <!-- Timeline canvas -->
                <GraphicsView x:Name="TimelineCanvas"
                              HeightRequest="180"
                              BackgroundColor="#1a1a1a"
                              Margin="0,0,0,0">
                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTimelineTapped" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>

                <!-- Transport controls -->
                <Grid>
                    <HorizontalStackLayout Spacing="8">
                        <Button Text="▶" 
                                Command="{Binding PlayPauseCommand}"
                                FontSize="14" 
                                Padding="8,4"
                                TextColor="#93C5FD"
                                CornerRadius="4"  />
                        <Label Text="{Binding CurrentProgress, StringFormat='{0:P0}'}"
                               FontSize="11" 
                               TextColor="#9CA3AF"
                               Margin="4,0,0,0"
                               VerticalOptions="Center"
                               WidthRequest="28" 
                               LineBreakMode="NoWrap" />
                    </HorizontalStackLayout>
                    <Slider Value="{Binding CurrentProgress, Mode=TwoWay}"
                            Minimum="0" Maximum="1"
                            Margin="82,0,4,0"
                            VerticalOptions="Center" />

                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ═══ RIGHT SPLITTER ═══ -->
        <Grid Grid.Column="3" BackgroundColor="#333333">
            <Grid.GestureRecognizers>
                <PanGestureRecognizer PanUpdated="OnRightSplitterPanUpdated" />
            </Grid.GestureRecognizers>
            <Button x:Name="ToggleRightPanelButton"
                    Text="▶"
                    WidthRequest="32" HeightRequest="32"
                    HorizontalOptions="Center" VerticalOptions="Center"
                    BackgroundColor="#444444" TextColor="#CCCCCC"
                    FontSize="10" CornerRadius="4" Padding="0"
                    Clicked="OnToggleRightPanelClicked">
                <Button.GestureRecognizers>
                    <PanGestureRecognizer PanUpdated="OnRightSplitterPanUpdated" />
                </Button.GestureRecognizers>
            </Button>
        </Grid>

        <!-- ═══ RIGHT PANEL: Property editor ═══ -->
        <ScrollView x:Name="RightPanel" Grid.Column="4">
            <VerticalStackLayout Spacing="8" Padding="10">

                <Label Text="Properties" FontSize="14" FontAttributes="Bold"
                       TextColor="#D1D5DB" />

                <!-- No component selected placeholder -->
                <VerticalStackLayout Spacing="4" Margin="0,20,0,0" IsVisible="{Binding HasSelectedComponent, Converter={toolkit:InvertedBoolConverter}}">
                    <Label Text="Select a component"
                           FontSize="13" TextColor="#555555"
                           HorizontalOptions="Center" />
                    <Label Text="to edit its properties"
                           FontSize="11" TextColor="#444444"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Component properties (visible when selected) -->
                <VerticalStackLayout IsVisible="{Binding HasSelectedComponent}"
                                     Spacing="12">

                    <!-- Name & Duration -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Name" FontSize="11" TextColor="#9CA3AF" />
                        <Entry Text="{Binding SelectedComponent.DisplayName}"
                               FontSize="13" TextColor="#E5E7EB"
                               BackgroundColor="#2a2a2a"
                               Placeholder="Component name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Duration (frames)" FontSize="11" TextColor="#9CA3AF" />
                        <Entry Text="{Binding SelectedComponent.DurationInFrames}"
                               FontSize="13" TextColor="#E5E7EB"
                               BackgroundColor="#2a2a2a"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <!-- SVG Component Info (visible when SVG component selected) -->
                    <VerticalStackLayout IsVisible="{Binding SelectedComponent.IsFromSvg}"
                                         Spacing="4" Margin="0,4,0,0">
                        <Label Text="SVG Import" FontSize="12" FontAttributes="Bold"
                               TextColor="#93C5FD" />
                        <Label Text="{Binding SelectedComponent.SourceFilePath, StringFormat='Source: {0}'}"
                               FontSize="10" TextColor="#6B7280"
                               LineBreakMode="MiddleTruncation" />
                        <Label Text="{Binding SelectedComponent.ElementCountText}"
                               FontSize="11" TextColor="#9CA3AF" />
                    </VerticalStackLayout>

                    <!-- ═══ Dynamic property panel from handler (Position + Appearance + Shape) ═══ -->
                    <VerticalStackLayout x:Name="DynamicPropertyContainer"
                                         IsVisible="{Binding SelectedComponent.IsShapeEditable}" />

                    <!-- Track list for selected component -->
                    <Label Text="Animation Tracks" FontSize="12" FontAttributes="Bold"
                           TextColor="#D1D5DB" Margin="0,4,0,0" />

                    <CollectionView ItemsSource="{Binding SelectedComponent.Tracks}"
                                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    HeightRequest="160">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:AnimationTrackItem">
                                <Border Padding="6,4" Margin="0,1"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="0"
                                        BackgroundColor="#252525">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="11" TextColor="#D1D5DB"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding KeyFrameCount, StringFormat='{0} KF'}"
                                               FontSize="10" TextColor="#6B7280"
                                               Grid.Column="1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No tracks for this component"
                                   FontSize="11" TextColor="#555555"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,0" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <Button Text="Remove Track"
                            Command="{Binding RemoveTrackCommand}"
                            IsEnabled="{Binding CanRemoveTrack}"
                            BackgroundColor="#4A3030" TextColor="#FCA5A5"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />

                    <!-- ── Keyframe Properties ── -->
                    <VerticalStackLayout IsVisible="{Binding HasSelectedKeyFrame}"
                                         Spacing="10" Margin="0,6,0,0">

                        <BoxView HeightRequest="1" BackgroundColor="#333333"
                                 Margin="0,4,0,0" />

                        <Label Text="Keyframe" FontSize="12" FontAttributes="Bold"
                               TextColor="#FDE68A" />

                        <!-- Time -->
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Time" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0"
                                       WidthRequest="32" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedKeyFrame.Time}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedKeyFrame.TimeDisplay}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2"
                                       WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Value -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Value" FontSize="11" TextColor="#9CA3AF" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Entry Text="{Binding SelectedKeyFrame.Value}"
                                       FontSize="13" TextColor="#E5E7EB"
                                       BackgroundColor="#2a2a2a"
                                       Keyboard="Numeric"
                                       Grid.Column="0" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                    <Slider Minimum="0" Maximum="1"
                                            Value="{Binding SelectedKeyFrame.Value}"
                                            WidthRequest="80"
                                            VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Text="{Binding SelectedKeyFrame.ValueDisplay}"
                                   FontSize="9" TextColor="#555555"
                                   HorizontalOptions="End" />
                        </VerticalStackLayout>

                        <!-- Easing -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Easing" FontSize="11" TextColor="#9CA3AF" />
                            <Picker ItemsSource="{Binding AllEasingModes}"
                                    SelectedItem="{Binding SelectedKeyFrame.Easing}"
                                    FontSize="12" TextColor="#E5E7EB"
                                    BackgroundColor="#2a2a2a" />
                            <Label Text="{Binding SelectedKeyFrame.EasingDisplay}"
                                   FontSize="9" TextColor="#555555" />
                        </VerticalStackLayout>

                        <!-- Delete -->
                        <Button Text="Delete Keyframe"
                                Command="{Binding DeleteKeyFrameCommand}"
                                IsEnabled="{Binding HasSelectedKeyFrame}"
                                BackgroundColor="#4A3030" TextColor="#FCA5A5"
                                FontSize="12" Padding="10,4"
                                CornerRadius="4" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ BOTTOM: Apply/Cancel buttons ═══ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="5"
              ColumnDefinitions="*,Auto,Auto,Auto"
              ColumnSpacing="10" Padding="12,8"
              BackgroundColor="#222222">
            <Button Text="Export JSON"
                    Command="{Binding ExportJsonCommand}"
                    TextColor="#C4B5FD"
                    FontSize="14" FontAttributes="Bold"
                    Padding="20,8" CornerRadius="6"
                    Grid.Column="1" />
            <Button Text="Apply Changes"
                    Command="{Binding ApplyChangesCommand}"
                    TextColor="#86EFAC"
                    FontSize="14" FontAttributes="Bold"
                    Padding="20,8" CornerRadius="6"
                    Grid.Column="2" />
            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    TextColor="#FCA5A5"
                    FontSize="14"
                    Padding="20,8" CornerRadius="6"
                    Grid.Column="3" />
        </Grid>

    </Grid>
</ContentView>
