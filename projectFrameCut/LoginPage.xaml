<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.LoginPage"
             Title="登录 / 注册"
             BackgroundColor="{DynamicResource PageBackgroundColor}">
    
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="20" VerticalOptions="Center">
            
            <!-- Logo或应用标题 -->
            <Label Text="projectFrameCut" 
                   FontSize="32" 
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   Margin="0,0,0,20"/>
            
            <!-- 登录/注册Tab切换 -->
            <Grid ColumnDefinitions="*,*" HeightRequest="50" Margin="0,0,0,10">
                <Button x:Name="LoginTabButton" 
                        Text="登录" 
                        Grid.Column="0"
                        Clicked="OnLoginTabClicked"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"/>
                <Button x:Name="RegisterTabButton" 
                        Text="注册" 
                        Grid.Column="1"
                        Clicked="OnRegisterTabClicked"
                        BackgroundColor="{DynamicResource Gray200}"
                        TextColor="{DynamicResource Gray900}"/>
            </Grid>
            
            <!-- 登录表单 -->
            <VerticalStackLayout x:Name="LoginFormLayout" Spacing="15" IsVisible="True">
                <Entry x:Name="LoginUserNameEntry"
                       Placeholder="用户名或邮箱"
                       ReturnType="Next"
                       TextChanged="OnEntryTextChanged"/>
                
                <Entry x:Name="LoginPasswordEntry"
                       Placeholder="密码"
                       IsPassword="True"
                       ReturnType="Done"
                       Completed="OnLoginClicked"
                       TextChanged="OnEntryTextChanged"/>
                
                <Button x:Name="LoginButton"
                        Text="登录"
                        Clicked="OnLoginClicked"
                        IsEnabled="False"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="10"/>
            </VerticalStackLayout>
            
            <!-- 注册表单 -->
            <VerticalStackLayout x:Name="RegisterFormLayout" Spacing="15" IsVisible="False">
                <Entry x:Name="RegisterUserNameEntry"
                       Placeholder="用户名"
                       ReturnType="Next"
                       TextChanged="OnEntryTextChanged"/>
                
                <Entry x:Name="RegisterEmailEntry"
                       Placeholder="邮箱"
                       Keyboard="Email"
                       ReturnType="Next"
                       TextChanged="OnEntryTextChanged"/>
                
                <Entry x:Name="RegisterPasswordEntry"
                       Placeholder="密码"
                       IsPassword="True"
                       ReturnType="Next"
                       TextChanged="OnEntryTextChanged"/>
                
                <Entry x:Name="RegisterConfirmPasswordEntry"
                       Placeholder="确认密码"
                       IsPassword="True"
                       ReturnType="Done"
                       Completed="OnRegisterClicked"
                       TextChanged="OnEntryTextChanged"/>
                
                <Button x:Name="RegisterButton"
                        Text="注册"
                        Clicked="OnRegisterClicked"
                        IsEnabled="False"
                        BackgroundColor="{DynamicResource Primary}"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="10"/>
            </VerticalStackLayout>
            
            <!-- 分隔线 -->
            <BoxView HeightRequest="1" 
                     BackgroundColor="{DynamicResource Gray300}"
                     Margin="0,10,0,10"/>
            
            <Label Text="或使用第三方账号登录" 
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   TextColor="{DynamicResource Gray600}"/>
            
            <!-- OAuth登录按钮 -->
            <VerticalStackLayout Spacing="10">
                <Button x:Name="GoogleLoginButton"
                        Text="使用 Google 登录"
                        Clicked="OnGoogleLoginClicked"
                        BackgroundColor="#DB4437"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="10"/>
                
                <Button x:Name="GitHubLoginButton"
                        Text="使用 GitHub 登录"
                        Clicked="OnGitHubLoginClicked"
                        BackgroundColor="#24292E"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="10"/>
                
                <Button x:Name="MicrosoftLoginButton"
                        Text="使用 Microsoft 登录"
                        Clicked="OnMicrosoftLoginClicked"
                        BackgroundColor="#00A4EF"
                        TextColor="White"
                        HeightRequest="50"
                        CornerRadius="10"/>
            </VerticalStackLayout>
            
            <!-- 加载指示器 -->
            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               Color="{DynamicResource Primary}"
                               HeightRequest="50"
                               WidthRequest="50"
                               HorizontalOptions="Center"/>
            
            <!-- 状态消息 -->
            <Label x:Name="StatusLabel"
                   IsVisible="False"
                   HorizontalTextAlignment="Center"
                   FontSize="14"
                   Margin="0,10,0,0"/>
            
            <!-- 跳过登录按钮（可选） -->
            <Button x:Name="SkipLoginButton"
                    Text="稍后登录"
                    Clicked="OnSkipLoginClicked"
                    BackgroundColor="Transparent"
                    TextColor="{DynamicResource Gray600}"
                    BorderWidth="0"
                    Margin="0,20,0,0"/>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
