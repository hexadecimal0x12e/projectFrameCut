<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:projectFrameCut.DraftStuff"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             xmlns:ie="clr-namespace:projectFrameCut.InteractableEditor"
             x:Class="projectFrameCut.DraftStuff.StoryboardEditorView"
             x:DataType="local:StoryboardEditorView"
             BackgroundColor="#1a1a1a">

    <ContentView.Resources>
        <toolkit:BoolToObjectConverter x:Key="SvgBadgeColorConverter"
            TrueObject="#2A4A6A"
            FalseObject="#3A3A2A" />
        <toolkit:BoolToObjectConverter x:Key="BoolToSvgLabelConverter"
            TrueObject="SVG"
            FalseObject="Manual" />
        <toolkit:BoolToObjectConverter x:Key="SvgBadgeStrokeConverter"
            TrueObject="#4A6A8A"
            FalseObject="#5A5A3A" />
    </ContentView.Resources>

    <Grid RowDefinitions="*,Auto" ColumnDefinitions="280,2,*,2,300">

        <!-- ═══ LEFT PANEL: Component list + shape gallery ═══ -->
        <ScrollView Grid.Column="0">
            <VerticalStackLayout Spacing="10" Padding="10">

                <!-- Header -->
                <Label Text="{Binding ClipName}"
                       FontSize="18" FontAttributes="Bold"
                       TextColor="#E5E7EB" />

                <!-- Mode indicator -->
                <Border Padding="6,3" StrokeShape="RoundRectangle 4"
                        StrokeThickness="0">
                    <Border.Resources>
                        <toolkit:BoolToObjectConverter x:Key="ModeTextConverter"
                            TrueObject="Composition Mode (no SVG)"
                            FalseObject="SVG + Composition Mode" />
                    </Border.Resources>
                    <Label FontSize="11" TextColor="#9CA3AF"
                           Text="{Binding IsCompositionMode, Converter={StaticResource ModeTextConverter}}" />
                </Border>

                <!-- ── Component List ── -->
                <Label Text="Components" FontSize="14" FontAttributes="Bold"
                       TextColor="#D1D5DB" Margin="0,6,0,0" />

                <CollectionView ItemsSource="{Binding Components}"
                                SelectedItem="{Binding SelectedComponent, Mode=TwoWay}"
                                SelectionMode="Single"
                                HeightRequest="200">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:VectorComponentItem">
                            <Border Padding="8,6" Margin="0,2"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="1"
                                    Stroke="#333333"
                                    BackgroundColor="#222222">
                                <Grid ColumnDefinitions="24,*,Auto" ColumnSpacing="8">
                                    <Label Text="{Binding ShapeIcon}"
                                           FontSize="18"
                                           VerticalOptions="Center"
                                           HorizontalOptions="Center" />
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center">
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="13"
                                               TextColor="#E5E7EB"
                                               LineBreakMode="TailTruncation" />
                                        <HorizontalStackLayout Spacing="6">
                                            <Label Text="{Binding ShapeTypeDisplayName}"
                                                   FontSize="10"
                                                   TextColor="#6B7280" />
                                            <Border Padding="4,1" StrokeShape="RoundRectangle 3"
                                                    StrokeThickness="1"
                                                    Stroke="{Binding IsFromSvg, Converter={StaticResource SvgBadgeStrokeConverter}}"
                                                    BackgroundColor="{Binding IsFromSvg, Converter={StaticResource SvgBadgeColorConverter}}">
                                                <Label FontSize="8" TextColor="#E5E7EB"
                                                       Text="{Binding IsFromSvg, Converter={StaticResource BoolToSvgLabelConverter}}" />
                                            </Border>
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>
                                    <VerticalStackLayout Grid.Column="2" VerticalOptions="Center">
                                        <Label Text="{Binding DurationInFrames, StringFormat='{0} fr'}"
                                               FontSize="10" TextColor="#9CA3AF"
                                               HorizontalOptions="End" />
                                        <Label Text="{Binding ElementCountText}"
                                               FontSize="9" TextColor="#6B7280"
                                               HorizontalOptions="End" />
                                    </VerticalStackLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                    <CollectionView.EmptyView>
                        <Label Text="No components. Add a shape or import an SVG."
                               FontSize="12" TextColor="#555555"
                               HorizontalOptions="Center"
                               Margin="0,20,0,0" />
                    </CollectionView.EmptyView>
                </CollectionView>

                <!-- Component action buttons -->
                <HorizontalStackLayout Spacing="8">
                    <Button Text="Import SVG" Command="{Binding ImportSvgCommand}"
                            BackgroundColor="#2A3A4A" TextColor="#93C5FD"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                    <Button Text="Remove" Command="{Binding RemoveComponentCommand}"
                            IsEnabled="{Binding HasSelectedComponent}"
                            BackgroundColor="#4A3030" TextColor="#FCA5A5"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                </HorizontalStackLayout>

                <!-- ── Shape Gallery (add panel) ── -->
                <Label Text="Add Shape" FontSize="14" FontAttributes="Bold"
                       TextColor="#D1D5DB" Margin="0,10,0,0" />

                <FlexLayout Direction="Row" Wrap="Wrap"
                            JustifyContent="Start"
                            AlignItems="Start">
                    <BindableLayout.ItemsSource>
                        <Binding Path="ShapeGalleryItems" />
                    </BindableLayout.ItemsSource>
                    <BindableLayout.ItemTemplate>
                        <DataTemplate x:DataType="local:ShapeGalleryItem">
                            <Border WidthRequest="72" HeightRequest="72"
                                    Margin="3" Padding="4"
                                    StrokeShape="RoundRectangle 6"
                                    StrokeThickness="1"
                                    Stroke="#3a3a3a"
                                    BackgroundColor="#252525">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type ContentView}}, Path=BindingContext.AddComponentCommand}"
                                        CommandParameter="{Binding ShapeType}" />
                                </Border.GestureRecognizers>
                                <VerticalStackLayout VerticalOptions="Center"
                                                     HorizontalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="{Binding Icon}"
                                           FontSize="24"
                                           HorizontalOptions="Center" />
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="8"
                                           TextColor="#9CA3AF"
                                           HorizontalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           MaximumWidthRequest="64" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </FlexLayout>

                <!-- ── Legacy SVG Source Elements (old projects only) ── -->
                <VerticalStackLayout IsVisible="{Binding HasLegacySvgSource}"
                                     Spacing="4">
                    <Label Text="Legacy SVG Elements (read-only)"
                           FontSize="11" FontAttributes="Italic"
                           TextColor="#555555" Margin="0,8,0,0" />
                    <CollectionView ItemsSource="{Binding Elements}"
                                    HeightRequest="80">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:ElementItem">
                                <HorizontalStackLayout Spacing="6" Padding="4,2">
                                    <Label Text="{Binding Index, StringFormat='[{0}]'}"
                                           FontSize="11" TextColor="#6B7280"
                                           WidthRequest="28" />
                                    <Label Text="{Binding DisplayName}"
                                           FontSize="11" TextColor="#9CA3AF" />
                                    <Label Text="{Binding TypeName}"
                                           FontSize="9" TextColor="#555555" />
                                </HorizontalStackLayout>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>

                <!-- ── Quick Track Controls (for selected component or SVG element) ── -->
                <VerticalStackLayout Spacing="6" Margin="0,8,0,0">
                    <Label Text="Add Animation Track" FontSize="12"
                           TextColor="#9CA3AF" />

                    <Picker ItemsSource="{Binding AllPropertiesList}"
                            SelectedItem="{Binding SelectedPropertyForNewTrack}"
                            FontSize="12" TextColor="#E5E7EB"
                            BackgroundColor="#2a2a2a" />

                    <Button Text="Add Track"
                            Command="{Binding AddTrackCommand}"
                            IsEnabled="{Binding CanAddTrack}"
                            BackgroundColor="#2A4A2A"
                            TextColor="#86EFAC"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ DIVIDER ═══ -->
        <BoxView Grid.Column="1" WidthRequest="2"
                 BackgroundColor="#333333"
                 VerticalOptions="Fill" />

        <!-- ═══ CENTER: InteractableEditor (interactive clip positioning) + Timeline ═══ -->
        <Grid Grid.Column="2" RowDefinitions="*,Auto">

            <!-- InteractableEditor replaces the old GraphicsView + manual overlay -->
            <ie:InteractableEditor x:Name="InteractiveEditor" />

            <!-- Timeline with controls -->
            <VerticalStackLayout Grid.Row="1" Spacing="4" Margin="8,0,8,8">
                <!-- Timeline canvas -->
                <GraphicsView x:Name="TimelineCanvas"
                              HeightRequest="180"
                              BackgroundColor="#1a1a1a">
                    <GraphicsView.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnTimelineTapped" />
                    </GraphicsView.GestureRecognizers>
                </GraphicsView>

                <!-- Transport controls -->
                <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto,Auto"
                      ColumnSpacing="8">
                    <Button Text="▶" Command="{Binding PlayPauseCommand}"
                            FontSize="14" Padding="8,4"
                            TextColor="#93C5FD"
                            CornerRadius="4"
                            Grid.Column="0" />
                    <Button Text="■" Command="{Binding StopCommand}"
                            FontSize="14" Padding="8,4"
                            TextColor="#FCA5A5"
                            CornerRadius="4"
                            Grid.Column="1" />
                    <Slider Value="{Binding CurrentProgress, Mode=TwoWay}"
                            Minimum="0" Maximum="1"
                            Grid.Column="2"
                            VerticalOptions="Center" />
                    <Label Text="{Binding CurrentProgress, StringFormat='{0:P0}'}"
                           FontSize="11" TextColor="#9CA3AF"
                           VerticalOptions="Center"
                           Grid.Column="3" WidthRequest="44" />
                    <Button Text="+KF"
                            Command="{Binding AddKeyFrameAtCurrentTimeCommand}"
                            IsEnabled="{Binding CanAddKeyFrame}"
                            FontSize="11" Padding="6,4"
                            TextColor="#FDE68A"
                            CornerRadius="4"
                            Grid.Column="4" />
                </Grid>
            </VerticalStackLayout>
        </Grid>

        <!-- ═══ DIVIDER ═══ -->
        <BoxView Grid.Column="3" WidthRequest="2"
                 BackgroundColor="#333333"
                 VerticalOptions="Fill" />

        <!-- ═══ RIGHT PANEL: Property editor ═══ -->
        <ScrollView Grid.Column="4">
            <VerticalStackLayout Spacing="8" Padding="10">

                <Label Text="Properties" FontSize="14" FontAttributes="Bold"
                       TextColor="#D1D5DB" />

                <!-- No component selected placeholder -->
                <VerticalStackLayout Spacing="4" Margin="0,20,0,0" IsVisible="{Binding HasSelectedComponent, Converter={toolkit:InvertedBoolConverter}}">
                    <Label Text="Select a component"
                           FontSize="13" TextColor="#555555"
                           HorizontalOptions="Center" />
                    <Label Text="to edit its properties"
                           FontSize="11" TextColor="#444444"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Component properties (visible when selected) -->
                <VerticalStackLayout IsVisible="{Binding HasSelectedComponent}"
                                     Spacing="12">

                    <!-- Name & Duration -->
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Name" FontSize="11" TextColor="#9CA3AF" />
                        <Entry Text="{Binding SelectedComponent.DisplayName}"
                               FontSize="13" TextColor="#E5E7EB"
                               BackgroundColor="#2a2a2a"
                               Placeholder="Component name" />
                    </VerticalStackLayout>

                    <VerticalStackLayout Spacing="4">
                        <Label Text="Duration (frames)" FontSize="11" TextColor="#9CA3AF" />
                        <Entry Text="{Binding SelectedComponent.DurationInFrames}"
                               FontSize="13" TextColor="#E5E7EB"
                               BackgroundColor="#2a2a2a"
                               Keyboard="Numeric" />
                    </VerticalStackLayout>

                    <!-- SVG Component Info (visible when SVG component selected) -->
                    <VerticalStackLayout IsVisible="{Binding SelectedComponent.IsFromSvg}"
                                         Spacing="4" Margin="0,4,0,0">
                        <Label Text="SVG Import" FontSize="12" FontAttributes="Bold"
                               TextColor="#93C5FD" />
                        <Label Text="{Binding SelectedComponent.SourceFilePath, StringFormat='Source: {0}'}"
                               FontSize="10" TextColor="#6B7280"
                               LineBreakMode="MiddleTruncation" />
                        <Label Text="{Binding SelectedComponent.ElementCountText}"
                               FontSize="11" TextColor="#9CA3AF" />
                    </VerticalStackLayout>

                    <!-- Position (hidden for SVG components) -->
                    <VerticalStackLayout IsVisible="{Binding SelectedComponent.IsShapeEditable}">
                    <Label Text="Position" FontSize="12" FontAttributes="Bold"
                           TextColor="#D1D5DB" Margin="0,4,0,0" />

                    <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="8" RowSpacing="6">
                        <Label Text="X:" FontSize="11" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="0" Grid.Column="0" />
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding SelectedComponent.RelativeX}"
                                Grid.Row="0" Grid.Column="1" />

                        <Label Text="Y:" FontSize="11" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="1" Grid.Column="0" />
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding SelectedComponent.RelativeY}"
                                Grid.Row="1" Grid.Column="1" />

                        <Label Text="Rot:" FontSize="11" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="2" Grid.Column="0" />
                        <Slider Minimum="-3.1416" Maximum="3.1416"
                                Value="{Binding SelectedComponent.Rotation}"
                                Grid.Row="2" Grid.Column="1" />

                        <Label Text="Layer:" FontSize="11" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="3" Grid.Column="0" />
                        <Entry Text="{Binding SelectedComponent.LayerIndex}"
                               FontSize="12" TextColor="#E5E7EB"
                               BackgroundColor="#2a2a2a"
                               Keyboard="Numeric"
                               Grid.Row="3" Grid.Column="1" />
                    </Grid>

                    <!-- Visual properties -->
                    <Label Text="Appearance" FontSize="12" FontAttributes="Bold"
                           TextColor="#D1D5DB" Margin="0,4,0,0" />

                    <!-- Thickness -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                        <Label Text="Thickness:" FontSize="11" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Column="0" />
                        <Slider Minimum="0" Maximum="20"
                                Value="{Binding SelectedComponent.Thickness}"
                                Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.Thickness, StringFormat='{0:F1}'}"
                               FontSize="10" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Column="2"
                               WidthRequest="28" />
                    </Grid>

                    <!-- Stroke Color -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,4,0,0">
                        <Border WidthRequest="24" HeightRequest="24"
                                StrokeShape="RoundRectangle 4"
                                StrokeThickness="1" Stroke="#444444"
                                BackgroundColor="{Binding SelectedComponent.StrokeColorPreview}"
                                Grid.Column="0" VerticalOptions="Center" />
                        <Label Text="Stroke" FontSize="11" FontAttributes="Bold"
                               TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.StrokeColorHex}"
                               FontSize="10" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Column="2"
                               HorizontalOptions="End" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="6" RowSpacing="2">
                        <Label Text="R" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="0" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding SelectedComponent.StrokeR}"
                                Grid.Row="0" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.StrokeR}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="0" Grid.Column="2" WidthRequest="26" />
                        <Label Text="G" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="1" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding SelectedComponent.StrokeG}"
                                Grid.Row="1" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.StrokeG}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="1" Grid.Column="2" WidthRequest="26" />
                        <Label Text="B" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="2" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding SelectedComponent.StrokeB}"
                                Grid.Row="2" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.StrokeB}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="2" Grid.Column="2" WidthRequest="26" />
                        <Label Text="A" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="3" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding SelectedComponent.StrokeA}"
                                Grid.Row="3" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.StrokeA, StringFormat='{0:F2}'}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="3" Grid.Column="2" WidthRequest="26" />
                    </Grid>

                    <!-- Fill Color -->
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="6" Margin="0,6,0,0">
                        <Border WidthRequest="24" HeightRequest="24"
                                StrokeShape="RoundRectangle 4"
                                StrokeThickness="1" Stroke="#444444"
                                BackgroundColor="{Binding SelectedComponent.FillColorPreview}"
                                Grid.Column="0" VerticalOptions="Center" />
                        <Label Text="Fill" FontSize="11" FontAttributes="Bold"
                               TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.FillColorHex}"
                               FontSize="10" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Column="2"
                               HorizontalOptions="End" />
                    </Grid>

                    <Grid ColumnDefinitions="Auto,*,Auto" RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="6" RowSpacing="2">
                        <Label Text="R" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="0" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding SelectedComponent.FillR}"
                                Grid.Row="0" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.FillR}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="0" Grid.Column="2" WidthRequest="26" />
                        <Label Text="G" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="1" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding SelectedComponent.FillG}"
                                Grid.Row="1" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.FillG}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="1" Grid.Column="2" WidthRequest="26" />
                        <Label Text="B" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="2" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="255"
                                Value="{Binding SelectedComponent.FillB}"
                                Grid.Row="2" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.FillB}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="2" Grid.Column="2" WidthRequest="26" />
                        <Label Text="A" FontSize="10" TextColor="#9CA3AF"
                               VerticalOptions="Center" Grid.Row="3" Grid.Column="0" WidthRequest="14" />
                        <Slider Minimum="0" Maximum="1"
                                Value="{Binding SelectedComponent.FillA}"
                                Grid.Row="3" Grid.Column="1" />
                        <Label Text="{Binding SelectedComponent.FillA, StringFormat='{0:F2}'}"
                               FontSize="9" TextColor="#6B7280"
                               VerticalOptions="Center" Grid.Row="3" Grid.Column="2" WidthRequest="26" />
                    </Grid>

                    <!-- ═══ Shape Parameters ═══ -->
                    <VerticalStackLayout Spacing="8" Margin="0,6,0,0">

                        <Label Text="Shape" FontSize="12" FontAttributes="Bold"
                               TextColor="#D1D5DB" />

                        <!-- ── Rectangle / RoundedRectangle: Width, Height ── -->
                        <VerticalStackLayout IsVisible="{Binding SelectedComponent.HasWidthHeight}"
                                             Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="W:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0.01" Maximum="1"
                                        Value="{Binding SelectedComponent.ShapeWidth}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.ShapeWidth, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="H:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0.01" Maximum="1"
                                        Value="{Binding SelectedComponent.ShapeHeight}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.ShapeHeight, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- ── RoundedRectangle: CornerRadius ── -->
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6"
                              IsVisible="{Binding SelectedComponent.HasCornerRadius}">
                            <Label Text="Corner:" FontSize="11" TextColor="#9CA3AF"
                                   VerticalOptions="Center" Grid.Column="0" WidthRequest="36" />
                            <Slider Minimum="0" Maximum="0.5"
                                    Value="{Binding SelectedComponent.CornerRadius}"
                                    Grid.Column="1" />
                            <Label Text="{Binding SelectedComponent.CornerRadius, StringFormat='{0:F3}'}"
                                   FontSize="10" TextColor="#6B7280"
                                   VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                        </Grid>

                        <!-- ── Ellipse: RadiusX, RadiusY ── -->
                        <VerticalStackLayout IsVisible="{Binding SelectedComponent.HasRadiusXY}"
                                             Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="RX:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0.01" Maximum="0.5"
                                        Value="{Binding SelectedComponent.RadiusX}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.RadiusX, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="RY:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0.01" Maximum="0.5"
                                        Value="{Binding SelectedComponent.RadiusY}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.RadiusY, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- ── Arc: Center, Radius, Angles ── -->
                        <VerticalStackLayout IsVisible="{Binding SelectedComponent.HasArcParams}"
                                             Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="CX:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.ArcCenterX}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.ArcCenterX, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="CY:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.ArcCenterY}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.ArcCenterY, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="RX:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0.01" Maximum="0.5"
                                        Value="{Binding SelectedComponent.RadiusX}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.RadiusX, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="RY:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0.01" Maximum="0.5"
                                        Value="{Binding SelectedComponent.RadiusY}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.RadiusY, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Start:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="28" />
                                <Slider Minimum="-6.2832" Maximum="6.2832"
                                        Value="{Binding SelectedComponent.ArcStartAngle}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.ArcStartAngle, StringFormat='{0:F2}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Sweep:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="28" />
                                <Slider Minimum="-6.2832" Maximum="6.2832"
                                        Value="{Binding SelectedComponent.ArcSweepAngle}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.ArcSweepAngle, StringFormat='{0:F2}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- ── Line: X1,Y1 to X2,Y2 ── -->
                        <VerticalStackLayout IsVisible="{Binding SelectedComponent.HasLinePoints}"
                                             Spacing="4">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X1:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.LineX1}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.LineX1, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y1:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.LineY1}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.LineY1, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X2:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.LineX2}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.LineX2, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y2:" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="22" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.LineY2}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.LineY2, StringFormat='{0:F3}'}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- ── Cubic Bezier: X1..X4, Y1..Y4 ── -->
                        <VerticalStackLayout IsVisible="{Binding SelectedComponent.HasCubicBezierPoints}"
                                             Spacing="4">
                            <Label Text="Cubic Bezier Control Points" FontSize="10"
                                   TextColor="#6B7280" FontAttributes="Italic" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X1:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicX1}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicX1, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y1:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicY1}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicY1, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X2:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicX2}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicX2, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y2:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicY2}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicY2, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X3:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicX3}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicX3, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y3:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicY3}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicY3, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X4:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicX4}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicX4, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y4:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.CubicY4}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.CubicY4, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- ── Quadratic Bezier: X1..X3, Y1..Y3 ── -->
                        <VerticalStackLayout IsVisible="{Binding SelectedComponent.HasQuadraticBezierPoints}"
                                             Spacing="4">
                            <Label Text="Quadratic Bezier Control Points" FontSize="10"
                                   TextColor="#6B7280" FontAttributes="Italic" />
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X1:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.QuadX1}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.QuadX1, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y1:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.QuadY1}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.QuadY1, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X2:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.QuadX2}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.QuadX2, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y2:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.QuadY2}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.QuadY2, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="X3:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.QuadX3}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.QuadX3, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Y3:" FontSize="10" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0" WidthRequest="18" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedComponent.QuadY3}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedComponent.QuadY3, StringFormat='{0:F3}'}"
                                       FontSize="9" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2" WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- ── Polygon / Polyline: vertex info ── -->
                        <VerticalStackLayout IsVisible="{Binding SelectedComponent.HasPointsList}"
                                             Spacing="4">
                            <Label Text="Vertices" FontSize="11" FontAttributes="Bold"
                                   TextColor="#9CA3AF" />
                            <Label Text="{Binding SelectedComponent.VertexCountText}"
                                   FontSize="10" TextColor="#6B7280" />
                        </VerticalStackLayout>

                    </VerticalStackLayout>
                    <!-- End of shape parameters -->

                    </VerticalStackLayout>
                    <!-- End of shape-editable properties -->

                    <!-- Track list for selected component -->
                    <Label Text="Animation Tracks" FontSize="12" FontAttributes="Bold"
                           TextColor="#D1D5DB" Margin="0,4,0,0" />

                    <CollectionView ItemsSource="{Binding SelectedComponent.Tracks}"
                                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay}"
                                    SelectionMode="Single"
                                    HeightRequest="160">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="local:AnimationTrackItem">
                                <Border Padding="6,4" Margin="0,1"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="0"
                                        BackgroundColor="#252525">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <Label Text="{Binding DisplayName}"
                                               FontSize="11" TextColor="#D1D5DB"
                                               LineBreakMode="TailTruncation" />
                                        <Label Text="{Binding KeyFrameCount, StringFormat='{0} KF'}"
                                               FontSize="10" TextColor="#6B7280"
                                               Grid.Column="1" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                        <CollectionView.EmptyView>
                            <Label Text="No tracks for this component"
                                   FontSize="11" TextColor="#555555"
                                   HorizontalOptions="Center"
                                   Margin="0,10,0,0" />
                        </CollectionView.EmptyView>
                    </CollectionView>

                    <Button Text="Remove Track"
                            Command="{Binding RemoveTrackCommand}"
                            IsEnabled="{Binding CanRemoveTrack}"
                            BackgroundColor="#4A3030" TextColor="#FCA5A5"
                            FontSize="12" Padding="10,4"
                            CornerRadius="4" />

                    <!-- ── Keyframe Properties ── -->
                    <VerticalStackLayout IsVisible="{Binding HasSelectedKeyFrame}"
                                         Spacing="10" Margin="0,6,0,0">

                        <BoxView HeightRequest="1" BackgroundColor="#333333"
                                 Margin="0,4,0,0" />

                        <Label Text="Keyframe" FontSize="12" FontAttributes="Bold"
                               TextColor="#FDE68A" />

                        <!-- Time -->
                        <VerticalStackLayout Spacing="2">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                <Label Text="Time" FontSize="11" TextColor="#9CA3AF"
                                       VerticalOptions="Center" Grid.Column="0"
                                       WidthRequest="32" />
                                <Slider Minimum="0" Maximum="1"
                                        Value="{Binding SelectedKeyFrame.Time}"
                                        Grid.Column="1" />
                                <Label Text="{Binding SelectedKeyFrame.TimeDisplay}"
                                       FontSize="10" TextColor="#6B7280"
                                       VerticalOptions="Center" Grid.Column="2"
                                       WidthRequest="36" />
                            </Grid>
                        </VerticalStackLayout>

                        <!-- Value -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Value" FontSize="11" TextColor="#9CA3AF" />
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                <Entry Text="{Binding SelectedKeyFrame.Value}"
                                       FontSize="13" TextColor="#E5E7EB"
                                       BackgroundColor="#2a2a2a"
                                       Keyboard="Numeric"
                                       Grid.Column="0" />
                                <HorizontalStackLayout Grid.Column="1" Spacing="4">
                                    <Slider Minimum="0" Maximum="1"
                                            Value="{Binding SelectedKeyFrame.Value}"
                                            WidthRequest="80"
                                            VerticalOptions="Center" />
                                </HorizontalStackLayout>
                            </Grid>
                            <Label Text="{Binding SelectedKeyFrame.ValueDisplay}"
                                   FontSize="9" TextColor="#555555"
                                   HorizontalOptions="End" />
                        </VerticalStackLayout>

                        <!-- Easing -->
                        <VerticalStackLayout Spacing="2">
                            <Label Text="Easing" FontSize="11" TextColor="#9CA3AF" />
                            <Picker ItemsSource="{Binding AllEasingModes}"
                                    SelectedItem="{Binding SelectedKeyFrame.Easing}"
                                    FontSize="12" TextColor="#E5E7EB"
                                    BackgroundColor="#2a2a2a" />
                            <Label Text="{Binding SelectedKeyFrame.EasingDisplay}"
                                   FontSize="9" TextColor="#555555" />
                        </VerticalStackLayout>

                        <!-- Delete -->
                        <Button Text="Delete Keyframe"
                                Command="{Binding DeleteKeyFrameCommand}"
                                IsEnabled="{Binding HasSelectedKeyFrame}"
                                BackgroundColor="#4A3030" TextColor="#FCA5A5"
                                FontSize="12" Padding="10,4"
                                CornerRadius="4" />

                    </VerticalStackLayout>

                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <!-- ═══ BOTTOM: Apply/Cancel buttons ═══ -->
        <Grid Grid.Row="1" Grid.ColumnSpan="5"
              ColumnDefinitions="*,Auto,Auto"
              ColumnSpacing="10" Padding="12,8"
              BackgroundColor="#222222">
            <Button Text="Apply Changes"
                    Command="{Binding ApplyChangesCommand}"
                    TextColor="#86EFAC"
                    FontSize="14" FontAttributes="Bold"
                    Padding="20,8" CornerRadius="6"
                    Grid.Column="1" />
            <Button Text="Cancel"
                    Command="{Binding CancelCommand}"
                    TextColor="#FCA5A5"
                    FontSize="14"
                    Padding="20,8" CornerRadius="6"
                    Grid.Column="2" />
        </Grid>

    </Grid>
</ContentView>
