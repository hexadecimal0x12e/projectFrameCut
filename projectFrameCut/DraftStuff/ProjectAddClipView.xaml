<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.DraftStuff.ProjectAddClipView"
             xmlns:viewmodels="clr-namespace:projectFrameCut.ViewModels"
             xmlns:tv="clr-namespace:projectFrameCut.ApplicationAPIBase.Views.TabbedView;assembly=projectFrameCut.ApplicationAPIBase"
             xmlns:l="clr-namespace:LocalizedResources"
             x:DataType="viewmodels:ProjectAddClipViewModel">

    <tv:TabbedView x:Name="MainTabView" x:FieldModifier="public">
        <tv:TabbedView.HeaderRightContent>
            <HorizontalStackLayout>
                <Picker x:Name="OrderOptionPicker" WidthRequest="120" Margin="0,-5,-5,0" SelectedIndex="{Binding OrderOption}">
                    <Picker.Items>
                        <l:Localized Key="AssetPage_OrderBy_AddDate"/>
                        <l:Localized Key="AssetPage_OrderBy_Name"/>
                    </Picker.Items>
                </Picker>
                <Entry Placeholder="{l:Localized Key=AssetPage_Search}" 
                   Text="{Binding SearchText}"
                   PlaceholderColor="White" 
                   BackgroundColor="Gray" 
                   WidthRequest="250" 
                   Margin="0,-5,-5,0"
                   ClearButtonVisibility="WhileEditing" />
            </HorizontalStackLayout>
        </tv:TabbedView.HeaderRightContent>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_LocalAssets}" Tag="LocalAssets">
            <CollectionView ItemsSource="{Binding FilteredLocalAssets}"
                            SelectionMode="None"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <Border StrokeThickness="1" 
                                Stroke="Gray"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" 
                                HeightRequest="160" 
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto,Auto">
                                <!-- 缩略图 -->
                                <Image Grid.Row="0"
                                       Source="{Binding ThumbPath}" 
                                       Aspect="AspectFit" 
                                       Margin="4"
                                       IsVisible="{Binding HasThumbnail}"/>
                                
                                <!-- 名称 -->
                                <Grid Grid.Row="1" 
                                      Background="{Binding BackgroundBrush}" 
                                      ColumnDefinitions="*,Auto" 
                                      Padding="6,4">
                                    <Label Text="{Binding Name}" 
                                           ToolTipProperties.Text="{Binding Name}"
                                           HorizontalOptions="Start"
                                           LineBreakMode="TailTruncation" 
                                           FontSize="12" 
                                           MaxLines="1"
                                           Grid.Column="0"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding DurationDisplay}" 
                                           ToolTipProperties.Text="{Binding DurationDisplay}"
                                           HorizontalOptions="End"
                                           LineBreakMode="TailTruncation" 
                                           FontSize="12" 
                                           MaxLines="1"
                                           Grid.Column="1"
                                           VerticalOptions="Center"/>
                                </Grid>
                                
                                <!-- 添加按钮 -->
                                <Grid Grid.Row="2" 
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                      Padding="4">
                                    <Button Text="➕" 
                                            FontSize="16"
                                            Padding="4"
                                            CornerRadius="4"
                                            BackgroundColor="Green"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddAssetClipCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No assets available" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_SharedAssets}" Tag="SharedAssets">
            <CollectionView ItemsSource="{Binding FilteredSharedAssets}"
                            SelectionMode="None"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <Border StrokeThickness="1" 
                                Stroke="Gray"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" 
                                HeightRequest="160" 
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto,Auto">
                                <!-- 缩略图 -->
                                <Image Grid.Row="0"
                                       Source="{Binding ThumbPath}" 
                                       Aspect="AspectFit" 
                                       Margin="4"
                                       IsVisible="{Binding HasThumbnail}"/>
                                
                                <!-- 名称 -->
                                <Grid Grid.Row="1" 
                                      Background="{Binding BackgroundBrush}" 
                                      ColumnDefinitions="*,Auto" 
                                      Padding="6,4">
                                    <Label Text="{Binding Name}" 
                                           ToolTipProperties.Text="{Binding Name}"
                                           HorizontalOptions="Start"
                                           LineBreakMode="TailTruncation" 
                                           FontSize="12" 
                                           MaxLines="1"
                                           Grid.Column="0"
                                           VerticalOptions="Center"/>
                                    <Label Text="{Binding DurationDisplay}" 
                                           ToolTipProperties.Text="{Binding DurationDisplay}"
                                           HorizontalOptions="End"
                                           LineBreakMode="TailTruncation" 
                                           FontSize="12" 
                                           MaxLines="1"
                                           Grid.Column="1"
                                           VerticalOptions="Center"/>
                                </Grid>
                                
                                <!-- 添加按钮 -->
                                <Grid Grid.Row="2" 
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                      Padding="4">
                                    <Button Text="➕" 
                                            FontSize="16"
                                            Padding="4"
                                            CornerRadius="4"
                                            BackgroundColor="Green"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddAssetClipCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No assets available" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddTransform}" Tag="Transform">
            <Grid RowDefinitions="Auto,*">
                <!-- 提示：需先选中片段 -->
                <Border Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1A3A5C}"
                        Padding="12,8"
                        Margin="8,8,8,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                    <Label Text="Select a clip on the timeline first, then tap ➕ to insert a transition between it and its neighbor."
                           FontSize="12"
                           TextColor="{AppThemeBinding Light=#1A5276, Dark=#85C1E9}"/>
                </Border>

                <!-- 转场列表 -->
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding AvailableTransforms}"
                                SelectionMode="None"
                                Margin="8">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TransformItemViewModel">
                            <Border StrokeThickness="1"
                                    Stroke="Gray"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}"
                                    HeightRequest="110"
                                    StrokeShape="RoundRectangle 8">
                                <Grid RowDefinitions="*,Auto">
                                    <!-- 图标 -->
                                    <Label Grid.Row="0"
                                           Text="🎬"
                                           FontSize="36"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>

                                    <!-- 底部：名称 + 添加按钮 -->
                                    <Grid Grid.Row="1"
                                          BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                          Padding="4"
                                          ColumnDefinitions="*,Auto">
                                        <Label Grid.Column="0"
                                               Text="{Binding DisplayName}"
                                               FontSize="12"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation"
                                               MaxLines="1"
                                               Padding="4,0"/>
                                        <Button Grid.Column="1"
                                                Text="➕"
                                                FontSize="14"
                                                Padding="4"
                                                WidthRequest="40"
                                                HeightRequest="36"
                                                CornerRadius="4"
                                                BackgroundColor="SteelBlue"
                                                Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddTransformClipCommand}"
                                                CommandParameter="{Binding .}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="No transforms available"
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddText}" Tag="Text">
            <Button Text="Add text" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddTextClipCommand}"/>
        </tv:TabbedViewItem>

        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddPicture}" Tag="Picture">
            <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"/>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddSketch}" Tag="Sketch">
            <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"/>
        </tv:TabbedViewItem>

        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddMore}" Tag="More">
            <ScrollView Orientation="Horizontal">
                <VerticalStackLayout Spacing="10" Padding="10">


                    <!-- 创建文本片段 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="📝" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="MediumPurple"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create a text clip" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>


                    </HorizontalStackLayout>

                    <!-- 创建纯色片段 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="🎨" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="Blue"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create a solid color clip" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddSolidColorClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 创建字幕 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="💬" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="Yellow"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create some subtitle" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddSubTitleClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 从其他源添加 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="🔗" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="MediumPurple"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Add from another source" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddAlternativeSourceClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 底部占位 -->
                    <BoxView WidthRequest="50" 
                 HeightRequest="250" 
                 Color="Transparent"/>

                </VerticalStackLayout>
            </ScrollView>
        </tv:TabbedViewItem>
    </tv:TabbedView>


</ContentView>
