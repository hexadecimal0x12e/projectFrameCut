<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.DraftStuff.ProjectAddClipView"
             xmlns:viewmodels="clr-namespace:projectFrameCut.ViewModels"
             xmlns:cont="clr-namespace:projectFrameCut.Controls"
             xmlns:l="clr-namespace:LocalizedResources"
             x:DataType="viewmodels:ProjectAddClipViewModel">

    <cont:TabbedView>
        <cont:TabbedView.HeaderRightContent>
            <HorizontalStackLayout>
                <Picker x:Name="OrderOptionPicker" WidthRequest="120" Margin="0,-5,-5,0" SelectedIndex="{Binding OrderOption}">
                    <Picker.Items>
                        <l:Localized Key="AssetPage_OrderBy_AddDate"/>
                        <l:Localized Key="AssetPage_OrderBy_Name"/>
                    </Picker.Items>
                </Picker>
                <Entry Placeholder="{l:Localized Key=AssetPage_Search}" 
                   Text="{Binding SearchText}"
                   PlaceholderColor="White" 
                   BackgroundColor="Gray" 
                   WidthRequest="250" 
                   Margin="0,-5,-5,0"
                   ClearButtonVisibility="WhileEditing" />
            </HorizontalStackLayout>
        </cont:TabbedView.HeaderRightContent>
        <cont:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_LocalAssets}">
            <CollectionView ItemsSource="{Binding FilteredLocalAssets}"
                            SelectionMode="None"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <Border StrokeThickness="1" 
                                Stroke="Gray"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" 
                                HeightRequest="160" 
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto,Auto">
                                <!-- 缩略图 -->
                                <Image Grid.Row="0"
                                       Source="{Binding ThumbPath}" 
                                       Aspect="AspectFit" 
                                       Margin="4"
                                       IsVisible="{Binding HasThumbnail}"/>
                                
                                <!-- 名称 -->
                                <Grid Grid.Row="1" 
                                      Background="{Binding BackgroundBrush}" 
                                      Padding="6,4">
                                    <Label Text="{Binding Name}" 
                                           LineBreakMode="TailTruncation" 
                                           FontSize="12" 
                                           MaxLines="1"
                                           VerticalOptions="Center"/>
                                </Grid>
                                
                                <!-- 添加按钮 -->
                                <Grid Grid.Row="2" 
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                      Padding="4">
                                    <Button Text="➕" 
                                            FontSize="16"
                                            Padding="4"
                                            CornerRadius="4"
                                            BackgroundColor="Green"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddAssetClipCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No assets available" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </cont:TabbedViewItem>
        <cont:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_SharedAssets}">
            <CollectionView ItemsSource="{Binding FilteredSharedAssets}"
                            SelectionMode="None"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <Border StrokeThickness="1" 
                                Stroke="Gray"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" 
                                HeightRequest="160" 
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto,Auto">
                                <!-- 缩略图 -->
                                <Image Grid.Row="0"
                                       Source="{Binding ThumbPath}" 
                                       Aspect="AspectFit" 
                                       Margin="4"
                                       IsVisible="{Binding HasThumbnail}"/>
                                
                                <!-- 名称 -->
                                <Grid Grid.Row="1" 
                                      Background="{Binding BackgroundBrush}" 
                                      Padding="6,4">
                                    <Label Text="{Binding Name}" 
                                           LineBreakMode="TailTruncation" 
                                           FontSize="12" 
                                           MaxLines="1"
                                           VerticalOptions="Center"/>
                                </Grid>
                                
                                <!-- 添加按钮 -->
                                <Grid Grid.Row="2" 
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                      Padding="4">
                                    <Button Text="➕" 
                                            FontSize="16"
                                            Padding="4"
                                            CornerRadius="4"
                                            BackgroundColor="Green"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddAssetClipCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No assets available" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </cont:TabbedViewItem>

        <cont:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_ReuseableAssets}">
            <CollectionView ItemsSource="{Binding FilteredReuseableAssets}"
                            SelectionMode="None"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <Border StrokeThickness="1" 
                                Stroke="Gray"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" 
                                HeightRequest="160" 
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto,Auto,Auto">
                                <!-- 缩略图 -->
                                <Image Grid.Row="0"
                                       Source="{Binding ThumbPath}" 
                                       Aspect="AspectFit" 
                                       Margin="4"
                                       IsVisible="{Binding HasThumbnail}"/>
                                
                                <!-- 名称 -->
                                <Grid Grid.Row="1" 
                                      Background="{Binding BackgroundBrush}" 
                                      Padding="6,4">
                                    <Label Text="{Binding Name}" 
                                           LineBreakMode="TailTruncation" 
                                           FontSize="12" 
                                           MaxLines="1"
                                           VerticalOptions="Center"/>
                                </Grid>
                                
                                <!-- 服务器信息（仅远程资源显示） -->
                                <Grid Grid.Row="2" 
                                      BackgroundColor="{AppThemeBinding Light=#E8E8E8, Dark=#404040}" 
                                      Padding="4,2"
                                      IsVisible="{Binding IsRemote}">
                                    <Label Text="{Binding ServerName}" 
                                           FontSize="10" 
                                           TextColor="Gray"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"
                                           VerticalOptions="Center"/>
                                </Grid>
                                
                                <!-- 添加按钮 -->
                                <Grid Grid.Row="3" 
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                      Padding="4">
                                    <Button Text="➕" 
                                            FontSize="16"
                                            Padding="4"
                                            CornerRadius="4"
                                            BackgroundColor="Green"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddReuseableAssetClipCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No reuseable assets available" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </cont:TabbedViewItem>

        <cont:TabbedViewItem Header="Other">
            <ScrollView Orientation="Horizontal">
                <VerticalStackLayout Spacing="10" Padding="10">

                    <!-- 资源库部分 -->
                    <Label Text="Assets Library" 
               FontSize="18" 
               FontAttributes="Bold"
               Margin="0,10,0,5"/>



                    <!-- 分隔线 -->
                    <BoxView HeightRequest="1" 
                 BackgroundColor="Gray" 
                 Margin="0,15,0,5"/>

                    <!-- 创建新Clip选项 -->
                    <Label Text="Create New Clip" 
               FontSize="18" 
               FontAttributes="Bold"
               Margin="0,5,0,5"/>

                    <!-- 创建文本片段 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="📝" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="MediumPurple"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create a text clip" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddTextClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 创建纯色片段 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="🎨" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="Blue"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create a solid color clip" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddSolidColorClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 创建字幕 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="💬" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="Yellow"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create some subtitle" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddSubTitleClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 从其他源添加 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="🔗" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="MediumPurple"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Add from another source" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddAlternativeSourceClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 底部占位 -->
                    <BoxView WidthRequest="50" 
                 HeightRequest="250" 
                 Color="Transparent"/>

                </VerticalStackLayout>
            </ScrollView>
        </cont:TabbedViewItem>
    </cont:TabbedView>


</ContentView>
