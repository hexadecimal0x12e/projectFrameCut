<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.DraftStuff.ProjectAddClipView"
             xmlns:viewmodels="clr-namespace:projectFrameCut.ViewModels"
             x:DataType="viewmodels:ProjectAddClipViewModel">
    
    <ScrollView Orientation="Horizontal">
        <VerticalStackLayout Spacing="10" Padding="10">
            
            <!-- 资源库部分 -->
            <Label Text="Assets Library" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   Margin="0,10,0,5"/>
            
            <CollectionView ItemsSource="{Binding Assets}"
                            SelectionMode="None">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical" ItemSpacing="5"/>
                </CollectionView.ItemsLayout>
                
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <HorizontalStackLayout Spacing="10" Margin="0,5">
                            <!-- 缩略图 -->
                            <Border WidthRequest="120" StrokeThickness="0">
                                <Image Source="{Binding ThumbPath}"
                                       WidthRequest="120"
                                       HeightRequest="67.5"
                                       Aspect="AspectFit"
                                       IsVisible="{Binding HasThumbnail}"/>
                            </Border>
                            
                            <!-- 素材片段预览 -->
                            <Border BackgroundColor="{Binding BackgroundColor}"
                                    StrokeThickness="1"
                                    Stroke="Gray"
                                    Padding="10,5"
                                    WidthRequest="200"
                                    HeightRequest="60"
                                    StrokeShape="RoundRectangle 5">
                                <Label Text="{Binding Name}" 
                                       VerticalOptions="Center"
                                       LineBreakMode="TailTruncation"/>
                            </Border>
                            
                            <!-- 添加按钮 -->
                            <Button Text="➕" 
                                    BackgroundColor="Green"
                                    WidthRequest="50"
                                    HeightRequest="50"
                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddAssetClipCommand}"
                                    CommandParameter="{Binding .}"/>
                        </HorizontalStackLayout>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                
                <CollectionView.EmptyView>
                    <Label Text="No assets available" 
                           FontSize="14"
                           Margin="10"/>
                </CollectionView.EmptyView>
            </CollectionView>
            
            <!-- 分隔线 -->
            <BoxView HeightRequest="1" 
                     BackgroundColor="Gray" 
                     Margin="0,15,0,5"/>
            
            <!-- 创建新Clip选项 -->
            <Label Text="Create New Clip" 
                   FontSize="18" 
                   FontAttributes="Bold"
                   Margin="0,5,0,5"/>
            
            <!-- 创建文本片段 -->
            <HorizontalStackLayout Spacing="10" Margin="0,5">
                <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                    <Label Text="📝" 
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <Border BackgroundColor="MediumPurple"
                        StrokeThickness="1"
                        Stroke="Gray"
                        Padding="10,5"
                        WidthRequest="200"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 5">
                    <Label Text="Create a text clip" 
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"/>
                </Border>
                
                <Button Text="➕" 
                        BackgroundColor="Green"
                        WidthRequest="50"
                        HeightRequest="50"
                        Command="{Binding AddTextClipCommand}"/>
            </HorizontalStackLayout>
            
            <!-- 创建纯色片段 -->
            <HorizontalStackLayout Spacing="10" Margin="0,5">
                <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                    <Label Text="🎨" 
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <Border BackgroundColor="Blue"
                        StrokeThickness="1"
                        Stroke="Gray"
                        Padding="10,5"
                        WidthRequest="200"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 5">
                    <Label Text="Create a solid color clip" 
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"/>
                </Border>
                
                <Button Text="➕" 
                        BackgroundColor="Green"
                        WidthRequest="50"
                        HeightRequest="50"
                        Command="{Binding AddSolidColorClipCommand}"/>
            </HorizontalStackLayout>
            
            <!-- 创建字幕 -->
            <HorizontalStackLayout Spacing="10" Margin="0,5">
                <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                    <Label Text="💬" 
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <Border BackgroundColor="Yellow"
                        StrokeThickness="1"
                        Stroke="Gray"
                        Padding="10,5"
                        WidthRequest="200"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 5">
                    <Label Text="Create some subtitle" 
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"/>
                </Border>
                
                <Button Text="➕" 
                        BackgroundColor="Green"
                        WidthRequest="50"
                        HeightRequest="50"
                        Command="{Binding AddSubTitleClipCommand}"/>
            </HorizontalStackLayout>
            
            <!-- 从其他源添加 -->
            <HorizontalStackLayout Spacing="10" Margin="0,5">
                <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                    <Label Text="🔗" 
                           FontSize="40"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"/>
                </Border>
                
                <Border BackgroundColor="MediumPurple"
                        StrokeThickness="1"
                        Stroke="Gray"
                        Padding="10,5"
                        WidthRequest="200"
                        HeightRequest="60"
                        StrokeShape="RoundRectangle 5">
                    <Label Text="Add from another source" 
                           VerticalOptions="Center"
                           LineBreakMode="TailTruncation"/>
                </Border>
                
                <Button Text="➕" 
                        BackgroundColor="Green"
                        WidthRequest="50"
                        HeightRequest="50"
                        Command="{Binding AddAlternativeSourceClipCommand}"/>
            </HorizontalStackLayout>
            
            <!-- 底部占位 -->
            <BoxView WidthRequest="50" 
                     HeightRequest="250" 
                     Color="Transparent"/>
            
        </VerticalStackLayout>
    </ScrollView>
</ContentView>
