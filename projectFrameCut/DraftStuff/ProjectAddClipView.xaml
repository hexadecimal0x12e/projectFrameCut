<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.DraftStuff.ProjectAddClipView"
             xmlns:viewmodels="clr-namespace:projectFrameCut.ViewModels"
             xmlns:tv="clr-namespace:projectFrameCut.ApplicationAPIBase.Views.TabbedView;assembly=projectFrameCut.ApplicationAPIBase"
             xmlns:basePickers="clr-namespace:projectFrameCut.ApplicationAPIBase.Views.Pickers;assembly=projectFrameCut.ApplicationAPIBase"
             xmlns:l="clr-namespace:LocalizedResources"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:projectFrameCut.Converters"
             MinimumWidthRequest="300"
             MinimumHeightRequest="220"
             Padding="4"
             x:DataType="viewmodels:ProjectAddClipViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AvaliableColorBrush">Green</SolidColorBrush>
            <SolidColorBrush x:Key="NotAvaliableColorBrush">Gray</SolidColorBrush>

            <toolkit:BoolToObjectConverter x:Key="IsValidConverter"
                TrueObject="{StaticResource AvaliableColorBrush}"
                FalseObject="{StaticResource NotAvaliableColorBrush}"/>
            <converters:StringNullOrWhitespaceObjectSelectionConventor x:Key="IsStringValidConverter"
                OnNullOrWhitespaceOrEmpty="{StaticResource NotAvaliableColorBrush}"
                OnNormal="{StaticResource AvaliableColorBrush}"/>
            <converters:IntToIndexConverter x:Key="IntToIndexConverter"/>
            <converters:EqualConverter x:Key="EqualConverter" ComparisonValue="Video"/>
            <converters:EqualConverter x:Key="OnlyAddCardConverter" ComparisonValue="1"/>
            <DataTemplate x:Key="AssetCardTemplate" x:DataType="viewmodels:AssetItemViewModel">
                <Border StrokeThickness="1"
                    Stroke="{Binding BackgroundBrush}"
                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}"
                    HeightRequest="160"
                    WidthRequest="180"
                    StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="*,Auto">
                        <!-- 缩略图 -->
                        <Image Grid.Row="0"
                           Source="{Binding ThumbPath}"
                           Aspect="AspectFit"
                           Margin="4"
                           ToolTipProperties.Text="{Binding Name}"
                           IsVisible="{Binding HasThumbnail}"/>


                        <!-- 添加按钮 -->
                        <Grid Grid.Row="1"
                          BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                          ColumnDefinitions="*,50"
                          Padding="4">
                            <Grid HorizontalOptions="Start" Padding="4" Grid.Column="0">
                                <Label Text="{Binding Name}"
                                   ToolTipProperties.Text="{Binding Name}"
                                   Margin="2,-4,0,0"
                                   LineBreakMode="TailTruncation"
                                   FontSize="12"
                                   MaxLines="1"
                                   Grid.Column="0"
                                   VerticalOptions="Start"/>
                                <Label Text="{Binding DurationDisplay}"
                                   ToolTipProperties.Text="{Binding DurationDisplay}"
                                   LineBreakMode="TailTruncation"
                                   FontSize="12"
                                   MaxLines="1"
                                   Grid.Column="1"
                                   VerticalOptions="End"/>
                            </Grid>
                            <Button Text="➕"
                                HorizontalOptions="End"
                                FontSize="16"
                                CornerRadius="4"
                                Grid.Column="1"
                                ToolTipProperties.Text="{l:Localized Key=DraftPage_CenterMenuBar_AddClip}"
                                Command="{Binding AddAssetClipCommand}"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="ExternalSourceCardTemplate" x:DataType="viewmodels:RpcVideoSourceItemViewModel">
                <Border StrokeThickness="1"
                        Stroke="CornflowerBlue"
                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}"
                        HeightRequest="160"
                        WidthRequest="180"
                        StrokeShape="RoundRectangle 8">
                    <Grid RowDefinitions="*,Auto" Padding="8">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label Text="{Binding ClientName}" ToolTipProperties.Text="{Binding ClientName}" FontSize="11" Opacity="0.75" LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label Text="{Binding Status}" ToolTipProperties.Text="{Binding Status}" FontSize="11" LineBreakMode="TailTruncation" MaxLines="1"/>
                            <Label Text="{Binding SourceInfoDisplay}" FontSize="11"/>
                            <Label Text="{Binding Capabilities}" FontSize="11"/>
                        </VerticalStackLayout>
                        <Grid Grid.Row="1" ColumnDefinitions="*,44">
                            <Label Text="{Binding Duration}" FontSize="12" VerticalOptions="Center"/>
                            <Button Grid.Column="1" Text="➕" FontSize="16" Padding="4" Command="{Binding AddCommand}" IsEnabled="{Binding CanAdd}"/>
                        </Grid>
                    </Grid>
                </Border>
            </DataTemplate>
            <DataTemplate x:Key="AddSourceCardTemplate" x:DataType="viewmodels:AddSourceCardViewModel">
                <Border StrokeThickness="1"
                        Stroke="Gray"
                        BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}"
                        HeightRequest="160"
                        WidthRequest="180"
                        StrokeShape="RoundRectangle 8">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnAddAssetClicked"/>
                        <DropGestureRecognizer AllowDrop="True"
                                               DragOver="OnAddAssetDragOver"
                                               DragLeave="OnAddAssetDragLeave"
                                               Drop="OnAddAssetDrop"/>
                    </Border.GestureRecognizers>
                    <Grid RowDefinitions="*,Auto">
                        <Label Text="➕"
                               FontSize="28"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               InputTransparent="True"/>
                        <Button Grid.Row="1"
                                Text="{Binding Name}"
                                FontSize="12"
                                TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}"
                                BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}"
                                HeightRequest="44"
                                Padding="4"
                                BorderWidth="0"
                                CornerRadius="0"
                                ToolTipProperties.Text="{Binding Name}"
                                SemanticProperties.Description="{Binding Name}"
                                CommandParameter="{Binding SourceType}"
                                Clicked="OnAddAssetClicked"/>
                    </Grid>
                </Border>
            </DataTemplate>
            <converters:SourceCardTemplateSelector x:Key="SourceCardTemplateSelector"
                                                  AssetTemplate="{StaticResource AssetCardTemplate}"
                                                  ExternalSourceTemplate="{StaticResource ExternalSourceCardTemplate}"
                                                  AddTemplate="{StaticResource AddSourceCardTemplate}"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <tv:TabbedView x:Name="MainTabView" x:FieldModifier="public">
        <tv:TabbedView.HeaderRightContent>
            <HorizontalStackLayout Spacing="8" VerticalOptions="Center" Margin="0,2,0,2">
                <Grid x:Name="OrderOptionContainer">
                    <Button x:Name="OrderOptionExpandButton"
                            Text="⇅"
                            FontSize="18"
                            WidthRequest="38"
                            HeightRequest="34"
                            Padding="0"
                            CornerRadius="6"
                            ToolTipProperties.Text="{l:Localized Key=AssetPage_OrderBy_AddDate}"
                            Clicked="OnOrderOptionExpandButtonClicked"/>
                    <Picker x:Name="OrderOptionPicker"
                            IsVisible="False"
                            WidthRequest="130"
                            BackgroundColor="Transparent"
                            TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}"
                            SelectedIndex="{Binding OrderOption}"
                            SelectedIndexChanged="OnOrderOptionPickerSelectedIndexChanged">
                        <Picker.Items>
                            <l:Localized Key="AssetPage_OrderBy_AddDate"/>
                            <l:Localized Key="AssetPage_OrderBy_Name"/>
                        </Picker.Items>
                    </Picker>
                </Grid>

                <Grid x:Name="SearchContainer">
                    <Button x:Name="SearchExpandButton"
                            Text="⌕"
                            FontSize="20"
                            WidthRequest="38"
                            HeightRequest="34"
                            Padding="0"
                            CornerRadius="6"
                            ToolTipProperties.Text="{l:Localized Key=DraftPage_AddClipView_Search}"
                            Clicked="OnSearchExpandButtonClicked"/>
                    <SearchBar Placeholder="{l:Localized Key=DraftPage_AddClipView_Search}"
                               x:Name="SearchInputEntry"
                               IsVisible="False"
                               Text="{Binding SearchText}"
                               PlaceholderColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}"
                               TextColor="{AppThemeBinding Light=#111827, Dark=#F3F4F6}"
                               BackgroundColor="Transparent"
                               WidthRequest="220"
                               SearchButtonPressed="OnSearchInputSearchButtonPressed" />
                </Grid>
            </HorizontalStackLayout>
        </tv:TabbedView.HeaderRightContent>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_LocalAssets}" Tag="LocalAssets" x:Name="LocalAssetsTab" x:FieldModifier="public">
            <CollectionView x:Name="LocalAssetsCollectionView"
                            ItemsSource="{Binding FilteredLocalAssets}"
                            ItemTemplate="{StaticResource SourceCardTemplateSelector}"
                            SelectionMode="None"
                            Margin="8"
                            SizeChanged="OnCollectionViewSizeChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                <CollectionView.Header>
                        <Label Text="{l:Localized Key=AssetPage_SearchNoResult}"
                           IsVisible="{Binding FilteredLocalAssets.Count, Converter={StaticResource OnlyAddCardConverter}}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.Header>
            </CollectionView>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_SharedAssets}" Tag="SharedAssets" x:Name="SharedAssetsTab" x:FieldModifier="public">
            <CollectionView x:Name="SharedAssetsCollectionView"
                            ItemsSource="{Binding FilteredSharedAssets}"
                            ItemTemplate="{StaticResource SourceCardTemplateSelector}"
                            SelectionMode="None"
                            Margin="8"
                            SizeChanged="OnCollectionViewSizeChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                <CollectionView.Header>
                        <Label Text="{l:Localized Key=AssetPage_SearchNoResult}"
                           IsVisible="{Binding FilteredSharedAssets.Count, Converter={StaticResource OnlyAddCardConverter}}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.Header>
            </CollectionView>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_RpcSources}" Tag="RpcSources" x:Name="RpcSourcesTab" x:FieldModifier="public">
            <Grid RowDefinitions="Auto,*" Margin="8">
                <Button Grid.Row="0"
                        Text="↻"
                        FontSize="18"
                        WidthRequest="40"
                        HeightRequest="34"
                        HorizontalOptions="End"
                        Command="{Binding RefreshRpcVideoSourcesCommand}"/>
                <CollectionView Grid.Row="1"
                                ItemsSource="{Binding FilteredRpcVideoSources}"
                                ItemTemplate="{StaticResource SourceCardTemplateSelector}"
                                SelectionMode="None"
                                SizeChanged="OnCollectionViewSizeChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>
                    <CollectionView.Header>
                        <Label Text="{l:Localized Key=DraftPage_AssetPanel_RpcSources_None}"
                               IsVisible="{Binding FilteredRpcVideoSources.Count, Converter={StaticResource OnlyAddCardConverter}}"
                               HorizontalOptions="Center" VerticalOptions="Center" Margin="20"/>
                    </CollectionView.Header>
                </CollectionView>
            </Grid>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_Templates}" Tag="Templates" x:Name="TemplatesTab" x:FieldModifier="public">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                         IsEnabled="{Binding IsGeneratingAITransition, Converter={toolkit:InvertedBoolConverter}}"
                         BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1A3A5C}"
                         Padding="12,0"
                         Margin="8,8,8,-4"
                         StrokeThickness="0"
                         StrokeShape="RoundRectangle 6">
                    <HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" VerticalOptions="Center" HorizontalOptions="Start">
                            <CheckBox IsChecked="{Binding NotAddTemplateAsGroup}" VerticalOptions="Center"/>
                            <Label Text="{l:Localized Key=DraftPage_AssetPanel_Templates_NotAsGroup}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                        <HorizontalStackLayout Grid.Row="0" VerticalOptions="Center" Margin="8,0,0,0">
                            <CheckBox IsChecked="{Binding ShowAllTemplates}" VerticalOptions="Center"/>
                            <Label Text="{l:Localized Key=DraftPage_AssetPanel_Templates_ShowAll}" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </HorizontalStackLayout>
                </Border>
                <CollectionView x:Name="TemplateCollectionView"
                            Grid.Row="1"
                            ItemsSource="{Binding FilteredAvailableTemplates}"
                            SelectionMode="None"
                            Margin="8"
                            SizeChanged="OnCollectionViewSizeChanged">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TemplateItemViewModel">
                            <Border StrokeThickness="1"
                                Stroke="{AppThemeBinding Light=#C7D2FE, Dark=#374151}"
                                BackgroundColor="{AppThemeBinding Light=#EEF2FF, Dark=#111827}"
                                HeightRequest="160"
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                                <Grid RowDefinitions="*,Auto">
                                    <VerticalStackLayout Grid.Row="0" Padding="10" Spacing="4">
                                        <Label Text="{Binding Name}"
                                           FontSize="14"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="2" />
                                        <Label Text="{Binding Summary}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#374151, Dark=#D1D5DB}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                        <Label Text="{Binding Scope}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#9CA3AF}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                        <Label Text="{Binding TemplateType}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light=#4B5563, Dark=#9CA3AF}"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1" />
                                    </VerticalStackLayout>

                                    <Grid Grid.Row="1"
                                      BackgroundColor="{AppThemeBinding Light=#E0E7FF, Dark=#1F2937}"
                                      ColumnDefinitions="*,50"
                                      Padding="4">
                                        <Label Grid.Column="0"
                                           Text="{Binding Name}"
                                           Margin="4,0,0,0"
                                           FontSize="12"
                                           VerticalOptions="Center"
                                           LineBreakMode="TailTruncation"
                                           MaxLines="1"/>
                                        <Button Grid.Column="1"
                                            Text="➕"
                                            HorizontalOptions="End"
                                            FontSize="16"
                                            CornerRadius="4"
                                            ToolTipProperties.Text="{l:Localized Key=DraftPage_CenterMenuBar_AddClip}"
                                            Command="{Binding AddTemplateCommand}"/>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="{l:Localized Key=AssetPage_SearchNoResult}"
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="AIGC" Tag="AIGeneratedContent" x:Name="AIGeneratedContentTab" x:FieldModifier="public">
            <VerticalStackLayout>
                <Editor Placeholder="{l:Localized Key=DraftPage_AddClipView_AIGC_InputPlaceholder}"
                        MinimumWidthRequest="300"
                        MinimumHeightRequest="200"
                        IsSpellCheckEnabled="True"
                        AutoSize="TextChanges"
                        FontSize="24"
                        Text="{Binding AIPrompt, Mode=TwoWay}"
                        BackgroundColor="{AppThemeBinding Dark=Black,Light=White}"
                        Margin="0,4,4,0"/>
                <HorizontalStackLayout>
                    <Label Text="{l:Localized Key=DraftPage_AddClipView_AIGC_Acknowledge1}" FontSize="12" TextColor="#f0ffffff" />
                    <Label Text="{l:Localized Key=DraftPage_AddClipView_AIGC_Acknowledge2}" FontSize="12" FontAttributes="Bold" TextColor="#ffff00"  />
                </HorizontalStackLayout>

                <Grid RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                    <Grid.Resources>
                        <converters:EqualConverter x:Key="EqualConverterImage" ComparisonValue="Image"/>
                    </Grid.Resources>
                    <HorizontalStackLayout Grid.Row="0" Spacing="20" HorizontalOptions="Start" Margin="0,0,0,8">
                        <RadioButton Content="{l:Localized Key=DraftPage_AddClipView_AIGC_Type_Video}" 
                                     GroupName="AIContentType" 
                                     Value="Video"
                                     CheckedChanged="OnAIContentTypeChanged"/>
                        <RadioButton Content="{l:Localized Key=DraftPage_AddClipView_AIGC_Type_Image}" 
                                     Margin="8,0,0,0"
                                     GroupName="AIContentType"
                                     Value="Image"
                                     IsChecked="True"
                                     CheckedChanged="OnAIContentTypeChanged"/>
                    </HorizontalStackLayout>
                    <HorizontalStackLayout Grid.Row="0" HorizontalOptions="End">
                        <ActivityIndicator IsVisible="{Binding IsGeneratingAIContent}"
                                           IsRunning="{Binding IsGeneratingAIContent}"
                                           WidthRequest="24"
                                           HeightRequest="24"
                                           Margin="0,0,8,0"/>
                        <Button HorizontalOptions="End" 
                                BackgroundColor="{Binding AIPrompt, Converter={StaticResource IsStringValidConverter}}" 
                                Text="{Binding IsGeneratingAIContent, Converter={toolkit:BoolToObjectConverter TrueObject={l:Localized Key=DraftPage_AddClipView_AIGC_Generating}, FalseObject={l:Localized Key=DraftPage_AddClipView_AIGC_Generate}}}"
                                IsEnabled="{Binding IsGeneratingAIContent, Converter={toolkit:InvertedBoolConverter}}"
                                Command="{Binding GenerateAIContentCommand}" />
                    </HorizontalStackLayout>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,8">
                        <Label Grid.Column="0" Text="{l:Localized Key=DraftPage_AddClipView_AIGC_Duration}" VerticalOptions="Center" Margin="0,0,8,0"
                               IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverter}}"/>
                        <Picker Grid.Column="1" 
                                SelectedIndex="{Binding AIVideoDuration, Converter={StaticResource IntToIndexConverter}}"
                                WidthRequest="100" 
                                Margin="0,0,20,0"
                                BackgroundColor="Gray"
                                IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverter}}">
                            <Picker.Items>
                                <x:String>3</x:String>
                                <x:String>5</x:String>
                                <x:String>10</x:String>
                                <x:String>15</x:String>
                                <x:String>20</x:String>
                            </Picker.Items>
                        </Picker>

                        <Label Grid.Column="0" Text="{l:Localized Key=DraftPage_AddClipView_AIGC_ImageStyle}" VerticalOptions="Center" Margin="0,0,8,0"
                               IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverterImage}}"/>
                        <Picker Grid.Column="1" 
                                SelectedItem="{Binding AIImageStyle, Mode=TwoWay}"
                                WidthRequest="100" 
                                Margin="0,0,20,0"
                                BackgroundColor="Gray"
                                IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverterImage}}">
                            <Picker.Items>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Natural"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Vivid"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Anime"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Photography"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_TradidtionalPainting"/>
                            </Picker.Items>
                        </Picker>

                        <Label Grid.Column="2" Text="{l:Localized Key=DraftPage_AddClipView_AIGC_Ratio}" VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Picker Grid.Column="3" 
                                SelectedItem="{Binding AIVideoRatio, Mode=TwoWay}"
                                WidthRequest="100"
                                BackgroundColor="Gray">
                            <Picker.Items>
                                <x:String>16:9</x:String>
                                <x:String>9:16</x:String>
                                <x:String>1:1</x:String>
                                <x:String>4:3</x:String>
                                <x:String>3:4</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                </Grid>


            </VerticalStackLayout>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_Graphics}" Tag="Graphics" x:Name="GraphicsTab" x:FieldModifier="public">
            <CollectionView ItemsSource="{Binding FilteredVectorComponents}"
                            SelectionMode="None" Margin="8" SizeChanged="OnCollectionViewSizeChanged">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:VectorComponentItemViewModel">
                        <Border StrokeThickness="1" Stroke="CornflowerBlue"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}"
                                HeightRequest="160" WidthRequest="180" StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto">
                                <VerticalStackLayout Padding="8" Spacing="4" VerticalOptions="Center">
                                    <Label Text="{Binding Icon}" FontFamily="Icons" FontSize="40" HorizontalOptions="Center"/>
                                    <Label Text="{Binding Description}" FontSize="11" MaxLines="2" LineBreakMode="TailTruncation" HorizontalTextAlignment="Center"/>
                                </VerticalStackLayout>
                                <Grid Grid.Row="1" ColumnDefinitions="*,50" Padding="4"
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}">
                                    <Label Text="{Binding Name}" ToolTipProperties.Text="{Binding Name}"
                                           FontSize="12" MaxLines="1" LineBreakMode="TailTruncation" VerticalOptions="Center"/>
                                    <Button Grid.Column="1" Text="➕" FontSize="16" CornerRadius="4"
                                            ToolTipProperties.Text="{l:Localized Key=DraftPage_CenterMenuBar_AddClip}"
                                            Command="{Binding AddCommand}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
                <CollectionView.EmptyView>
                    <Label Text="{l:Localized Key=AssetPage_SearchNoResult}" FontSize="14"
                           HorizontalOptions="Center" VerticalOptions="Center" Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddText}" Tag="Text" x:Name="AddTextTab" x:FieldModifier="public">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Padding="8" VerticalOptions="Center">
                    <Editor Placeholder="{l:Localized Key=DraftPage_AddClipView_AddText_InputPlaceholder}"
                            MinimumWidthRequest="300"
                            MinimumHeightRequest="200"
                            IsSpellCheckEnabled="True"
                            AutoSize="TextChanges"
                            FontSize="24"
                            Text="{Binding TextToAdd, Mode=TwoWay}"
                            BackgroundColor="{AppThemeBinding Dark=Black,Light=White}"
                            Margin="0,0,4,0"/>
                </Grid>
                <Border Grid.Row="1"
                        BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1A3A5C}"
                        Padding="12,8"
                        Margin="8,8,8,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{l:Localized Key=DraftPage_AddClipView_AddText_SelectStyle}"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light=#1A5276, Dark=#85C1E9}"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />
                        <HorizontalStackLayout HorizontalOptions="End">
                            <Button x:Name="ApplyTextToAllButton"
                                    Text="{Binding TextToAdd, Converter = 
                                            {converters:StringNullOrWhitespaceSelectionConventor 
                                                NormalText={l:Localized Key=DraftPage_AddClipView_AddText_PreviewInput}, 
                                                NullOrWhitespaceOrEmptyText={l:Localized Key=DraftPage_AddClipView_AddText_ResetInput}}}"              
                                    Command="{Binding GenerateTextPreviewCommand}"
                                    HorizontalOptions="End"
                                    VerticalOptions="Center"
                                    Margin="8,0,0,0"
                                    WidthRequest="120"
                                    HeightRequest="34" />
                            <CheckBox IsChecked="{Binding TextClipInSubTrack, Mode=TwoWay}" VerticalOptions="Center" Margin="8,0,0,0" />
                            <Label Text="{l:Localized Key=DraftPage_AddClipView_AddText_ShouldInSubtrack}" VerticalOptions="Center" Margin="-4,0,8,0" />
                        </HorizontalStackLayout>

                    </Grid>
                </Border>

                <tv:CompactTabView Grid.Row="2" Margin="8,4,8,8">
                    <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddText_PluginStyle}" Tag="ProviderStyles">
                        <CollectionView x:Name="TextStyleProviderCollectionView"
                                        ItemsSource="{Binding FilteredAvailableTextStyleProviders}"
                                        SelectionMode="None"
                                        SizeChanged="OnCollectionViewSizeChanged">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="8" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:TextStyleProviderItemViewModel">
                                    <Border StrokeThickness="1"
                                            Stroke="Gray"
                                            ToolTipProperties.Text="{Binding Name}"
                                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}"
                                            HeightRequest="120"
                                            WidthRequest="180"
                                            StrokeShape="RoundRectangle 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                    NumberOfTapsRequired="2"
                                                    Command="{Binding AddTextClipWithStyleProviderCommand}"/>
                                        </Border.GestureRecognizers>
                                        <Grid Padding="8">
                                            <Image Source="{Binding PreviewSource}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <Label Text="{l:Localized Key=AssetPage_SearchNoResult}" 
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Margin="20"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </tv:TabbedViewItem>

                    <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddText_UserStyle}" Tag="LegacyStyles">
                        <CollectionView x:Name="TextStyleCollectionView"
                                        ItemsSource="{Binding FilteredAvailableTextStyles}"
                                        SelectionMode="None"
                                        SizeChanged="OnCollectionViewSizeChanged">
                            <CollectionView.ItemsLayout>
                                <GridItemsLayout Orientation="Vertical" Span="8" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>
                                <DataTemplate x:DataType="viewmodels:TextStyleItemViewModel">
                                    <Border StrokeThickness="1"
                                            Stroke="Gray"
                                            ToolTipProperties.Text="{Binding Name}"
                                            BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}"
                                            HeightRequest="120"
                                            WidthRequest="180"
                                            StrokeShape="RoundRectangle 8">
                                        <Border.GestureRecognizers>
                                            <TapGestureRecognizer
                                                    NumberOfTapsRequired="2"
                                                    Command="{Binding AddTextClipWithStyleCommand}"/>
                                        </Border.GestureRecognizers>
                                        <Grid Padding="8">
                                            <Image Source="{Binding PreviewSource}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>

                            <CollectionView.EmptyView>
                                <Label Text="{l:Localized Key=AssetPage_SearchNoResult}" 
                                       FontSize="14"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       Margin="20"/>
                            </CollectionView.EmptyView>
                        </CollectionView>
                    </tv:TabbedViewItem>
                </tv:CompactTabView>
            </Grid>
        </tv:TabbedViewItem>
        <!-- <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddPicture}" Tag="Picture" x:Name="AddPictureTab" x:FieldModifier="public" >
            <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"/>
        </tv:TabbedViewItem> -->
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddSketch}" Tag="Sketch" x:Name="AddSketchTab" x:FieldModifier="public">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1A3A5C}"
                        Padding="12,8"
                        Margin="8,8,8,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout>
                        <Grid>
                            <HorizontalStackLayout HorizontalOptions="Start">
                                <Button Text="{l:Localized Key=DraftPage_MenuBar_Edit_Undo}" Command="{Binding DrawingContentUndoCommand}"/>
                                <Button Text="{l:Localized Key=DraftPage_MenuBar_Edit_Redo}" Margin="8,0,0,0" Command="{Binding DrawingContentRedoCommand}"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="End">
                                <Button Text="{l:Localized Key=DraftPage_AddClipView_AddSketch_SelectColor}" HorizontalOptions="End" Command="{Binding DrawingSelectPenColorCommand}"/>
                                <Button Text="{l:Localized Key=DraftPage_CenterMenuBar_AddClip}" Margin="8,0,0,0" HorizontalOptions="End" Command="{Binding AddDrawingContentCommand}"/>
                            </HorizontalStackLayout>
                        </Grid>
                        <Label Text="{l:Localized Key=DraftPage_AddClipView_AddSketch_DrawHere}"
                               Margin="0,8,0,0"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#1A5276, Dark=#85C1E9}"/>
                    </VerticalStackLayout>
                </Border>
                <toolkit:DrawingView
                    Grid.Row="1"
                    x:Name="DrawingCanvas"
                    LineColor="{Binding DrawingPenColor}"
                    LineWidth="{Binding DrawingLineWidth}"
                    Background="White"
                    Margin="8,0,8,8"
                    IsMultiLineModeEnabled="true"
                    ShouldClearOnFinish="false" />
            </Grid>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddMore}" Tag="More" x:Name="AddMoreTab" x:FieldModifier="public">
            <ScrollView Orientation="Horizontal">
                <VerticalStackLayout Spacing="10" Padding="10">
                    <Button Text="{l:Localized Key=DraftPage_AddClipView_AddSolidColorClip}" Command="{Binding AddSolidColorClipCommand}"/>
                    <Button Text="{l:Localized Key=DraftPage_AddClipView_AddFromAlternativeSrc}" Command="{Binding AddAlternativeSourceClipCommand}"/>
                </VerticalStackLayout>
            </ScrollView>
        </tv:TabbedViewItem>
    </tv:TabbedView>


</ContentView>
