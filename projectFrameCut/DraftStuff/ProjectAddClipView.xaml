<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.DraftStuff.ProjectAddClipView"
             xmlns:viewmodels="clr-namespace:projectFrameCut.ViewModels"
             xmlns:tv="clr-namespace:projectFrameCut.ApplicationAPIBase.Views.TabbedView;assembly=projectFrameCut.ApplicationAPIBase"
             xmlns:l="clr-namespace:LocalizedResources"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:converters="clr-namespace:projectFrameCut.Converters"
             x:DataType="viewmodels:ProjectAddClipViewModel">
    <ContentView.Resources>
        <ResourceDictionary>
            <SolidColorBrush x:Key="AvaliableColorBrush">Green</SolidColorBrush>
            <SolidColorBrush x:Key="NotAvaliableColorBrush">Gray</SolidColorBrush>

            <toolkit:BoolToObjectConverter x:Key="IsValidConverter" 
                TrueObject="{StaticResource AvaliableColorBrush}" 
                FalseObject="{StaticResource NotAvaliableColorBrush}"/>
            <converters:StringNullOrWhitespaceObjectSelectionConventor x:Key="IsStringValidConverter"
                OnNullOrWhitespaceOrEmpty="{StaticResource NotAvaliableColorBrush}"
                OnNormal="{StaticResource AvaliableColorBrush}"/>
            <converters:IntToIndexConverter x:Key="IntToIndexConverter"/>
            <converters:EqualConverter x:Key="EqualConverter" ComparisonValue="Video"/>
        </ResourceDictionary>
    </ContentView.Resources>

    <tv:TabbedView x:Name="MainTabView" x:FieldModifier="public">
        <tv:TabbedView.HeaderRightContent>
            <HorizontalStackLayout>
                <Picker x:Name="OrderOptionPicker" WidthRequest="120" Margin="0,-6,5,0" BackgroundColor="Gray"  SelectedIndex="{Binding OrderOption}">
                    <Picker.Items>
                        <l:Localized Key="AssetPage_OrderBy_AddDate"/>
                        <l:Localized Key="AssetPage_OrderBy_Name"/>
                    </Picker.Items>
                </Picker>
                <Entry Placeholder="{l:Localized Key=DraftPage_AddClipView_Search}" 
                       x:Name="SearchInputEntry"
                       Text="{Binding SearchText}"
                       PlaceholderColor="White" 
                       BackgroundColor="Gray" 
                       WidthRequest="250" 
                       Margin="0,-7,-5,0"
                       ClearButtonVisibility="WhileEditing" />
            </HorizontalStackLayout>
        </tv:TabbedView.HeaderRightContent>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_LocalAssets}" Tag="LocalAssets" x:Name="LocalAssetsTab" x:FieldModifier="public">
            <CollectionView ItemsSource="{Binding FilteredLocalAssets}"
                            SelectionMode="None"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <Border StrokeThickness="1" 
                                Stroke="{Binding BackgroundBrush}"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}" 
                                HeightRequest="160" 
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto">
                                <!-- 缩略图 -->
                                <Image Grid.Row="0"
                                       Source="{Binding ThumbPath}" 
                                       Aspect="AspectFit" 
                                       Margin="4"
                                       ToolTipProperties.Text="{Binding Name}"
                                       IsVisible="{Binding HasThumbnail}"/>


                                <!-- 添加按钮 -->
                                <Grid Grid.Row="2" 
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                      ColumnDefinitions="*,50"
                                      Padding="4">
                                    <Grid HorizontalOptions="Start" Padding="4" Grid.Column="0">
                                        <Label Text="{Binding Name}" 
                                               ToolTipProperties.Text="{Binding Name}"
                                               Margin="2,0,0,0"
                                               LineBreakMode="TailTruncation" 
                                               FontSize="12" 
                                               MaxLines="1"
                                               Grid.Column="0"
                                               VerticalOptions="Start"/>
                                        <Label Text="{Binding DurationDisplay}" 
                                               ToolTipProperties.Text="{Binding DurationDisplay}"
                                               LineBreakMode="TailTruncation" 
                                               FontSize="12" 
                                               MaxLines="1"
                                               Grid.Column="1"
                                               VerticalOptions="End"/>
                                    </Grid>
                                    <Button Text="➕" 
                                            HorizontalOptions="End"
                                            FontSize="16"
                                            CornerRadius="4"
                                            Grid.Column="1"
                                            ToolTipProperties.Text="{l:Localized Key=DraftPage_CenterMenuBar_AddClip}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddAssetClipCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No assets available" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_SharedAssets}" Tag="SharedAssets" x:Name="SharedAssetsTab" x:FieldModifier="public">
            <CollectionView ItemsSource="{Binding FilteredSharedAssets}"
                            SelectionMode="None"
                            Margin="8">
                <CollectionView.ItemsLayout>
                    <GridItemsLayout Orientation="Vertical" Span="4" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="viewmodels:AssetItemViewModel">
                        <Border StrokeThickness="1" 
                                Stroke="{Binding BackgroundBrush}"
                                BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}" 
                                HeightRequest="160" 
                                WidthRequest="180"
                                StrokeShape="RoundRectangle 8">
                            <Grid RowDefinitions="*,Auto">
                                <!-- 缩略图 -->
                                <Image Grid.Row="0"
                                       Source="{Binding ThumbPath}" 
                                       Aspect="AspectFit" 
                                       Margin="4"
                                       ToolTipProperties.Text="{Binding Name}"
                                       IsVisible="{Binding HasThumbnail}"/>


                                <!-- 添加按钮 -->
                                <Grid Grid.Row="2" 
                                      BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                      ColumnDefinitions="*,50"
                                      Padding="4">
                                    <Grid HorizontalOptions="Start" Padding="4" Grid.Column="0">
                                        <Label Text="{Binding Name}" 
                                               ToolTipProperties.Text="{Binding Name}"
                                               Margin="2,0,0,0"
                                               LineBreakMode="TailTruncation" 
                                               FontSize="12" 
                                               MaxLines="1"
                                               Grid.Column="0"
                                               VerticalOptions="Start"/>
                                        <Label Text="{Binding DurationDisplay}" 
                                               ToolTipProperties.Text="{Binding DurationDisplay}"
                                               LineBreakMode="TailTruncation" 
                                               FontSize="12" 
                                               MaxLines="1"
                                               Grid.Column="1"
                                               VerticalOptions="End"/>
                                    </Grid>
                                    <Button Text="➕" 
                                            HorizontalOptions="End"
                                            FontSize="16"
                                            CornerRadius="4"
                                            Grid.Column="1"
                                            ToolTipProperties.Text="{l:Localized Key=DraftPage_CenterMenuBar_AddClip}"
                                            Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddAssetClipCommand}"
                                            CommandParameter="{Binding .}"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.EmptyView>
                    <Label Text="No assets available" 
                           FontSize="14"
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           Margin="20"/>
                </CollectionView.EmptyView>
            </CollectionView>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="AIGC" Tag="AIGeneratedContent" x:Name="AIGeneratedContentTab" x:FieldModifier="public">
            <VerticalStackLayout>
                <Editor Placeholder="{l:Localized Key=DraftPage_AddClipView_AIGC_InputPlaceholder}"
                        MinimumWidthRequest="300"
                        MinimumHeightRequest="200"
                        IsSpellCheckEnabled="True"
                        AutoSize="TextChanges"
                        FontSize="24"
                        Text="{Binding AIPrompt, Mode=TwoWay}"
                        BackgroundColor="{AppThemeBinding Dark=Black,Light=White}"
                        Margin="0,0,4,0"/>

                <Grid RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                    <Grid.Resources>
                        <converters:EqualConverter x:Key="EqualConverterImage" ComparisonValue="Image"/>
                    </Grid.Resources>
                    <HorizontalStackLayout Grid.Row="0" Spacing="20" HorizontalOptions="Start" Margin="0,0,0,8">
                        <RadioButton Content="{l:Localized Key=DraftPage_AddClipView_AIGC_Type_Video}" 
                                     GroupName="AIContentType" 
                                     Value="Video"
                                     CheckedChanged="OnAIContentTypeChanged"/>
                        <RadioButton Content="{l:Localized Key=DraftPage_AddClipView_AIGC_Type_Image}" 
                                     Margin="8,0,0,0"
                                     GroupName="AIContentType"
                                     Value="Image"
                                     IsChecked="True"
                                     CheckedChanged="OnAIContentTypeChanged"/>
                    </HorizontalStackLayout>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto,*" Margin="0,0,0,8">
                        <Label Grid.Column="0" Text="{l:Localized Key=DraftPage_AddClipView_AIGC_Duration}" VerticalOptions="Center" Margin="0,0,8,0"
                               IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverter}}"/>
                        <Picker Grid.Column="1" 
                                SelectedIndex="{Binding AIVideoDuration, Converter={StaticResource IntToIndexConverter}}"
                                WidthRequest="100" 
                                Margin="0,0,20,0"
                                BackgroundColor="Gray"
                                IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverter}}">
                            <Picker.Items>
                                <x:String>3</x:String>
                                <x:String>5</x:String>
                                <x:String>10</x:String>
                                <x:String>15</x:String>
                                <x:String>20</x:String>
                            </Picker.Items>
                        </Picker>

                        <Label Grid.Column="0" Text="{l:Localized Key=DraftPage_AddClipView_AIGC_ImageStyle}" VerticalOptions="Center" Margin="0,0,8,0"
                               IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverterImage}}"/>
                        <Picker Grid.Column="1" 
                                SelectedItem="{Binding AIImageStyle, Mode=TwoWay}"
                                WidthRequest="100" 
                                Margin="0,0,20,0"
                                BackgroundColor="Gray"
                                IsVisible="{Binding AIContentType, Converter={StaticResource EqualConverterImage}}">
                            <Picker.Items>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Natural"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Vivid"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Anime"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_Photography"/>
                                <l:Localized Key="DraftPage_AddClipView_AIGC_ImageStyle_TradidtionalPainting"/>
                            </Picker.Items>
                        </Picker>

                        <Label Grid.Column="2" Text="{l:Localized Key=DraftPage_AddClipView_AIGC_Ratio}" VerticalOptions="Center" Margin="0,0,8,0"/>
                        <Picker Grid.Column="3" 
                                SelectedItem="{Binding AIVideoRatio, Mode=TwoWay}"
                                WidthRequest="100"
                                BackgroundColor="Gray">
                            <Picker.Items>
                                <x:String>16:9</x:String>
                                <x:String>9:16</x:String>
                                <x:String>1:1</x:String>
                                <x:String>4:3</x:String>
                                <x:String>3:4</x:String>
                            </Picker.Items>
                        </Picker>
                    </Grid>
                </Grid>

                <Grid Margin="0,8,0,0">
                    <HorizontalStackLayout HorizontalOptions="End">
                        <ActivityIndicator IsVisible="{Binding IsGeneratingAIContent}"
                                         IsRunning="{Binding IsGeneratingAIContent}"
                                         WidthRequest="24"
                                         HeightRequest="24"
                                         Margin="0,0,8,0"/>
                        <Button HorizontalOptions="End" 
                                BackgroundColor="{Binding AIPrompt, Converter={StaticResource IsStringValidConverter}}" 
                                Text="{Binding IsGeneratingAIContent, Converter={toolkit:BoolToObjectConverter TrueObject={l:Localized Key=DraftPage_AddClipView_AIGC_Generating}, FalseObject={l:Localized Key=DraftPage_AddClipView_AIGC_Generate}}}"
                                IsEnabled="{Binding IsGeneratingAIContent, Converter={toolkit:InvertedBoolConverter}}"
                                Command="{Binding GenerateAIContentCommand}" />
                    </HorizontalStackLayout>
                </Grid>
            </VerticalStackLayout>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddTransform}" Tag="Transform" x:Name="TransformTab" x:FieldModifier="public">
            <Grid RowDefinitions="Auto,Auto,*">
                <Border Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light=#FFF8E1, Dark=#3E2723}"
                        Padding="12,8"
                        Margin="8,8,8,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6"
                        IsVisible="{Binding CanGenerateAITransition}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_AITransform}"
                               FontSize="16"
                               FontAttributes="Bold"
                               TextColor="{AppThemeBinding Light=#FF6F00, Dark=#FFB74D}"/>
                        <Entry IsEnabled="True"
                               Placeholder="{l:Localized Key=DraftPage_AddClipView_AIGC_InputPlaceholder}"
                               Text="{Binding AITransitionPrompt, Mode=TwoWay}"
                               BackgroundColor="{AppThemeBinding Light=White, Dark=#424242}"
                               PlaceholderColor="{AppThemeBinding Light=#757575, Dark=#BDBDBD}"
                               FontSize="14"/>

                        <Grid ColumnDefinitions="*,Auto" IsEnabled="{Binding IsGeneratingAITransition, Converter={toolkit:InvertedBoolConverter}}" >
                            <HorizontalStackLayout Grid.Column="0" Spacing="8">
                                <Label Text="{l:Localized Key=DraftPage_AddClipView_AIGC_Duration}"
                                       VerticalOptions="Center"
                                       FontSize="12"/>
                                <Picker SelectedIndex="{Binding AITransitionDuration, Converter={StaticResource IntToIndexConverter}}"
                                        WidthRequest="80"
                                        BackgroundColor="Gray">
                                    <Picker.Items>
                                        <x:String>1</x:String>
                                        <x:String>2</x:String>
                                        <x:String>3</x:String>
                                        <x:String>5</x:String>
                                    </Picker.Items>
                                </Picker>
                            </HorizontalStackLayout>

                            <HorizontalStackLayout Grid.Column="1" Spacing="8">
                                <ActivityIndicator IsVisible="{Binding IsGeneratingAITransition}"
                                                 IsRunning="{Binding IsGeneratingAITransition}"
                                                 WidthRequest="20"
                                                 HeightRequest="20"/>
                                <HorizontalStackLayout HorizontalOptions="End" IsEnabled="{Binding IsDraftSelectedAnyClip}">
                                    <Button HorizontalOptions="End"
                                            Text="{Binding IsGeneratingAIContent, Converter={toolkit:BoolToObjectConverter TrueObject={l:Localized Key=DraftPage_AddClipView_AIGC_GeneratingLong}, FalseObject=➕}}"                                   
                                            ToolTipProperties.Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_AddInSelectedDirection}"
                                            FontSize="14"
                                            Padding="4"
                                            WidthRequest="40"
                                            HeightRequest="36"
                                            CornerRadius="4"
                                            IsVisible="{Binding IsSideDetermined}"
                                            Command="{Binding GenerateAITransitionCommand}"
                                            CommandParameter="auto"/>

                                    <Button HorizontalOptions="End"
                                            Text="{Binding IsGeneratingAIContent, Converter={toolkit:BoolToObjectConverter TrueObject={l:Localized Key=DraftPage_AddClipView_AIGC_GeneratingLong}, FalseObject=👈}}"                                                                        
                                            ToolTipProperties.Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_AddInLeft}"
                                            FontSize="14"
                                            Padding="4"
                                            WidthRequest="40"
                                            HeightRequest="36"
                                            CornerRadius="4"
                                            IsVisible="{Binding IsSideDetermined, Converter={toolkit:InvertedBoolConverter}}"
                                            IsEnabled="{Binding IsApplicableToLeft}"
                                            Background="{Binding IsApplicableToLeft, Converter={StaticResource IsValidConverter}}"
                                            Command="{Binding GenerateAITransitionCommand}"
                                            CommandParameter="left"/>

                                    <Button HorizontalOptions="End"
                                            Text="{Binding IsGeneratingAIContent, Converter={toolkit:BoolToObjectConverter TrueObject={l:Localized Key=DraftPage_AddClipView_AIGC_GeneratingLong}, FalseObject=👉}}"                                                                           
                                            ToolTipProperties.Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_AddInRight}"
                                            FontSize="14"
                                            Padding="4"
                                            WidthRequest="40"
                                            HeightRequest="36"
                                            CornerRadius="4"
                                            Margin="8,0,0,0"
                                            IsVisible="{Binding IsSideDetermined, Converter={toolkit:InvertedBoolConverter}}"
                                            IsEnabled="{Binding IsApplicableToRight}"
                                            Background="{Binding IsApplicableToRight, Converter={StaticResource IsValidConverter}}"
                                            Command="{Binding GenerateAITransitionCommand}"
                                            CommandParameter="right"/>
                                </HorizontalStackLayout>
                               <!-- <Button 
                                        BackgroundColor="{Binding AITransitionPrompt, Converter={StaticResource IsStringValidConverter}}"
                                        IsEnabled="{Binding IsGeneratingAITransition, Converter={toolkit:InvertedBoolConverter}}"
                                        Command="{Binding GenerateAITransitionCommand}"
                                        FontSize="12"
                                        WidthRequest="100"
                                        HeightRequest="32"/> -->
                            </HorizontalStackLayout>
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        IsEnabled="{Binding IsGeneratingAITransition, Converter={toolkit:InvertedBoolConverter}}"
                        BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1A3A5C}"
                        Padding="12,8"
                        Margin="8,8,8,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                    <Grid>
                        <Label Text="{Binding TransformAddHintText}"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#1A5276, Dark=#85C1E9}"/>
                        <Button IsVisible="{x:OnIdiom Phone=true, Default=false}"
                                IsEnabled="{Binding IsDraftSelectedAnyClip}"
                                Background="{Binding IsSideDetermined, Converter={StaticResource IsValidConverter}}"
                                Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_RenderPreview}"              
                                Command="{Binding GenerateTransformPreviewCommand}"
                                HorizontalOptions="{Binding IsDraftSelectedAnyClip, Converter={toolkit:BoolToObjectConverter FalseObject=End, TrueObject=Start}}"
                                VerticalOptions="Center"
                                Margin="8,0,0,0"
                                WidthRequest="120"
                                HeightRequest="34" />
                    </Grid>
                </Border>

                <CollectionView Grid.Row="2"
                                ItemsSource="{Binding FilteredAvailableTransforms}"
                                SelectionMode="None"
                                Margin="8">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="3" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TransformItemViewModel">
                            <Border StrokeThickness="1" 
                                    Stroke="Gray"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}" 
                                    HeightRequest="160" 
                                    WidthRequest="180"
                                    StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <PointerGestureRecognizer
                                        PointerEnteredCommand="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=GenerateTransformPreviewCommand}"
                                        PointerEnteredCommandParameter="{Binding .}"/>
                                    <TapGestureRecognizer
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=SelectTransformForPreviewCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid RowDefinitions="*,Auto,Auto">
                                    <toolkit:MediaElement Grid.Row="0"
                                           Source="{Binding PreviewVideoPath}"
                                           Aspect="AspectFit" 
                                           Margin="4"
                                           ShouldAutoPlay="True"
                                           ShouldLoopPlayback="True"
                                           ShouldMute="True"
                                           ShouldShowPlaybackControls="False"
                                           IsVisible="{Binding IsPreviewReady}"/>
                                    <ActivityIndicator Grid.Row="0"
                                           IsRunning="{Binding IsGeneratingPreview}"
                                           IsVisible="{Binding IsGeneratingPreview}"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center"/>

                                    <Grid Grid.Row="2" 
                                          BackgroundColor="{AppThemeBinding Light=#E0E0E0, Dark=#333333}" 
                                          Padding="4">
                                        <Label Text="{Binding DisplayName}" 
                                               ToolTipProperties.Text="{Binding DisplayName}"
                                               Margin="8,0,0,0"
                                               HorizontalOptions="Start"
                                               LineBreakMode="TailTruncation" 
                                               FontSize="12" 
                                               MaxLines="1"
                                               VerticalOptions="Center"/>
                                        <HorizontalStackLayout HorizontalOptions="End" IsEnabled="{Binding IsDraftSelectedAnyClip}">
                                            <Button HorizontalOptions="End"
                                                    Text="➕"
                                                    ToolTipProperties.Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_AddInSelectedDirection}"
                                                    FontSize="14"
                                                    Padding="4"
                                                    WidthRequest="40"
                                                    HeightRequest="36"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding IsSideDetermined}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddTransformClipCommand}"
                                                    CommandParameter="{Binding .}"/>

                                            <Button HorizontalOptions="End"
                                                    Text="👈"                                           
                                                    ToolTipProperties.Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_AddInLeft}"
                                                    FontSize="14"
                                                    Padding="4"
                                                    WidthRequest="40"
                                                    HeightRequest="36"
                                                    CornerRadius="4"
                                                    IsVisible="{Binding IsSideDetermined, Converter={toolkit:InvertedBoolConverter}}"
                                                    IsEnabled="{Binding IsApplicableToLeft}"
                                                    Background="{Binding IsApplicableToLeft, Converter={StaticResource IsValidConverter}}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddTransformClipInLeftCommand}"
                                                    CommandParameter="{Binding .}"/>

                                            <Button HorizontalOptions="End"
                                                    Text="👉"
                                                    ToolTipProperties.Text="{l:Localized Key=DraftPage_AddClipView_AddTransform_AddInRight}"
                                                    FontSize="14"
                                                    Padding="4"
                                                    WidthRequest="40"
                                                    HeightRequest="36"
                                                    CornerRadius="4"
                                                    Margin="8,0,0,0"
                                                    IsVisible="{Binding IsSideDetermined, Converter={toolkit:InvertedBoolConverter}}"
                                                    IsEnabled="{Binding IsApplicableToRight}"
                                                    Background="{Binding IsApplicableToRight, Converter={StaticResource IsValidConverter}}"
                                                    Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddTransformClipInRightCommand}"
                                                    CommandParameter="{Binding .}"/>
                                        </HorizontalStackLayout>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="No transforms available"
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddText}" Tag="Text" x:Name="AddTextTab" x:FieldModifier="public">
            <Grid RowDefinitions="Auto,Auto,*">
                <Grid Grid.Row="0" Padding="8" VerticalOptions="Center">
                    <Editor Placeholder="{l:Localized Key=DraftPage_AddClipView_AddText_InputPlaceholder}"
                            MinimumWidthRequest="300"
                            MinimumHeightRequest="200"
                            IsSpellCheckEnabled="True"
                            AutoSize="TextChanges"
                            FontSize="24"
                            Text="{Binding TextToAdd, Mode=TwoWay}"
                            BackgroundColor="{AppThemeBinding Dark=Black,Light=White}"
                            Margin="0,0,4,0"/>
                </Grid>
                <Border Grid.Row="1"
                        BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1A3A5C}"
                        Padding="12,8"
                        Margin="8,8,8,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                    <Grid ColumnDefinitions="*,Auto">
                        <Label Text="{l:Localized Key=DraftPage_AddClipView_AddText_SelectStyle}"
                               FontSize="18"
                               TextColor="{AppThemeBinding Light=#1A5276, Dark=#85C1E9}"
                               VerticalOptions="Center"
                               HorizontalOptions="Start" />
                        <Button x:Name="ApplyTextToAllButton"
                                Text="{Binding TextToAdd, Converter = 
                                        {converters:StringNullOrWhitespaceSelectionConventor 
                                            NormalText={l:Localized Key=DraftPage_AddClipView_AddText_PreviewInput}, 
                                            NullOrWhitespaceOrEmptyText={l:Localized Key=DraftPage_AddClipView_AddText_ResetInput}}}"              
                                Command="{Binding GenerateTextPreviewCommand}"
                                HorizontalOptions="End"
                                VerticalOptions="Center"
                                Margin="8,0,0,0"
                                WidthRequest="120"
                                HeightRequest="34" />
                    </Grid>
                </Border>
                <CollectionView Grid.Row="2"
                                ItemsSource="{Binding FilteredAvailableTextStyles}"
                                SelectionMode="Single"
                                SelectedItem="{Binding SelectedTextStyle, Mode=TwoWay}"
                                Margin="8">
                    <CollectionView.ItemsLayout>
                        <GridItemsLayout Orientation="Vertical" Span="8" VerticalItemSpacing="8" HorizontalItemSpacing="8"/>
                    </CollectionView.ItemsLayout>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:TextStyleItemViewModel">
                            <Border StrokeThickness="1"
                                    Stroke="Gray"
                                    ToolTipProperties.Text="{Binding Name}"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#1a1a1a}"
                                    HeightRequest="120"
                                    WidthRequest="180"
                                    StrokeShape="RoundRectangle 8">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer
                                        NumberOfTapsRequired="2"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type viewmodels:ProjectAddClipViewModel}}, Path=AddTextClipWithStyleCommand}"
                                        CommandParameter="{Binding .}"/>
                                </Border.GestureRecognizers>
                                <Grid Padding="8">
                                    <Image Source="{Binding PreviewSource}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                    <CollectionView.EmptyView>
                        <Label Text="No text styles available"
                               FontSize="14"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               Margin="20"/>
                    </CollectionView.EmptyView>
                </CollectionView>
            </Grid>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddPicture}" Tag="Picture" x:Name="AddPictureTab" x:FieldModifier="public">
            <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"/>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddSketch}" Tag="Sketch" x:Name="AddSketchTab" x:FieldModifier="public">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0"
                        BackgroundColor="{AppThemeBinding Light=#E8F4FD, Dark=#1A3A5C}"
                        Padding="12,8"
                        Margin="8,8,8,4"
                        StrokeThickness="0"
                        StrokeShape="RoundRectangle 6">
                    <VerticalStackLayout>
                        <Grid>
                            <HorizontalStackLayout HorizontalOptions="Start">
                                <Button Text="{l:Localized Key=DraftPage_MenuBar_Edit_Undo}" Command="{Binding DrawingContentUndoCommand}"/>
                                <Button Text="{l:Localized Key=DraftPage_MenuBar_Edit_Redo}" Margin="8,0,0,0" Command="{Binding DrawingContentRedoCommand}"/>
                            </HorizontalStackLayout>
                            <HorizontalStackLayout HorizontalOptions="End">
                                <Button Text="{l:Localized Key=DraftPage_AddClipView_AddSketch_SelectColor}" HorizontalOptions="End" Command="{Binding DrawingSelectPenColorCommand}"/>
                                <Button Text="{l:Localized Key=DraftPage_CenterMenuBar_AddClip}" Margin="8,0,0,0" HorizontalOptions="End" Command="{Binding AddDrawingContentCommand}"/>
                            </HorizontalStackLayout>
                        </Grid>
                        <Label Text="{l:Localized Key=DraftPage_AddClipView_AddSketch_DrawHere}"
                               Margin="0,8,0,0"
                               FontSize="12"
                               TextColor="{AppThemeBinding Light=#1A5276, Dark=#85C1E9}"/>
                    </VerticalStackLayout>
                </Border>
                <toolkit:DrawingView
                    Grid.Row="1"
                    x:Name="DrawingCanvas"
                    LineColor="{Binding DrawingPenColor}"
                    LineWidth="{Binding DrawingLineWidth}"
                    Background="White"
                    Margin="8,0,8,8"
                    IsMultiLineModeEnabled="true"
                    ShouldClearOnFinish="false" />
            </Grid>
        </tv:TabbedViewItem>
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AddClipView_AddMore}" Tag="More" x:Name="AddMoreTab" x:FieldModifier="public">
            <ScrollView Orientation="Horizontal">
                <VerticalStackLayout Spacing="10" Padding="10">


                    <!-- 创建文本片段 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="📝" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="MediumPurple"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create a text clip" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>


                    </HorizontalStackLayout>

                    <!-- 创建纯色片段 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="🎨" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="Blue"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create a solid color clip" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddSolidColorClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 创建字幕 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="💬" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="Yellow"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Create some subtitle" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddSubTitleClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 从其他源添加 -->
                    <HorizontalStackLayout Spacing="10" Margin="0,5">
                        <Border WidthRequest="120" HeightRequest="67.5" StrokeThickness="0">
                            <Label Text="🔗" 
                       FontSize="40"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"/>
                        </Border>

                        <Border BackgroundColor="MediumPurple"
                    StrokeThickness="1"
                    Stroke="Gray"
                    Padding="10,5"
                    WidthRequest="200"
                    HeightRequest="60"
                    StrokeShape="RoundRectangle 5">
                            <Label Text="Add from another source" 
                       VerticalOptions="Center"
                       LineBreakMode="TailTruncation"/>
                        </Border>

                        <Button Text="➕" 
                    BackgroundColor="Green"
                    WidthRequest="50"
                    HeightRequest="50"
                    Command="{Binding AddAlternativeSourceClipCommand}"/>
                    </HorizontalStackLayout>

                    <!-- 底部占位 -->
                    <BoxView WidthRequest="50" 
                 HeightRequest="250" 
                 Color="Transparent"/>

                </VerticalStackLayout>
            </ScrollView>
        </tv:TabbedViewItem>
    </tv:TabbedView>


</ContentView>
