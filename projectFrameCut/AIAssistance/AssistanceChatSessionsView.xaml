<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LocalizedResources"
             x:Class="projectFrameCut.AIAssistance.AssistanceChatSessionsView">
    <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8" Padding="8">
        <Label Grid.Row="0"
               Text="Assistant P"
               FontAttributes="Bold"
               FontSize="20"/>

        <CollectionView Grid.Row="1"
                        x:Name="SessionListView"
                        SelectionMode="Single"
                        SelectionChanged="SessionListView_SelectionChanged"
                        Margin="0,4,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Loaded="Border_Loaded"
                            StrokeThickness="1"
                            StrokeShape="RoundRectangle 8"
                            Padding="10,8"
                            Margin="0,0,0,8">
                        <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="2">
                            <Label Grid.Row="0"
                                   Text="{Binding Title}"
                                   FontSize="16"
                                   LineBreakMode="TailTruncation"/>
                            <Label Grid.Row="1"
                                   Text="{Binding Preview}"
                                   FontSize="13"
                                   LineBreakMode="TailTruncation"/>
                            <Label Grid.Row="2"
                                   Text="{Binding UpdatedAtText}"
                                   FontSize="12"
                                   Opacity="0.8"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Button Grid.Row="2"
                x:Name="NewSessionButton"
                Text="{l:Localized Key=AIAssistant_ChatView_NewSession}"
                Clicked="NewSessionButton_Clicked"/>
    </Grid>
</ContentView>
