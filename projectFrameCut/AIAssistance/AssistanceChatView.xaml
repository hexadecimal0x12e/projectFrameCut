<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ai="clr-namespace:projectFrameCut.AIAssistance"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:l="clr-namespace:LocalizedResources"
             x:Class="projectFrameCut.AIAssistance.AssistanceChatView">
    <Grid RowDefinitions="*,Auto,Auto,Auto" RowSpacing="8" Padding="8">
        <CollectionView Grid.Row="0"
                        x:Name="AIChatHistoryView"
                        SelectionMode="None"
                        Margin="0,0,0,4"
                        ItemSizingStrategy="MeasureAllItems"
                        ItemsUpdatingScrollMode="KeepLastItemInView">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="ai:ChatMessageItem">
                    <Grid Padding="2">
                        <Border StrokeThickness="1"
                                StrokeShape="RoundRectangle 10"
                                Padding="10,8"
                                Margin="2"
                                BackgroundColor="Transparent"
                                Stroke="{AppThemeBinding Light=#FFE0E0E0, Dark=#FF444444}"
                                BindingContextChanged="OnMessageBorderContextChanged">
                            <VerticalStackLayout Spacing="6">
                                <!-- Sender -->
                                <Label Text="{Binding Sender}"
                                       FontAttributes="Bold"
                                       FontSize="12"
                                       TextColor="{AppThemeBinding Light=#FF333333, Dark=#FFDDDDDD}"/>

                                <!-- ===== Assistant message: Markdown rendering ===== -->
                                <VerticalStackLayout Spacing="0"
                                                     HorizontalOptions="Fill"
                                                     BindingContextChanged="SubViewCollection_BindingContextChanged" />
                                <!-- ===== User message: plain text ===== -->
                                <Label Text="{Binding Message}"
                                       IsVisible="{Binding IsUserMessageWithText}"
                                       LineBreakMode="WordWrap"
                                       TextColor="{AppThemeBinding Light=#FF222222, Dark=#FFEEEEEE}"/>


                                <Grid>
                                    <HorizontalStackLayout HorizontalOptions="Start"
                                                           Spacing="8"
                                                           Margin="0,4,0,0"
                                                           IsVisible="{Binding CanSubmitFeedback}">
                                        <Button FontFamily="Icons"
                                                Text="&#xe8dc;"
                                                ToolTipProperties.Text="{l:Localized Key=AIAssistant_ChatView_Feedback_Good}"
                                                Padding="8,2"
                                                FontSize="12"
                                                MinimumHeightRequest="30"
                                                TextColor="{AppThemeBinding Light=#FF444444, Dark=#FFBBBBBB}"
                                                IsEnabled="{Binding HasFeedbackSubmitted, Converter={toolkit:InvertedBoolConverter}}"
                                                Clicked="AIReplyFeedbackGoodButton_Clicked"/>
                                        <Button FontFamily="Icons"
                                                Text="&#xe8db;"
                                                ToolTipProperties.Text="{l:Localized Key=AIAssistant_ChatView_Feedback_Bad}"
                                                Padding="8,2"
                                                FontSize="12"
                                                MinimumHeightRequest="30"
                                                TextColor="{AppThemeBinding Light=#FF444444, Dark=#FFBBBBBB}"
                                                IsEnabled="{Binding HasFeedbackSubmitted, Converter={toolkit:InvertedBoolConverter}}"
                                                Clicked="AIReplyFeedbackBadButton_Clicked"/>
                                        <Button FontFamily="Icons"
                                                Text="&#xe87f;"
                                                ToolTipProperties.Text="{l:Localized Key=AIAssistant_ChatView_Feedback_Report}"
                                                Padding="8,2"
                                                FontSize="12"
                                                MinimumHeightRequest="30"
                                                TextColor="{AppThemeBinding Light=#FF444444, Dark=#FFBBBBBB}"
                                                IsEnabled="{Binding HasFeedbackSubmitted, Converter={toolkit:InvertedBoolConverter}}"
                                                Clicked="AIReplyFeedbackReportButton_Clicked"/>
                                    </HorizontalStackLayout>

                                    <HorizontalStackLayout HorizontalOptions="End" Spacing="4" IsVisible="{Binding IsFirstTurn, Converter={toolkit:InvertedBoolConverter}}">
                                        <!-- ===== 重新生成（仅 AI 消息） ===== -->
                                        <Button FontFamily="Icons"
                                                Text="&#xe042;"
                                                ToolTipProperties.Text="{l:Localized Key=AIAssistant_ChatView_Regenerate}"
                                                Padding="6,2"
                                                FontSize="16"
                                                MinimumHeightRequest="30"                                             
                                                TextColor="{AppThemeBinding Light=#FF888888, Dark=#FFAAAAAA}"
                                                IsVisible="{Binding IsAssistant}"
                                                Clicked="AIRegenerateFromMessage_Clicked"/>
                                        <!-- ===== 编辑消息（仅用户消息） ===== -->
                                        <Button FontFamily="Icons"
                                                Text="&#xe150;"
                                                ToolTipProperties.Text="{l:Localized Key=AIAssistant_ChatView_EditMessage}"
                                                Padding="6,2"
                                                FontSize="16"
                                                MinimumHeightRequest="30"
                                                TextColor="{AppThemeBinding Light=#FF888888, Dark=#FFAAAAAA}"
                                                IsVisible="{Binding IsUser}"
                                                Clicked="AIEditMessage_Clicked"/>
                                        <!-- ===== 撤回至此 ===== -->
                                        <Button FontFamily="Icons"
                                                Text="&#xe166;"
                                                ToolTipProperties.Text="{l:Localized Key=AIAssistant_ChatView_RollbackToHere}"
                                                Padding="6,2"
                                                FontSize="16"
                                                MinimumHeightRequest="30"
                                                TextColor="{AppThemeBinding Light=#FF888888, Dark=#FFAAAAAA}"
                                                Clicked="AIRollbackToHere_Clicked"/>
                                        <!-- ===== 从此处分支 ===== -->
                                        <Button FontFamily="Icons"
                                                Text="&#xe0b6;"
                                                ToolTipProperties.Text="{l:Localized Key=AIAssistant_ChatView_BranchFromHere}"
                                                Padding="6,2"
                                                FontSize="16"
                                                MinimumHeightRequest="30"
                                                TextColor="{AppThemeBinding Light=#FF888888, Dark=#FFAAAAAA}"
                                                Clicked="AIBranchFromHere_Clicked"/>
                                        <!-- ===== 复制 ===== -->
                                        <Button FontFamily="Icons"
                                                Text="&#xe14d;"
                                                ToolTipProperties.Text="{l:Localized Key=DraftPage_MenuBar_Edit_Copy}"
                                                Padding="6,2"
                                                FontSize="16"
                                                MinimumHeightRequest="30"
                                                TextColor="{AppThemeBinding Light=#FF888888, Dark=#FFAAAAAA}"
                                                IsVisible="{Binding IsAssistant}"
                                                Clicked="AIReplyCopyButton_Clicked"/>
                                    </HorizontalStackLayout>


                                </Grid>

                                <!-- Feedback buttons -->
                                
                            </VerticalStackLayout>
                        </Border>
                    </Grid>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Bottom info bar -->
        <Grid Grid.Row="1">
            <Label FontSize="12"
                   TextColor="{AppThemeBinding Dark=#80ffffff, Light=Black}"
                   HorizontalOptions="Center"
                   Text="{l:Localized Key=AIAssistant_InfoGrayText}"/>
        </Grid>

        <!-- Selected files preview -->
        <VerticalStackLayout Grid.Row="2" x:Name="SelectedFilesPreview"
                             IsVisible="False" Spacing="4" Margin="0,0,0,4">
        </VerticalStackLayout>

        <!-- Input area -->
        <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
            <Button Grid.Column="0"
                    x:Name="AIAttachButton"
                    FontFamily="Icons"
                    Text="&#xe226;"
                    ToolTipProperties.Text="Attach files"
                    Padding="8,2"
                    FontSize="18"
                    MinimumHeightRequest="32"
                    Clicked="AIAttachButton_Clicked"/>
            <Entry x:Name="AIInputButton"
                   Grid.Column="1"
                   HorizontalOptions="Fill"
                   Placeholder="{l:Localized Key=AIAssistant_ChatView_SendHint}"
                   ReturnType="Send"
                   Completed="AIInputButton_Completed"/>
            <Button Grid.Column="2"
                    x:Name="AISendButton"
                    HorizontalOptions="Center"
                    Text="{l:Localized Key=AIAssistant_ChatView_Send}"
                    Clicked="AISendButton_Clicked"/>
        </Grid>
    </Grid>
    <ContentView.GestureRecognizers>
        <DropGestureRecognizer AllowDrop="True" Drop="FileDropGestureRecognizer_Drop"/>
    </ContentView.GestureRecognizers>
</ContentView>
