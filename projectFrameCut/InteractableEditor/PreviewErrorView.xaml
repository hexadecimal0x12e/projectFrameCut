<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.InteractableEditor.PreviewErrorView"
             BackgroundColor="#3A1616"
             HorizontalOptions="Fill"
             VerticalOptions="Fill"
             InputTransparent="True">
    <AbsoluteLayout x:Name="ErrorLayout"
                    SizeChanged="OnErrorLayoutSizeChanged"
                    IsClippedToBounds="True"
                    InputTransparent="True">
        <Image x:Name="ErrorIcon"
               Aspect="AspectFit"
               InputTransparent="True" />
        <Label x:Name="ErrorMessageLabel"
               TextColor="White"
               FontAutoScalingEnabled="False"
               HorizontalTextAlignment="Center"
               VerticalTextAlignment="Start"
               LineBreakMode="WordWrap"
               InputTransparent="True" />
    </AbsoluteLayout>
</ContentView>
