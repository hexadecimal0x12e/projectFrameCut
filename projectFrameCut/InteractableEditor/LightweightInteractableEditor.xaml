<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.InteractableEditor.LightweightInteractableEditor"
             x:Name="Root"
             BackgroundColor="Transparent"
             InputTransparent="True">
    <AbsoluteLayout x:Name="PreviewCanvas"
                    BackgroundColor="Transparent"
                    InputTransparent="True"
                    IsClippedToBounds="True">
        <Border x:Name="CanvasBackground"
                BackgroundColor="Black"
                StrokeThickness="0"
                InputTransparent="True">
            <GraphicsView x:Name="CheckerboardBackgroundView"
                          IsVisible="{Binding UseCheckerboardBackground, Source={x:Reference Root}}"
                          InputTransparent="True" />
        </Border>
    </AbsoluteLayout>
</ContentView>
