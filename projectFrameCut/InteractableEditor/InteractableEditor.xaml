<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.InteractableEditor.InteractableEditor"
             BackgroundColor="Transparent"
             InputTransparent="False">
    <AbsoluteLayout x:Name="EditorCanvas" BackgroundColor="Transparent" InputTransparent="False" ZIndex="100">
        <Border x:Name="RenderRectVisual"
            IsVisible="False"
            Stroke="#FF4D6D"
            StrokeThickness="2"
            BackgroundColor="Transparent"
            InputTransparent="True"
            ZIndex="100"
            AbsoluteLayout.LayoutFlags="None">

        </Border>

        <Label x:Name="RenderRectLabel"
               IsVisible="False"
               Opacity="0.95"
               InputTransparent="True"
               TextColor="#FF4D6D"
               BackgroundColor="#AA000000"
               Padding="6,2"
               FontSize="10"
               LineBreakMode="NoWrap"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               ZIndex="103"/>

        <AbsoluteLayout x:Name="ClipStatesHost"
                BackgroundColor="Transparent"
                InputTransparent="False"
                ZIndex="101"
                AbsoluteLayout.LayoutFlags="None" />
        
        <Label x:Name="MeasurementLabel" IsVisible="True" Opacity="0" InputTransparent="True" LineBreakMode="NoWrap" HorizontalOptions="Start" VerticalOptions="Start"/>
    </AbsoluteLayout>
</ContentView>