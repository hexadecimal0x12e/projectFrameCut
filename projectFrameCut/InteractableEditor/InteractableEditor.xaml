<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.InteractableEditor.InteractableEditor"
             BackgroundColor="Transparent"
             xmlns:local="clr-namespace:projectFrameCut"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             xmlns:l="clr-namespace:LocalizedResources"
             x:DataType="local:InteractableEditor.InteractableEditor"
             InputTransparent="False">
    <Grid BackgroundColor="Transparent"
          InputTransparent="False">
        <Image x:Name="PreviewOverlayImage"
             x:FieldModifier="public"
               BackgroundColor="#112233"
               Aspect="AspectFit"
               InputTransparent="True"
               IsVisible="True"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ContentView x:Name="LivePreviewerHost"
                x:FieldModifier="public"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     BackgroundColor="Transparent"
                     InputTransparent="True" />

        <AbsoluteLayout x:Name="EditorCanvas" BackgroundColor="Transparent" InputTransparent="False" ZIndex="100">
            <Border x:Name="RenderRectVisual"
                IsVisible="False"
                Stroke="#80ffffff"
                Background="#000000"
                StrokeThickness="2"
                BackgroundColor="Transparent"
                InputTransparent="True"
                ZIndex="100"
                AbsoluteLayout.LayoutFlags="None">
            </Border>

            <AbsoluteLayout x:Name="ClipStatesHost"
                    BackgroundColor="Transparent"
                    InputTransparent="False"
                    ZIndex="101"
                    AbsoluteLayout.LayoutFlags="None" />

            <AbsoluteLayout x:Name="ReferenceLinesHost"
                    BackgroundColor="Transparent"
                    InputTransparent="True"
                    ZIndex="110"
                    AbsoluteLayout.LayoutFlags="None" />

            <Label x:Name="MeasurementLabel" IsVisible="True" Opacity="0" InputTransparent="True" LineBreakMode="NoWrap" HorizontalOptions="Start" VerticalOptions="Start" />


        </AbsoluteLayout>
        <Grid x:Name="BottomControlsHost"
              VerticalOptions="End"
              HorizontalOptions="Fill"
              HeightRequest="48"
              BackgroundColor="Transparent"
              InputTransparent="False"
              ZIndex="9999">
            <HorizontalStackLayout x:Name="LayoutOptionsBar" Margin="4" VerticalOptions="End">
                <HorizontalStackLayout Margin="4,0" ToolTipProperties.Text="{l:Localized Key=InteractableEditor_LockLayout}">
                    <CheckBox IsChecked="{Binding LockLayout}"/>
                    <Label Text="&#xe897;" Margin="-12,0,0,0" FontFamily="Icons"  VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout  Margin="4,0" ToolTipProperties.Text="{l:Localized Key=InteractableEditor_EnableSnapping}">
                    <CheckBox IsChecked="{Binding EnableSnapping}"  />
                    <Label Text="&#xeeac;" Margin="-12,0,0,0" FontFamily="Icons"  VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout  Margin="4,0" ToolTipProperties.Text="{l:Localized Key=InteractableEditor_AllowClipOutOfBounds}">
                    <CheckBox IsChecked="{Binding DisallowClipOutOfBounds}"  />
                    <Label Text="&#xf54f;" Margin="-12,0,0,0" FontFamily="Icons"  VerticalOptions="Center" />
                </HorizontalStackLayout>
                <HorizontalStackLayout  Margin="4,0" ToolTipProperties.Text="{l:Localized Key=InteractableEditor_ShowReferenceLines}">
                    <CheckBox IsChecked="{Binding ShowReferenceLines}"  />
                    <Label Text="&#xf017;" Margin="-12,0,0,0" FontFamily="Icons"  VerticalOptions="Center" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
            <Button x:Name="RefreshButton" Text="&#xe5d5;" FontFamily="Icons" Clicked="RefreshButton_Clicked" HorizontalOptions="End" VerticalOptions="End" ToolTipProperties.Text="{l:Localized Key=InteractableEditor_Refersh}" Margin="8,8,8,8"/>
        </Grid>
    </Grid>
</ContentView>