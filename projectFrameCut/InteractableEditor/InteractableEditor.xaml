<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.InteractableEditor.InteractableEditor"
             BackgroundColor="Transparent"
             xmlns:local="clr-namespace:projectFrameCut"
             xmlns:toolkit="clr-namespace:CommunityToolkit.Maui.Converters;assembly=CommunityToolkit.Maui"
             xmlns:l="clr-namespace:LocalizedResources"
             x:DataType="local:InteractableEditor.InteractableEditor"
             InputTransparent="False">
    <Grid BackgroundColor="Transparent"
          InputTransparent="False"
          IsClippedToBounds="True">
        <Image x:Name="PreviewOverlayImage"
             x:FieldModifier="public"
               Aspect="AspectFit"
               InputTransparent="True"
               IsVisible="True"
               HorizontalOptions="Fill"
               VerticalOptions="Fill" />

        <ContentView x:Name="LivePreviewerHost"
                x:FieldModifier="public"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     BackgroundColor="Transparent"
                     InputTransparent="True" />

        <AbsoluteLayout x:Name="EditorCanvas" BackgroundColor="Transparent" InputTransparent="False" ZIndex="100" HorizontalOptions="Fill" VerticalOptions="Fill">
            <Border x:Name="RenderRectVisual"
                IsVisible="False"
                Stroke="#80ffffff"
                Background="{Binding EditorCanvasBackground}"
                StrokeThickness="2"
                BackgroundColor="Transparent"
                InputTransparent="True"
                ZIndex="100"
                AbsoluteLayout.LayoutFlags="None">
            </Border>

            <AbsoluteLayout x:Name="ClipStatesHost"
                    BackgroundColor="Transparent"
                    InputTransparent="False"
                    ZIndex="101"
                    AbsoluteLayout.LayoutFlags="None" />

            <AbsoluteLayout x:Name="ReferenceLinesHost"
                    BackgroundColor="Transparent"
                    InputTransparent="True"
                    ZIndex="500"
                    AbsoluteLayout.LayoutFlags="None" />


            <Border x:Name="DebugOverlay"
                IsVisible="False"
                BackgroundColor="#CC000000"
                Stroke="#80ffffff"
                StrokeThickness="1"
                Padding="6"
                HorizontalOptions="Start"
                VerticalOptions="Start"
                ZIndex="9999"
                InputTransparent="True"
                AbsoluteLayout.LayoutFlags="None">
                <Label x:Name="DebugInfoLabel"
                    TextColor="White"
                    FontSize="11"
                    FontFamily="MarkdownCodeBlock"
                    LineBreakMode="WordWrap"
                    MaxLines="20" />
            </Border>

        </AbsoluteLayout>
        <Border x:Name="InfoIndicatorHost"
                IsVisible="False"
                WidthRequest="44"
                HeightRequest="44"
                Margin="8"
                Padding="0"
                Opacity="0.45"
                BackgroundColor="#CC202020"
                Stroke="#B0FFFFFF"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 22"
                HorizontalOptions="Start"
                VerticalOptions="End"
                ZIndex="9999">
            <Label Text="i"
                   TextColor="White"
                   FontSize="20"
                   FontAttributes="Bold"
                   HorizontalTextAlignment="Center"
                   VerticalTextAlignment="Center"
                   InputTransparent="True" />
        </Border>

        <HorizontalStackLayout x:Name="BottomControlsHost"
                               HorizontalOptions="End"
                               VerticalOptions="End"
                               Margin="8"
                               Spacing="8"
                               InputTransparent="False"
                               SizeChanged="OnBottomControlsHostSizeChanged"
                               ZIndex="9999">
            <Button x:Name="OptionsButton" Text="&#xe8b8;" FontFamily="Icons" Clicked="OptionsButton_Clicked" ToolTipProperties.Text="{l:Localized Key=DraftPage_MenuBar_Edit_ConfigurePreview}" />
            <Button x:Name="RefreshButton" Text="&#xe5d5;" FontFamily="Icons" Clicked="RefreshButton_Clicked" ToolTipProperties.Text="{l:Localized Key=InteractableEditor_Refersh}" />
        </HorizontalStackLayout>

        <Border x:Name="InfoDetailsOverlay"
                IsVisible="False"
                InputTransparent="True"
                Margin="8,8,8,64"
                Padding="12,8"
                MinimumWidthRequest="180"
                MaximumWidthRequest="360"
                HorizontalOptions="Start"
                VerticalOptions="End"
                BackgroundColor="#F0202020"
                Stroke="#808080"
                StrokeThickness="1"
                StrokeShape="RoundRectangle 6"
                ZIndex="10000">
            <Label x:Name="InfoDetailsLabel"
                   TextColor="White"
                   FontSize="13"
                   LineBreakMode="WordWrap" />
        </Border>

        <Grid x:Name="OptionsOverlay" IsVisible="False" InputTransparent="False" ZIndex="10000">
            <Button BackgroundColor="#40000000" BorderWidth="0" CornerRadius="0" Clicked="OptionsOverlayBackground_Clicked" />
            <Border Margin="8,8,8,8" Padding="16" MaximumWidthRequest="560" MaximumHeightRequest="560"
                    HorizontalOptions="Center" VerticalOptions="Center" BackgroundColor="#F0202020"
                    Stroke="#666666" StrokeThickness="1" StrokeShape="RoundRectangle 8">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <VerticalStackLayout.Resources>
                            <Style TargetType="Label">
                                <Setter Property="TextColor" Value="White" />
                            </Style>
                        </VerticalStackLayout.Resources>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{l:Localized Key=DraftPage_MenuBar_Edit_ConfigurePreview}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                            <Button Grid.Column="1" Text="&#xe5cd;" FontFamily="Icons" Clicked="CloseOptionsButton_Clicked" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{l:Localized Key=InteractableEditor_LockLayout}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding LockLayout}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{l:Localized Key=InteractableEditor_EnableSnapping}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding EnableSnapping}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{l:Localized Key=InteractableEditor_AllowClipOutOfBounds}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding DisallowClipOutOfBounds}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{l:Localized Key=InteractableEditor_ShowReferenceLines}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShowReferenceLines}" />
                        </Grid>
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{l:Localized Key=InteractableEditor_ShowAllBorders}" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="{Binding ShowAllBorders}" />
                        </Grid>
                        <BoxView HeightRequest="1" BackgroundColor="#555555" />
                        <Label Text="{l:Localized Key=InteractableEditor_PreviewMode}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                        <Picker x:Name="PreviewResolutionPicker" MinimumWidthRequest="180" HorizontalOptions="Fill"
                                SelectedIndexChanged="PreviewResolutionPicker_SelectedIndexChanged" />
                        <BoxView HeightRequest="1" BackgroundColor="#555555" />
                        <Label Text="{l:Localized Key=InteractableEditor_ReferenceLine}" FontAttributes="Bold" FontSize="16" VerticalOptions="Center" />
                        <HorizontalStackLayout Spacing="12">
                            <Border x:Name="DefaultColorSwatchBorder"
                                    WidthRequest="32"
                                    HeightRequest="32"
                                    StrokeThickness="1.5"
                                    Stroke="#777777"
                                    StrokeShape="RoundRectangle 3"
                                    BackgroundColor="{Binding DefaultReferenceLineColor}"
                                    ToolTipProperties.Text="{l:Localized Key=InteractableEditor_DefaultReferenceLineColor}">
                                <Border.GestureRecognizers>
                                    <TapGestureRecognizer Tapped="OnDefaultColorSwatchTapped" />
                                </Border.GestureRecognizers>
                            </Border>
                            <Label Text="{l:Localized Key=InteractableEditor_DefaultReferenceLineThickness}" VerticalOptions="Center" />
                            <Entry x:Name="ThicknessEntry"
                                   WidthRequest="56"
                                   Keyboard="Numeric"
                                   VerticalOptions="Center"
                                   HorizontalTextAlignment="Center"
                                   Completed="OnThicknessEntryCompleted"
                                   Unfocused="OnThicknessEntryUnfocused" />
                        </HorizontalStackLayout>
                        <Button Text="{l:Localized Key=InteractableEditor_ManageReferenceLines}" Clicked="ManageRefLineButton_Clicked" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentView>
