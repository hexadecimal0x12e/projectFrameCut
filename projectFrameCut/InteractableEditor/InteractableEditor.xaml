<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.InteractableEditor.InteractableEditor"
             BackgroundColor="Transparent"
             InputTransparent="False">
    <AbsoluteLayout x:Name="EditorCanvas" BackgroundColor="Transparent" InputTransparent="False" ZIndex="100">
        <Border x:Name="ClipVisual"
                Stroke="Yellow"
                StrokeThickness="2"
                BackgroundColor="#33FFFF00"
                InputTransparent="False"
                ZIndex="101"
                AbsoluteLayout.LayoutFlags="None">

        </Border>

        <!-- Resize Handles -->
        <BoxView x:Name="HandleTL" Color="Cyan" WidthRequest="15" HeightRequest="15" InputTransparent="False" ZIndex="102" AbsoluteLayout.LayoutFlags="None">

        </BoxView>

        <BoxView x:Name="HandleTR" Color="Cyan" WidthRequest="15" HeightRequest="15" InputTransparent="False" ZIndex="102" AbsoluteLayout.LayoutFlags="None">

        </BoxView>

        <BoxView x:Name="HandleBL" Color="Cyan" WidthRequest="15" HeightRequest="15" InputTransparent="False" ZIndex="102" AbsoluteLayout.LayoutFlags="None">

        </BoxView>

        <BoxView x:Name="HandleBR" Color="Cyan" WidthRequest="15" HeightRequest="15" InputTransparent="False" ZIndex="102" AbsoluteLayout.LayoutFlags="None">

        </BoxView>

        <Label x:Name="SolidColorSizeLabel"
               IsVisible="False"
               Opacity="0.95"
               InputTransparent="True"
               TextColor="White"
               BackgroundColor="#88000000"
               Padding="6,2"
               FontSize="10"
               LineBreakMode="NoWrap"
               HorizontalOptions="Start"
               VerticalOptions="Start"
               ZIndex="103"/>
        
        <Label x:Name="MeasurementLabel" IsVisible="True" Opacity="0" InputTransparent="True" LineBreakMode="NoWrap" HorizontalOptions="Start" VerticalOptions="Start"/>
    </AbsoluteLayout>
</ContentView>