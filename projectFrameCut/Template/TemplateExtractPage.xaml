<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="projectFrameCut.Template.TemplateExtractPage"
             xmlns:l="clr-namespace:LocalizedResources"
             x:Name="RootPage"
             Title="{l:Localized Key=TemplateExtractPage_Title}">
    <Grid RowDefinitions="Auto,Auto,*,Auto" RowSpacing="10" Padding="12">
        <VerticalStackLayout Grid.Row="0" Spacing="4">
            <Label x:Name="ProjectNameLabel"
                   FontAttributes="Bold"
                   FontSize="18"
                     Text="" />
                 <Label Text="{l:Localized Key=TemplateExtractPage_Description}"
                   FontSize="12"
                   Opacity="0.8" />
            <Label x:Name="StepHeaderLabel"
                   Text="{l:Localized Key=TemplateExtractPage_Stage1}"
                   FontSize="13"
                   FontAttributes="Bold"
                   Opacity="0.85" />
        </VerticalStackLayout>

        <Grid Grid.Row="1" x:Name="StepOneFiltersGrid" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
            <SearchBar x:Name="FieldSearchBar"
                       Placeholder="{l:Localized Key=TemplateExtractPage_FieldSearchPlaceholder}"
                       TextChanged="FieldSearchBar_TextChanged" />
            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Label Text="{l:Localized Key=TemplateExtractPage_ShowNonRecommended}"
                       VerticalOptions="Center"
                       FontSize="12" />
                <Switch x:Name="ShowNonRecommendedSwitch"
                        IsToggled="False"
                        Toggled="ShowNonRecommendedSwitch_Toggled"
                        VerticalOptions="Center" />
            </HorizontalStackLayout>
            <Button Grid.Column="2"
                    Text="{l:Localized Key=TemplateExtractPage_Recommended}"
                    Clicked="SelectRecommended_Clicked" />
            <Button Grid.Column="3"
                    Text="{l:Localized Key=TemplateExtractPage_Clear}"
                    Clicked="ClearSelection_Clicked" />
        </Grid>

        <Grid Grid.Row="2">
            <ScrollView>
                <VerticalStackLayout x:Name="StepOnePanel" Spacing="10">
                    <Border StrokeThickness="1" Padding="8">
                        <VerticalStackLayout Spacing="8">
                            <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                                <Label Text="{l:Localized Key=TemplateExtractPage_SelectExportClips}"
                                   VerticalOptions="Center"
                                   FontAttributes="Bold" />
                                <Button Grid.Column="1"
                                    Text="{l:Localized Key=TemplateExtractPage_SelectAll}"
                                    Clicked="SelectAllClips_Clicked" />
                                <Button Grid.Column="2"
                                    Text="{l:Localized Key=TemplateExtractPage_Clear}"
                                    Clicked="ClearClips_Clicked" />
                            </Grid>
                            <CollectionView x:Name="ClipsCollectionView"
                                SelectionMode="None"
                                HeightRequest="150">
                                <CollectionView.ItemTemplate>
                                    <DataTemplate>
                                        <Grid ColumnDefinitions="Auto,*,Auto"
                                          ColumnSpacing="8"
                                          Padding="0,2">
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                               Text="{Binding DisplayName}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                            <Label Grid.Column="2"
                                               Text="{Binding ClipIdShort}"
                                               FontSize="11"
                                               Opacity="0.7"
                                               VerticalOptions="Center" />
                                        </Grid>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>
                        </VerticalStackLayout>
                    </Border>

                    <CollectionView x:Name="FieldsCollectionView" SelectionMode="None">
                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border StrokeThickness="1"
                                    Padding="8"
                                    Margin="0,0,0,6">
                                    <VerticalStackLayout Spacing="6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                            <Label Grid.Column="1"
                                               Text="{Binding PathDisplay}"
                                               LineBreakMode="TailTruncation"
                                               VerticalOptions="Center" />
                                            <Label Grid.Column="2"
                                               Text="{Binding Scope}"
                                               FontSize="11"
                                               Opacity="0.75"
                                               VerticalOptions="Center" />
                                        </Grid>
                                        <Label Text="{Binding ValuePreview}"
                                           FontSize="12"
                                           Opacity="0.75"
                                           LineBreakMode="TailTruncation" />
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </VerticalStackLayout>
            </ScrollView>
            <Grid x:Name="StepTwoPanel" IsVisible="False" RowSpacing="10">
                <ScrollView >
                    <VerticalStackLayout Spacing="10">
                        <CollectionView x:Name="ConfigFieldsCollectionView"
                                        SelectionMode="None">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Border StrokeThickness="1"
                                            Padding="8"
                                            Margin="0,0,0,6">
                                        <VerticalStackLayout Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                                <Label Text="{Binding PathDisplay}"
                                                       LineBreakMode="TailTruncation"
                                                       VerticalOptions="Center" />
                                                <Label Grid.Column="1"
                                                       Text="{Binding Scope}"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                            <Label Text="{Binding ValuePreview}"
                                                   FontSize="12"
                                                   Opacity="0.75"
                                                   LineBreakMode="TailTruncation" />
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Text="{l:Localized Key=TemplateExtractPage_VariableName}"
                                                       VerticalOptions="Center"
                                                       FontSize="12" />
                                                <Entry Grid.Column="1"
                                                       Text="{Binding VariableKey}"
                                                       Placeholder="{l:Localized Key=TemplateExtractPage_VariableName}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Text="{l:Localized Key=TemplateExtractPage_VariableType}"
                                                       VerticalOptions="Center"
                                                       FontSize="12" />
                                                <Picker Grid.Column="1"
                                                        ItemsSource="{Binding VariableTypeOptions}"
                                                        SelectedIndex="{Binding VariableTypeIndex}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Text="{l:Localized Key=TemplateExtractPage_VariableDisplayName}" 
                                                       VerticalOptions="Center"
                                                       FontSize="12" />
                                                <Entry Grid.Column="1"
                                                       Text="{Binding UserFriendlyName}"
                                                       Placeholder="{l:Localized Key=TemplateExtractPage_VariableDisplayName_Sub}" />
                                            </Grid>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Label Text="{l:Localized Key=TemplateExtractPage_VariableDesc}"
                                                       VerticalOptions="Center"
                                                       FontSize="12" />
                                                <Editor Grid.Column="1"
                                                        Text="{Binding Description}"
                                                        AutoSize="TextChanges"
                                                        Placeholder="{l:Localized Key=TemplateExtractPage_VariableDesc_Sub}"
                                                        MinimumHeightRequest="56" />
                                            </Grid>
                                        </VerticalStackLayout>
                                    </Border>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>

                        <!-- ===== 手动添加变量（与 ScriptTemplateCreatePage 同款） ===== -->
                        <Border StrokeThickness="1" Padding="8">
                            <Grid RowDefinitions="Auto,*,Auto" RowSpacing="6">
                                <Label Text="{l:Localized Key=TemplateExtractPage_CustomVariables}"
                                       FontAttributes="Bold"
                                       FontSize="13" />

                                <Border Grid.Row="1" StrokeThickness="0" MaximumHeightRequest="240">
                                    <CollectionView x:Name="ManualVariablesCollectionView"
                                                    SelectionMode="None"
                                                    ItemSizingStrategy="MeasureAllItems">
                                        <CollectionView.ItemTemplate>
                                            <DataTemplate>
                                                <Border StrokeThickness="1" Padding="8" Margin="0,0,0,6">
                                                    <VerticalStackLayout Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="6">
                                                            <Label Text="{l:Localized Key=ScriptTemplateCreatePage_VariableName}"
                                                                   FontSize="12"
                                                                   VerticalOptions="Center" />
                                                            <Entry Grid.Column="1"
                                                                   Text="{Binding VariableName}"
                                                                   FontSize="12"
                                                                   Placeholder="{l:Localized Key=ScriptTemplateCreatePage_VariableNamePlaceholder}"
                                                                   ClearButtonVisibility="WhileEditing" />
                                                            <Label Grid.Column="2"
                                                                   Text="{l:Localized Key=ScriptTemplateCreatePage_VariableType}"
                                                                   FontSize="12"
                                                                   VerticalOptions="Center" />
                                                            <Picker Grid.Column="3"
                                                                    ItemsSource="{Binding TypeOptions}"
                                                                    SelectedItem="{Binding SelectedType}"
                                                                    FontSize="12" />
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="6">
                                                            <Label Text="{l:Localized Key=ScriptTemplateCreatePage_DisplayName}"
                                                                   FontSize="12"
                                                                   VerticalOptions="Center" />
                                                            <Entry Grid.Column="1"
                                                                   Text="{Binding DisplayName}"
                                                                   FontSize="12"
                                                                   Placeholder="{l:Localized Key=ScriptTemplateCreatePage_DisplayNamePlaceholder}"
                                                                   ClearButtonVisibility="WhileEditing" />
                                                            <Button Grid.Column="2"
                                                                    Text="{l:Localized Key=ScriptTemplateCreatePage_Delete}"
                                                                    TextColor="Red"
                                                                    FontSize="12"
                                                                    HeightRequest="32"
                                                                    Clicked="OnDeleteManualVariableClicked" />
                                                        </Grid>
                                                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                            <Label Text="{l:Localized Key=ScriptTemplateCreatePage_DefaultValueLabel}"
                                                                   FontSize="12"
                                                                   VerticalOptions="Center" />
                                                            <Entry Grid.Column="1"
                                                                   Text="{Binding DefaultValue}"
                                                                   FontSize="12"
                                                                   Placeholder="{l:Localized Key=ScriptTemplateCreatePage_DefaultValuePlaceholder}"
                                                                   ClearButtonVisibility="WhileEditing" />
                                                        </Grid>
                                                    </VerticalStackLayout>
                                                </Border>
                                            </DataTemplate>
                                        </CollectionView.ItemTemplate>
                                        <CollectionView.EmptyView>
                                            <Label Text="{l:Localized Key=ScriptTemplateCreatePage_EmptyVariables}"
                                                   FontSize="12"
                                                   Opacity="0.6"
                                                   HorizontalOptions="Center"
                                                   Margin="0,10" />
                                        </CollectionView.EmptyView>
                                    </CollectionView>
                                </Border>

                                <Button Grid.Row="2"
                                        Text="{l:Localized Key=ScriptTemplateCreatePage_AddVariable}"
                                        Clicked="OnAddManualVariableClicked"
                                        FontSize="13"
                                        HeightRequest="36" />
                            </Grid>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
            <Grid x:Name="StepThreePanel" IsVisible="False" RowSpacing="10">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Border StrokeThickness="1" Padding="8">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="{l:Localized Key=TemplateExtractPage_ExportAssets}"
                                       FontAttributes="Bold"
                                       FontSize="13" />
                                <Label Text="{l:Localized Key=TemplateExtractPage_ExportAssets_Description}"
                                       FontSize="12"
                                       Opacity="0.75" />

                                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="8">
                                    <Button x:Name="SelectReferencedAssetsButton"
                                            Text="{l:Localized Key=TemplateExtractPage_SelectReferencedAssets}"
                                            Clicked="SelectReferencedAssets_Clicked" />
                                    <Button Grid.Column="1"
                                            x:Name="ClearAssetSelectionButton"
                                            Text="{l:Localized Key=TemplateExtractPage_ClearAssetSelection}"
                                            Clicked="ClearAssetSelection_Clicked" />
                                    <Button Grid.Column="2"
                                            x:Name="AddExternalAssetButton"
                                            Text="{l:Localized Key=TemplateExtractPage_AddExternalAsset}"
                                            Clicked="AddExternalAsset_Clicked" />
                                    <Label Grid.Column="3"
                                           x:Name="AssetSelectionStatsLabel"
                                           Text="{l:Localized Key=TemplateExtractPage_AssetSelectionStatsInitial}"
                                           HorizontalOptions="End"
                                           VerticalOptions="Center"
                                           FontSize="12"
                                           Opacity="0.75" />
                                </Grid>

                                <CollectionView x:Name="AssetsCollectionView"
                                                SelectionMode="None"
                                                HeightRequest="220">
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="8"
                                                  Padding="0,2">
                                                <CheckBox IsChecked="{Binding IsSelected}" VerticalOptions="Center" />
                                                <VerticalStackLayout Grid.Column="1" Spacing="0">
                                                    <Label Text="{Binding DisplayName}" LineBreakMode="TailTruncation" />
                                                    <Label Text="{Binding PathDisplay}"
                                                           FontSize="11"
                                                           Opacity="0.7"
                                                           LineBreakMode="TailTruncation" />
                                                </VerticalStackLayout>
                                                <Label Grid.Column="2"
                                                       Text="{Binding SourceDisplay}"
                                                       FontSize="11"
                                                       Opacity="0.75"
                                                       VerticalOptions="Center" />
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>

            <Grid x:Name="StepFourPanel" IsVisible="False" RowSpacing="10">
                <ScrollView>
                    <VerticalStackLayout Spacing="12" Padding="0,0,0,12">
                        <Border StrokeThickness="1" Padding="12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{l:Localized Key=TemplateExtractPage_Step4_TitleLabel}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                                <Entry x:Name="TemplateTitleEntry"
                                       Placeholder="{l:Localized Key=TemplateExtractPage_Step4_TitlePlaceholder}"
                                       ClearButtonVisibility="WhileEditing" />
                                <Entry x:Name="TemplateSubtitleEntry"
                                       Placeholder="{l:Localized Key=TemplateExtractPage_Step4_SubtitlePlaceholder}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeThickness="1" Padding="12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{l:Localized Key=TemplateExtractPage_Step4_TagLabel}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                                <Label Text="{l:Localized Key=TemplateExtractPage_Step4_TagDescription}"
                                       FontSize="12"
                                       Opacity="0.7" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry x:Name="TagInputEntry"
                                           Placeholder="{l:Localized Key=TemplateExtractPage_Step4_TagPlaceholder}"
                                           ClearButtonVisibility="WhileEditing"
                                           Completed="TagInputEntry_Completed" />
                                    <Button Grid.Column="1"
                                            x:Name="AddTagButton"
                                            Text="{l:Localized Key=TemplateExtractPage_Step4_AddTag}"
                                            Clicked="AddTag_Clicked" />
                                </Grid>
                                <FlexLayout x:Name="TagsContainer"
                                            Wrap="Wrap"
                                            JustifyContent="Start"
                                            AlignItems="Start"
                                            BindableLayout.ItemsSource="{Binding}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate>
                                            <Border StrokeThickness="1"
                                                    Padding="8,4"
                                                    Margin="0,0,6,6"
                                                    StrokeShape="RoundRectangle 12">
                                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
                                                    <Label Text="{Binding .}"
                                                           VerticalOptions="Center"
                                                           FontSize="12" />
                                                    <Button Grid.Column="1"
                                                            Text="✕"
                                                            FontSize="10"
                                                            Padding="2,0"
                                                            BackgroundColor="Transparent"
                                                            WidthRequest="20"
                                                            HeightRequest="20"
                                                            VerticalOptions="Center"
                                                            Clicked="RemoveTag_Clicked" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Border>

                        <Border StrokeThickness="1" Padding="12">
                            <VerticalStackLayout Spacing="10">
                                <Label Text="{l:Localized Key=TemplateExtractPage_Step4_ReadmeLabel}"
                                       FontAttributes="Bold"
                                       FontSize="14" />
                                <Label Text="{l:Localized Key=TemplateExtractPage_Step4_ReadmeDescription}"
                                       FontSize="12"
                                       Opacity="0.7" />
                                <Editor x:Name="ReadmeEditor"
                                        Placeholder="{l:Localized Key=TemplateExtractPage_Step4_ReadmePlaceholder}"
                                        AutoSize="TextChanges"
                                        MinimumHeightRequest="200" />
                            </VerticalStackLayout>
                        </Border>

                        <!-- ===== 脚本模板开关 ===== -->
                        <Border x:Name="ScriptSection"
                                StrokeThickness="1"
                                Padding="12">
                            <VerticalStackLayout Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <VerticalStackLayout>
                                        <Label Text="{l:Localized Key=TemplateExtractPage_Step4_ScriptSectionTitle}"
                                               FontAttributes="Bold"
                                               FontSize="14" />
                                        <Label Text="{l:Localized Key=TemplateExtractPage_Step4_ScriptDescription}"
                                               FontSize="12"
                                               Opacity="0.7" />
                                    </VerticalStackLayout>
                                    <Switch x:Name="ScriptEnabledSwitch"
                                            Grid.Column="1"
                                            VerticalOptions="Center"
                                            Toggled="ScriptEnabledSwitch_Toggled" />
                                </Grid>

                                <!-- 脚本选择区域（默认隐藏） -->
                                <VerticalStackLayout x:Name="ScriptUploadPanel"
                                                     IsVisible="False"
                                                     Spacing="8">
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                        <Button x:Name="SelectScriptButton"
                                                Text="{l:Localized Key=ScriptTemplateCreatePage_SelectScript}"
                                                Clicked="SelectScript_Clicked" />
                                        <Label x:Name="ScriptFileNameLabel"
                                               Grid.Column="1"
                                               Text="{l:Localized Key=ScriptTemplateCreatePage_NoFileSelected}"
                                               VerticalOptions="Center"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>
                                    <Border StrokeThickness="0.5" Padding="6" MinimumHeightRequest="100" MaximumHeightRequest="200">
                                        <ScrollView>
                                            <Editor x:Name="ScriptEditor"
                                                    Placeholder="{l:Localized Key=ScriptTemplateCreatePage_ScriptPlaceholder}"
                                                    FontFamily="MarkdownCodeBlock"
                                                    FontSize="11"
                                                    IsSpellCheckEnabled="False"
                                                    AutoSize="TextChanges"
                                                    TextChanged="ScriptEditor_TextChanged" />
                                        </ScrollView>
                                    </Border>
                                </VerticalStackLayout>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </ScrollView>
            </Grid>
        </Grid>

        <Grid Grid.Row="3" ColumnDefinitions="*,Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="10" VerticalOptions="Center">
            <Label x:Name="StatsLabel"
               Text="{l:Localized Key=TemplateExtractPage_Stats_NoFieldSelected}"
                   VerticalOptions="Center" />
            <Label Grid.Column="1"
                   x:Name="ScopeLabel"
                   Text="{l:Localized Key=TemplateExtractPage_Scope}"
                   VerticalOptions="Center"
                   FontSize="12" />
            <Picker Grid.Column="2"
                    x:Name="ScopePicker"
                    WidthRequest="120"
                    VerticalOptions="Center" />
            <Button Grid.Column="3"
                Text="{l:Localized Key=_Cancel}"
                    Clicked="Cancel_Clicked" />
                <Button Grid.Column="4"
                    x:Name="PreviousStepButton"
                    Text="{l:Localized Key=_Back}"
                    IsVisible="False"
                    Clicked="PreviousStep_Clicked" />
                <Button Grid.Column="5"
                    x:Name="NextStepButton"
                    Text="{l:Localized Key=_Next}"
                    Clicked="NextStep_Clicked" />
                <Button Grid.Column="6"
                    x:Name="SaveButton"
                    IsVisible="False"
                    Text="{l:Localized Key=TemplateExtractPage_SaveTemplate}"
                    Clicked="Save_Clicked" />
        </Grid>
    </Grid>
</ContentPage>