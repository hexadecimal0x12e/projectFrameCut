<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:l="clr-namespace:LocalizedResources"
             x:Class="projectFrameCut.SetupPage"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False"
             Title="欢迎">

    <VerticalStackLayout Padding="24" Spacing="12" VerticalOptions="Center">
        <Image x:Name="AppLogoIcon" WidthRequest="180" HeightRequest="180" Source="appicon.png"/>
        <Label Text="{l:Localized Key=WelcomeMessage}" FontSize="30" FontAttributes="Bold" HorizontalOptions="Center" />
        <HorizontalStackLayout HorizontalOptions="Center">
            <CheckBox x:Name="AgreeEULACheckbox" VerticalOptions="Center"  />
            <Label Text="{l:Localized Key=WelocmePage_AgreeEULA}" VerticalOptions="Center" Margin="-8,0,0,0" />
        </HorizontalStackLayout>
        <Button Text="{l:Localized Key=WelocmePage_Start}" HorizontalOptions="Center" WidthRequest="220" Clicked="Button_Clicked" IsEnabled="{Binding Source={x:Reference AgreeEULACheckbox}, Path=IsChecked}" />
    </VerticalStackLayout>
</ContentPage>