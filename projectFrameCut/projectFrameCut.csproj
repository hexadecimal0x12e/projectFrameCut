<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0-android;net10.0_linux</TargetFrameworks>
		<TargetFrameworks Condition="!$([MSBuild]::IsOSPlatform('linux'))">$(TargetFrameworks);net11.0-ios</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>

		<!-- Note for MacCatalyst:
			The default runtime is maccatalyst-x64, except in Release config, in which case the default is maccatalyst-x64;maccatalyst-arm64.
			When specifying both architectures, use the plural <RuntimeIdentifiers> instead of the singular <RuntimeIdentifier>.
			The Mac App Store will NOT accept apps with ONLY maccatalyst-arm64 indicated;
			either BOTH runtimes must be indicated or ONLY macatalyst-x64. -->
		<!-- For example: <RuntimeIdentifiers>maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers> -->
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(Configuration)' == 'Release'">maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(Configuration)' != 'Release' and '$(Platform)' == 'x64'">maccatalyst-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(Configuration)' != 'Release' and '$(Platform)' == 'Arm64'">maccatalyst-arm64</RuntimeIdentifier>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">ios-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">win-x64;win-arm64</RuntimeIdentifiers>
		<OutputType>Exe</OutputType>
		<RootNamespace>projectFrameCut</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>


		<!-- Display name -->
		<ApplicationTitle>projectFrameCut</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.hexadecimal0x12e.projectframecut</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>9</ApplicationVersion>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>

		<DefaultLanguage>zh-CN</DefaultLanguage>
		<Platforms>AnyCPU;x64</Platforms>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<NeutralLanguage>zh-CN</NeutralLanguage>
		<MauiEnableXamlCBindingWithSourceCompilation>true</MauiEnableXamlCBindingWithSourceCompilation>
		<MauiXamlInflator>SourceGen</MauiXamlInflator>
		<WindowsPackageType>MSIX</WindowsPackageType>

		<AssemblyVersion>1.6.0.0</AssemblyVersion>
		<FileVersion>1.6.0.0</FileVersion>
		<Authors>hexadecimal0x12e</Authors>
		<Product>projectFrameCut</Product>
		<Description>projectFrameCut Application</Description>
		<AssemblyTitle>projectFrameCut Application</AssemblyTitle>
		<AssemblyDescription>projectFrameCut Main Application</AssemblyDescription>
		<Copyright>Copyright (c) hexadecimal0x12e 2025-2026</Copyright>
		<PackageProjectUrl>hexadecimal0x12e.com/projectFrameCut</PackageProjectUrl>
		<Title>projectFrameCut Application</Title>

		<GenerateAppInstallerFile>False</GenerateAppInstallerFile>
		<AppxPackageSigningEnabled>True</AppxPackageSigningEnabled>
		<PackageCertificateThumbprint>709BFFFE9C8383532B419FAEE50869A22F19234F</PackageCertificateThumbprint>
		<AppxPackageSigningTimestampDigestAlgorithm>SHA256</AppxPackageSigningTimestampDigestAlgorithm>
		<AppxAutoIncrementPackageRevision>False</AppxAutoIncrementPackageRevision>
		<AppxSymbolPackageEnabled>True</AppxSymbolPackageEnabled>
		<GenerateTestArtifacts>True</GenerateTestArtifacts>
		<HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
		<AppxPackageDir>bin\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\AppPackages\</AppxPackageDir>

		<PwshSDKVersion>7.6.5</PwshSDKVersion>
		<MauiVersion>10.0.90</MauiVersion>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<ApplicationId>com.hexadecimal0x12e.projectframecut</ApplicationId>
		<AndroidPackageFormat>apk</AndroidPackageFormat>
		<RunAOTCompilation>False</RunAOTCompilation>
		<PublishTrimmed>False</PublishTrimmed>
		<JavaMaximumHeapSize>16G</JavaMaximumHeapSize>
		<AndroidEnableMultiDex>True</AndroidEnableMultiDex>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ApplicationId>hexadecimal0x12e.projectframecut</ApplicationId>
		<ValidateExecutableReferencesMatchSelfContained>false</ValidateExecutableReferencesMatchSelfContained>
		<SelfContained>true</SelfContained>
	</PropertyGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0_linux'">
		<ApplicationId>hexadecimal0x12e.projectframecut</ApplicationId>
		<SelfContained>true</SelfContained>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<ApplicationId>com.hexadecimal0x12e.projectframecut</ApplicationId>
		<CodesignKey>Apple Development: Created via API (UTKTS349ZC)</CodesignKey>
		<CodesignProvision>VS: WildCard Development</CodesignProvision>
		<MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
		<MtouchDebug>True</MtouchDebug>
		<IpaIncludeArtwork>False</IpaIncludeArtwork>
		<MtouchUseLlvm>False</MtouchUseLlvm>
		<MtouchLink>None</MtouchLink>
		<MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
		<MtouchDebug>True</MtouchDebug>
		<IpaIncludeArtwork>False</IpaIncludeArtwork>
		<ProvisioningType>manual</ProvisioningType>
		<DefineConstants>$(DefineConstants);iDevices;DISABLE_POWERSHELL_SDK;MAUISDK</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<ApplicationId>com.hexadecimal0x12e.projectframecut</ApplicationId>
		<CodesignKey>Apple Development: Created via API (UTKTS349ZC)</CodesignKey>
		<CodesignProvision>VS: WildCard Development</CodesignProvision>
		<MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
		<MtouchDebug>True</MtouchDebug>
		<IpaIncludeArtwork>False</IpaIncludeArtwork>
		<MtouchUseLlvm>False</MtouchUseLlvm>
		<MtouchLink>None</MtouchLink>
		<MtouchNoSymbolStrip>True</MtouchNoSymbolStrip>
		<MtouchDebug>True</MtouchDebug>
		<IpaIncludeArtwork>False</IpaIncludeArtwork>
		<ProvisioningType>manual</ProvisioningType>
		<DefineConstants>$(DefineConstants);iDevices;DISABLE_POWERSHELL_SDK;MAUISDK</DefineConstants>
		<MtouchInterpreter>all</MtouchInterpreter>
		<PublishReadyToRun>false</PublishReadyToRun>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#FFD272" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\AppIcon\appiconfg.svg" Color="#ffd272" BaseSize="2048,2048" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*.png" />
		<MauiImage Include="Resources\Images\*.jpg" />
		<MauiImage Include="Resources\Images\*.svg" Resize="True" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="Resources\Styles\**" LogicalName="Styles\%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.8.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.8.0" />
		<PackageReference Include="OpenAI" Version="2.12.0" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.9" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="$(MauiVersion)" />
		<PackageReference Include="CommunityToolkit.Maui" Version="14.2.0" />
		<PackageReference Include="CommunityToolkit.Maui.MediaElement" Version="10.0.0" />
		<PackageReference Include="TinyPinyin.Net" Version="1.0.0" />
		<PackageReference Include="Kawazu" Version="1.1.4" ExcludeAssets="contentFiles" />
	</ItemGroup>

	<PropertyGroup>
		<UserHome Condition=" '$(HOME)' != '' ">$(HOME)</UserHome>
		<UserHome Condition=" '$(UserHome)' == '' and '$(USERPROFILE)' != '' ">$(USERPROFILE)</UserHome>
		<UserHome Condition=" '$(UserHome)' == '' ">$(HOMEDRIVE)$(HOMEPATH)</UserHome>
	</PropertyGroup>

	<ItemGroup>
		<!-- hide huge generated locate.sg.cs to stop Roslyn (devhub.exe) analyse it, and eating extreme large amount of memory -->
		<Compile Update="**\Localize\locate.sg.cs" Visible="false" />
		<!-- removing the annoying refs from Solution resource manager and application package (we'll bundle them somewhere else) -->
		<None Remove="$(UserHome)\.nuget\packages\microsoft.powershell.sdk\*\contentFiles\**\*" Visible="false" />
		<None Remove="$(UserHome)\.nuget\packages\kawazu\*\contentFiles\**\*" />
		<None Remove="Platforms\Windows\pjfc-cli.exe" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\projectFrameCut.ApplicationAPIBase\projectFrameCut.ApplicationAPIBase.csproj" />
		<ProjectReference Include="..\projectFrameCut.AIComponentContracts\projectFrameCut.AIComponentContracts.csproj" />
		<ProjectReference Include="..\projectFrameCut.IntegratedAPIServer\projectFrameCut.IntegratedAPIServer.csproj" />
		<ProjectReference Include="..\projectFrameCut.Render.Contracts\projectFrameCut.Render.Contracts.csproj" />
		<ProjectReference Include="..\projectFrameCut.Render.HwAccelEngine\projectFrameCut.Render.HwAccelEngine.csproj" />
		<ProjectReference Include="..\projectFrameCut.Render\projectFrameCut.Render.csproj" />
		<ProjectReference Include="..\projectFrameCut.Shared\projectFrameCut.Shared.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<StartupObject>projectFrameCut.WinUI.Program</StartupObject>
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN;DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION;MAUISDK</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="$(PwshSDKVersion)" />
		<PackageReference Include="PowerShellStandard.Library" Version="5.1.1" />
		<PackageReference Include="Woohoo.Platform.Windows" Version="0.1.0" />
		<PackageReference Include="System.Management" Version="*" /> <!-- pwsh SDK relys on this library so we don't fix the version -->
		<PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
		<ProjectReference Include="..\projectFrameCut.Helper\projectFrameCut.Helper.csproj" />
		<MauiAsset Include="..\..\playground\FFmpeg\windows\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<MauiAsset Include="Platforms\Windows\pjfc-cli.exe" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup Condition="'$(BuildingInsideVisualStudio)' != 'true' and '$(TargetFramework)' == 'net10.0-windows10.0.19041.0'">
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools.MSIX" Version="1.7.260610101" />
	</ItemGroup>


	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="$(PwshSDKVersion)" ExcludeAssets="native" /> <!-- Microsoft.PowerShell.Native has a native lib which was not compactable with android, so we exclude it -->
		<PackageReference Include="PowerShellStandard.Library" Version="5.1.1" />
		<AndroidMavenLibrary Include="io.github.kyant0:fishnet" Version="1.1.0" />
		<AndroidNativeLibrary Include="..\..\playground\FFmpeg\android\**\*.so" />
		<AndroidNativeLibrary Include="Platforms\Android\nativeLibs\**\*.so" />
	</ItemGroup>

	<ItemGroup Condition="'$(Configuration)|$(TargetFramework)'=='Debug|net10.0-android'">
		<AndroidMavenLibrary Include="com.github.L-JINBIN:MTDataFilesProvider" Version="1.0.0" Repository="https://jitpack.io" />
	</ItemGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)'=='Debug|net10.0-android'">
		<AndroidKeyStore>False</AndroidKeyStore>
		<DefineConstants>$(DefineConstants);ANDROID;MAUISDK</DefineConstants>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)|$(TargetFramework)'=='Release|net10.0-android'">
		<AndroidKeyStore>True</AndroidKeyStore>
		<AndroidSigningKeyStore>0x12e.keystore</AndroidSigningKeyStore>
		<AndroidSigningKeyAlias>123456</AndroidSigningKeyAlias>
		<AndroidSigningKeyPass>123456</AndroidSigningKeyPass>
		<AndroidSigningStorePass>123456</AndroidSigningStorePass>
		<AndroidCreatePackagePerAbi>True</AndroidCreatePackagePerAbi>
		<DefineConstants>$(DefineConstants);ANDROID;MAUISDK</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">
		<Compile Remove="ScriptEngine\**\*.cs" />
	</ItemGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<Compile Remove="ScriptEngine\**\*.cs" />
	</ItemGroup>

	<PropertyGroup Condition="'$(TargetFramework)' == 'net10.0_linux'">
		<TargetFrameworkIdentifier>.NETCoreApp</TargetFrameworkIdentifier>
		<TargetFrameworkVersion>v10.0</TargetFrameworkVersion>
		<TargetFrameworkMoniker>.NETCoreApp,Version=v10.0</TargetFrameworkMoniker>
		<DefineConstants>$(DefineConstants);LINUX</DefineConstants>
	</PropertyGroup>

	<ItemGroup Condition="'$(TargetFramework)' == 'net10.0_linux'">
		<PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4" Version="0.1.0-preview.12.26368.2" />
		<PackageReference Include="Microsoft.Maui.Platforms.Linux.Gtk4.Essentials" Version="0.1.0-preview.12.26368.2" />
		<PackageReference Include="Microsoft.PowerShell.SDK" Version="$(PwshSDKVersion)" />
		<PackageReference Include="PowerShellStandard.Library" Version="5.1.1" />
	</ItemGroup>

	<Target Name="RestorePlatformCompileItems" BeforeTargets="CoreCompile">
		<ItemGroup Condition="'$(TargetFramework)' == 'net10.0_linux'">
			<Compile Include="Platforms\Linux\**\*.cs" />
		</ItemGroup>
	</Target>

	<ItemGroup>
