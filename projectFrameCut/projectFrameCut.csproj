	<ItemGroup>
		<Compile Update="InteractableEditor\InteractableEditor.xaml.cs">
			<DependentUpon>DraftStuff\InteractableEditor\InteractableEditor.xaml</DependentUpon>
		</Compile>
		<Compile Update="Setting\SettingPages\AboutSettingPage.xaml.cs">
