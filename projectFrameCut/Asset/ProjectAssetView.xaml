<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:projectFrameCut.Asset"
             xmlns:tv="clr-namespace:projectFrameCut.ApplicationAPIBase.Views.TabbedView;assembly=projectFrameCut.ApplicationAPIBase"
             xmlns:l="clr-namespace:LocalizedResources"
             x:Class="projectFrameCut.Asset.ProjectAssetView"
             x:DataType="local:ProjectAssetViewModel">
    <tv:TabbedView IsEnabled="{Binding IsIdle}">
        <tv:TabbedViewItem Header="{l:Localized Key=DraftPage_AssetPanel_LocalAssets}">
            <Grid RowDefinitions="Auto,Auto,*" Padding="10" RowSpacing="8">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Entry Placeholder="{l:Localized Key=AssetPage_Search}"
                           Text="{Binding SearchText}" ClearButtonVisibility="WhileEditing" />
                    <Button Grid.Column="1" Text="{l:Localized Key=AssetPage_AddAAsset}"
                            IsEnabled="{Binding CanEdit}" Clicked="OnAddAssetClicked" />
                </Grid>
                <FlexLayout Grid.Row="1" Wrap="Wrap" AlignItems="Center" JustifyContent="SpaceBetween">
                    <Label Text="{Binding Summary}" Margin="0,0,8,0" />
                    <HorizontalStackLayout Spacing="4" Margin="0,0,8,0">
                        <CheckBox IsChecked="{Binding MissingOnly}" />
                        <Label Text="{l:Localized Key=DraftSettingPage_AssetFiles_MissingOnly}" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <Picker SelectedIndex="{Binding OrderOption}" WidthRequest="130" Margin="0,0,8,0">
                        <Picker.Items>
                            <l:Localized Key="AssetPage_OrderBy_AddDate" />
                            <l:Localized Key="AssetPage_OrderBy_Name" />
                        </Picker.Items>
                    </Picker>
                    <Button Text="{l:Localized Key=DraftSettingPage_ExternalSources_Refresh}" Clicked="OnRefreshClicked" />
                </FlexLayout>
                <CollectionView Grid.Row="2" ItemsSource="{Binding FilteredLocalAssets}" SelectionMode="None">
                    <CollectionView.ItemsLayout>
                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                    </CollectionView.ItemsLayout>
                    <CollectionView.EmptyView>
                        <Label Text="{l:Localized Key=AssetPage_SearchNoResult}" Margin="16,32" HorizontalTextAlignment="Center" />
                    </CollectionView.EmptyView>
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="local:AssetItemViewModel">
                            <Border Padding="10" StrokeThickness="1" StrokeShape="RoundRectangle 6"
                                    Stroke="{AppThemeBinding Light=#DDDDDD, Dark=#444444}"
                                    BackgroundColor="{AppThemeBinding Light=#F5F5F5, Dark=#2A2A2A}">
                                <Grid ColumnDefinitions="76,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
                                    <Grid HeightRequest="64">
                                        <Label Text="{Binding Icon}" FontSize="28" HorizontalOptions="Center" VerticalOptions="Center" />
                                        <Image Source="{Binding ThumbnailPath}" IsVisible="{Binding HasThumbnail}" Aspect="AspectFit" />
                                    </Grid>
                                    <VerticalStackLayout Grid.Column="1" Spacing="4">
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <Label Text="{Binding Name}" FontAttributes="Bold" LineBreakMode="TailTruncation"
                                                   ToolTipProperties.Text="{Binding Name}" />
                                            <Label Grid.Column="1" Text="{Binding DurationDisplay}" FontSize="12" />
                                        </Grid>
                                        <Label Text="{Binding Path}" FontSize="12" LineBreakMode="MiddleTruncation"
                                               ToolTipProperties.Text="{Binding Path}" />
                                        <FlexLayout Wrap="Wrap" AlignItems="Center">
                                            <Label Text="{Binding FileStatus}" TextColor="{Binding StatusColor}" FontSize="12" Margin="0,0,12,0" />
                                            <Label Text="{Binding References}" FontSize="12" Margin="0,0,12,0" />
                                            <Label Text="{Binding ProxyStatus}" IsVisible="{Binding IsVideo}" FontSize="12" Margin="0,0,12,0"
                                                   ToolTipProperties.Text="{Binding ProxyPath}" />
                                        </FlexLayout>
                                    </VerticalStackLayout>
                                    <FlexLayout Grid.Row="1" Grid.ColumnSpan="2" Wrap="Wrap" AlignItems="Center">
                                        <Button Text="{l:Localized Key=AssetPage_AddToTrack}" Margin="0,0,6,4" Padding="10,5"
                                                IsEnabled="{Binding IsAddable}" Clicked="OnAddToTrackClicked" />
                                        <Button Text="{l:Localized Key=HomePage_ProjectContextMenu_Rename}" Margin="0,0,6,4" Padding="10,5"
                                                IsEnabled="{Binding CanEdit}" Clicked="OnRenameAssetClicked" />
                                        <Button Text="{l:Localized Key=DraftSettingPage_AssetFiles_Relink}" Margin="0,0,6,4" Padding="10,5"
                                                IsEnabled="{Binding CanRelink}" Clicked="OnRelinkAssetClicked" />
                                        <Button Text="{Binding CreateProxyText}" Margin="0,0,6,4" Padding="10,5"
                                                IsVisible="{Binding IsVideo}" IsEnabled="{Binding CanCreateProxy}" Clicked="OnCreateProxyClicked" />
                                        <Button Text="{l:Localized Key=AssetPage_RemoveProxy}" Margin="0,0,6,4" Padding="10,5"
                                                IsVisible="{Binding IsVideo}" IsEnabled="{Binding CanRemoveProxy}" Clicked="OnRemoveProxyClicked" />
                                        <Button Text="{l:Localized Key=_Remove}" Margin="0,0,0,4" Padding="10,5"
                                                IsEnabled="{Binding CanEdit}" TextColor="OrangeRed" Clicked="OnRemoveAssetClicked" />
                                    </FlexLayout>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </tv:TabbedViewItem>
    </tv:TabbedView>
</ContentView>
