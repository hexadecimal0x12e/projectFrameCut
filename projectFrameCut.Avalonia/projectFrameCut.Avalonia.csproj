<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net11.0</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">
			$(TargetFrameworks);net11.0-windows10.0.19041.0
		</TargetFrameworks>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(Configuration)' == 'Release'">maccatalyst-x64;maccatalyst-arm64</RuntimeIdentifiers>
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(Configuration)' != 'Release' and '$(Platform)' == 'x64'">maccatalyst-x64</RuntimeIdentifier>
		<RuntimeIdentifier Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst' and '$(Configuration)' != 'Release' and '$(Platform)' == 'Arm64'">maccatalyst-arm64</RuntimeIdentifier>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64;android-x64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows' and '$(Configuration)' == 'Release'">win-x64;win-arm64</RuntimeIdentifiers>
		<OutputType>Exe</OutputType>
		<RootNamespace>projectFrameCut</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>

		<DefineConstants>$(DefineConstants);Avalonia</DefineConstants>

		<!-- Display name -->
		<ApplicationTitle>projectFrameCut</ApplicationTitle>

		<!-- App Identifier -->
		<ApplicationId>com.hexadecimal0x12e.projectframecut.Avalonia</ApplicationId>

		<!-- Versions -->
		<ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
		<ApplicationVersion>7</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">13.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">13.1</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">30.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>

	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="..\projectFrameCut\Resources\AppIcon\appicon.svg" ForegroundFile="..\projectFrameCut\Resources\AppIcon\appiconfg.svg" Color="#FFD272" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="..\projectFrameCut\Resources\Splash\splash.svg" Color="#FFD272" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="..\projectFrameCut\Resources\Images\*" />
		<MauiImage Update="..\projectFrameCut\Resources\Images\dotnet_bot.png" Resize="True" BaseSize="300,185" />

		<!-- Custom Fonts -->
		<MauiFont Include="..\projectFrameCut\Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "..\projectFrameCut\Resources\Raw" prefix) -->
		<MauiAsset Include="..\projectFrameCut\Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>


	<ItemGroup>
		<PackageReference Include="Avalonia.Controls.Maui" Version="11.0.0-preview.2.26097.1443" />
		<PackageReference Include="Avalonia.Controls.Maui.Desktop" Condition="'$(TargetFramework)' == 'net11.0'" Version="11.0.0-preview.2.26097.1443" />
		<PackageReference Include="Avalonia.Controls.Maui.Essentials" Version="11.0.0-preview.2.26097.1443" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="10.0.30" />
		<PackageReference Include="Microsoft.Maui.Controls.Compatibility" Version="10.0.30" />
		<PackageReference Include="Microsoft.Maui.Controls.Xaml" Version="10.0.30" />
		<PackageReference Include="CommunityToolkit.Maui" Version="13.0.0" />

		<PackageReference Include="TinyPinyin.Net" Version="1.0.0" />
		<PackageReference Include="Microsoft.Extensions.AI" Version="10.3.0" />
		<PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.3.0" />
		<PackageReference Include="OpenAI" Version="2.8.0" />
		<PackageReference Include="Cnblogs.DashScope.Sdk" Version="0.9.0" />

		
		<Reference Include="..\projectFrameCut\Resources\Assembly\*.dll" />

	</ItemGroup>


	<ItemGroup>
		<MauiXaml Include="..\projectFrameCut\**\*.xaml" Exclude="..\projectFrameCut\bin\**;..\projectFrameCut\obj\**;..\projectFrameCut\Platforms\**;..\projectFrameCut\App*.xaml;..\projectFrameCut\AppShell*.xaml" Link="SharedPages\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\**\*.xaml.cs" Exclude="..\projectFrameCut\bin\**;..\projectFrameCut\obj\**;..\projectFrameCut\Platforms\**;..\projectFrameCut\App*.xaml.cs;..\projectFrameCut\AppShell*.xaml.cs" Link="SharedPages\%(RecursiveDir)%(Filename)%(Extension)">
			<DependentUpon>%(Filename).xaml</DependentUpon>
		</Compile>	

		<Compile Include="..\projectFrameCut\AIAssistance\**\*.cs" Exclude="..\projectFrameCut\AIAssistance\**\*.xaml.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\ApplicationPluginBase\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\Asset\**\*.cs" Exclude="..\projectFrameCut\Asset\**\*.xaml.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\APIClient\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\Controls\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\Localize\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\ViewModels\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\DraftStuff\**\*.cs" Exclude="..\projectFrameCut\DraftStuff\*.xaml.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\InteractableEditor\**\*.cs" Exclude="..\projectFrameCut\InteractableEditor\*.xaml.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\Converters\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\Services\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\Template\**\*.cs" Exclude="..\projectFrameCut\Template\**\*.xaml.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Include="..\projectFrameCut\Setting\Setting*\**\*.cs" Exclude="..\projectFrameCut\Setting\SettingPages\**\*.cs" Link="SharedCodes\%(RecursiveDir)%(Filename)%(Extension)" />

		<Compile Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'" Include="..\projectFrameCut\Platforms\iOS\**\*.cs" Exclude="..\projectFrameCut\Platforms\iOS\AppDelegate.cs;..\projectFrameCut\Platforms\iOS\Program.cs" Link="Platforms\iOS\%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'" Include="..\projectFrameCut\Platforms\MacCatalyst\**\*.cs" Exclude="..\projectFrameCut\Platforms\MacCatalyst\AppDelegate.cs;..\projectFrameCut\Platforms\MacCatalyst\Program.cs" Link="Platforms\MacCatalyst\%(RecursiveDir)%(Filename)%(Extension)" />

		<ProjectReference Include="..\projectFrameCut.ApplicationAPIBase\projectFrameCut.ApplicationAPIBase.csproj" />
		<ProjectReference Include="..\projectFrameCut.Render\projectFrameCut.Render.csproj" />
		<ProjectReference Include="..\projectFrameCut.Shared\projectFrameCut.Shared.csproj" />
	</ItemGroup>

	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN;DISABLE_XAML_GENERATED_BREAK_ON_UNHANDLED_EXCEPTION</DefineConstants>
		<ShouldImportMsixCommonTargets>false</ShouldImportMsixCommonTargets>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<ProjectReference Include="..\projectFrameCut.Render.WindowsRender\projectFrameCut.Render.WindowsRender.csproj" />
		<ProjectReference Include="..\projectFrameCut.Helper\projectFrameCut.Helper.csproj" />
		<PackageReference Include="System.Management" Version="10.0.0" />
		<MauiAsset Include="..\..\playground\FFmpeg\windows\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
		<Compile Update="AppShell_Windows.xaml.cs">
			<DependentUpon>AppShell_Windows.xaml</DependentUpon>
		</Compile>
		<Compile Update="App.xaml.cs">
			<DependentUpon>App.WinUI.xaml</DependentUpon>
		</Compile>
	</ItemGroup>

	
	<ItemGroup>
		<Using Include="projectFrameCut.Shared.Logger">
			<Static>True</Static>
		</Using>
		<Using Include="LocalizedResources.SimpleLocalizerBaseGeneratedHelper">
			<Static>True</Static>
		</Using>
		<Using Include="projectFrameCut.Setting.SettingManager">
			<Static>False</Static>
		</Using>
	</ItemGroup>


	<ItemGroup>
	  <Compile Update="AppShell.xaml.cs">
	    <SubType>Code</SubType>
	    <DependentUpon>%(Filename)</DependentUpon>
	  </Compile>
	</ItemGroup>
	<ItemGroup>
		<MauiXaml Update="..\projectFrameCut\Resources\Styles\Colors.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="..\projectFrameCut\Resources\Styles\Styles_Default.xaml">
			<Generator>MSBuild:Compile</Generator>
		</MauiXaml>
		<MauiXaml Update="Resources\Styles\Styles.xaml">
		  <Generator>MSBuild:Compile</Generator>
		</MauiXaml>
	</ItemGroup>
	<ItemGroup>
	  <None Update="AppShell.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </None>
	</ItemGroup>


</Project>
