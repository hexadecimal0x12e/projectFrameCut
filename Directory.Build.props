<Project>
  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
		<MauiVersion>11.0.0-rc.2.26505.5</MauiVersion>
		<ExtensionsVersion>11.0.0-rc.2.26504.105</ExtensionsVersion>
		<ExtensionsConfigurationVersion>11.0.0-rc.2.26504.105</ExtensionsConfigurationVersion>
		<MAUIGTK4Version>0.1.0-preview.12.26421.1</MAUIGTK4Version>
  </PropertyGroup>

	<ItemGroup>
		<Using Include="projectFrameCut.Drawing.Base.IPicture">
			<Alias>IPicture</Alias>
		</Using>
		<Using Include="projectFrameCut.Drawing.Base.PictureExtensions">
			<Alias>PictureExtensions</Alias>
		</Using>
		<Using Include="projectFrameCut.Shared.Logger">
			<Static>True</Static>
		</Using>
		<Using Include="System.Half" Alias="float16" />
	</ItemGroup>
</Project>
