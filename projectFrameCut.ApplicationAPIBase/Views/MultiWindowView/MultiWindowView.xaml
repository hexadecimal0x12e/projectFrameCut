<?xml version="1.0" encoding="utf-8" ?>
<Grid xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
      xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
      x:Class="projectFrameCut.ApplicationAPIBase.Views.MultiWindowView.MultiWindowView"
      BackgroundColor="#2D2D30">
    
    <!-- This Grid acts as the MDI Container.
         Children added here (MultiWindowItems) will float over this background. -->

        <Border x:Name="SnapPreviewOverlay"
          IsVisible="False"
          InputTransparent="True"
          Stroke="#80B6E0FF"
          StrokeThickness="1"
          BackgroundColor="#3F7FB5FF"
          StrokeShape="RoundRectangle 8"
          Margin="0" />
         
</Grid>
