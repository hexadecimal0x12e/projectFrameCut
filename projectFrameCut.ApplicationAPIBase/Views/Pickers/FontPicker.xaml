<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:local="clr-namespace:projectFrameCut.ApplicationAPIBase.Views.Pickers"
             x:Class="projectFrameCut.ApplicationAPIBase.Views.Pickers.FontPicker"
             x:Name="Root">
    <Grid RowDefinitions="Auto, Auto, Auto">
        <!-- Title -->
        <Label 
            Grid.Row="0"
            Text="{Binding Title, Source={x:Reference Root}}"
            FontAttributes="Bold"
            FontSize="18"
            Margin="10, 10, 10, 10"/>

        <!-- Search Bar + Category Filter -->
        <Grid Grid.Row="1" ColumnDefinitions="*, Auto" Margin="10, 0, 10, 10">
            <Border Grid.Column="0" StrokeShape="RoundRectangle 8" Margin="0, 0, 8, 0">
                <SearchBar x:Name="SearchEntry"/>
            </Border>
            <Border Grid.Column="1" StrokeShape="RoundRectangle 8" Padding="0" VerticalOptions="Fill">

                <Picker x:Name="CategoryPicker" WidthRequest="150"  Margin="0"/>
            </Border>
        </Grid>

        <!-- Font List -->
        <CollectionView Grid.Row="2" x:Name="FontCollectionView" Margin="10, 0, 10, 0"
                HeightRequest="400"
                VerticalScrollBarVisibility="Always"
                SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 8" Stroke="LightGray" Padding="10" Margin="0, 0, 0, 10" >
                        <Border.Triggers>
                            <DataTrigger TargetType="Border" Binding="{Binding IsSelected}" Value="True">
                                <Setter Property="Stroke" Value="#ffffff" />
                                <Setter Property="BackgroundColor" Value="#80808080" />
                            </DataTrigger>
                        </Border.Triggers>
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" ToolTipProperties.Text="{Binding FontName}">
                            <Label Text="{Binding DisplayName}" FontAttributes="Bold" FontSize="16" Grid.Row="0" Grid.Column="0" VerticalOptions="Center" LineBreakMode="TailTruncation"/>
                            <Border StrokeShape="RoundRectangle 12" StrokeThickness="0" BackgroundColor="#EFEFEF" Padding="10,2" Grid.Row="0" Grid.Column="1" VerticalOptions="Center">
                                <Label Text="{Binding Category}" FontSize="12" TextColor="Gray"/>
                            </Border>
                            <Grid Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Margin="0, 5, 0, 0" HeightRequest="30" HorizontalOptions="Fill">
                                <Image Source="{Binding PreviewImageSource}"
                                       HorizontalOptions="Start"
                                       Aspect="AspectFit"
                                       IsVisible="{Binding PreviewImageSource, Converter={toolkit:IsNotNullConverter}}"/>
                                <HorizontalStackLayout Spacing="6"
                                                       IsVisible="{Binding PreviewImageSource, Converter={toolkit:IsNullConverter}}"
                                                       VerticalOptions="Center">
                                    <ActivityIndicator IsRunning="True" Color="Gray" HeightRequest="16" WidthRequest="16"/>
                                </HorizontalStackLayout>
                            </Grid>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentView>
